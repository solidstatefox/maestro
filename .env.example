# Maximum cached FCT/SPARQL query results (default 1000; 0 disables cache)
MAESTRO_QUERY_CACHE_MAX_ENTRIES=1000

# Named graphs (datasites) used by Maestro in the personal SPARQL store.
# Separate graph IRIs with semicolons. Keep the final path names so Maestro can
# identify each graph's purpose: /dataservers, /query-favorites, /ontology-cache.
SPARQL_ENDPOINTS=gttp://ggg.maestro.ecosys/dataservers;gttp://ggg.maestro.ecosys/query-favorites;gttp://ggg.maestro.ecosys/ontology-cache

# Personal SPARQL endpoint used for Datasites lookup, query favorites, and ontology metadata.
# Use /sparql for the shared Virtuoso SPARQL service account, or /sparql-auth
# if you want RDF_LOADER_USERNAME/PASSWORD to authenticate as a specific account.
PERSONAL_SPARQL_ENDPOINT=http://localhost:8890/sparql

# Optional Basic Auth credentials. Use both when PERSONAL_SPARQL_ENDPOINT ends in /sparql-auth.
# The standard /sparql endpoint uses Virtuoso's shared SPARQL service account.
RDF_LOADER_USERNAME=
RDF_LOADER_PASSWORD=
