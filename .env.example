# Maximum cached FCT/SPARQL query results (default 1000; 0 disables cache)
MAESTRO_QUERY_CACHE_MAX_ENTRIES=1000

# Local Turtle file containing the RDF records used to rebuild the Datasites registry.
# Maestro reads this file and replaces SITE_SPARQL_ENDPOINTS before the first endpoint lookup.
SPARQL_ENDPOINTS=./ttl/dataservers-seed.ttl

# Datasite graph IRI where selectable SPARQL endpoints are stored.
SITE_SPARQL_ENDPOINTS=gttp://ggg.maestro.ecosys/dataservers

# Datasite graph IRI where query History is stored.
SITE_HISTORY=gttp://ggg.maestro.ecosys/query/history

# Datasite graph IRI where ontology RDF is cached.
SITE_ONTOLOGY=gttp://ggg.maestro.ecosys/ontology-cache

# Personal SPARQL endpoint used for Datasites lookup, query favorites, and ontology metadata.
# Use /sparql for the shared Virtuoso SPARQL service account, or /sparql-auth
# if you want RDF_LOADER_USERNAME/PASSWORD to authenticate as a specific account.
PERSONAL_SPARQL_ENDPOINT=http://localhost:8890/sparql

# Optional Basic Auth credentials. Use both when PERSONAL_SPARQL_ENDPOINT ends in /sparql-auth.
# The standard /sparql endpoint uses Virtuoso's shared SPARQL service account.
RDF_LOADER_USERNAME=
RDF_LOADER_PASSWORD=
