@prefix schema: <https://schema.org/> .

# Eleven class-specific policies for Maestro's existing Record resolver.

<gttp://ggg.maestro.ecosys/eu-data/policy#Project> a mui:ClassPolicy ;
  rdfs:label "EU Data · Research project Record policy"@en ;
  mui:forClass <http://data.europa.eu/s66#Project> ;
  mui:recordShape <gttp://ggg.maestro.ecosys/eu-data/shape#ProjectRecord> ;
  mui:widget mui:RecordViewerWidget .

