# Projection-safe Record selection shapes. Full DCAT-AP shapes are separate.

<gttp://ggg.maestro.ecosys/eu-data/shape#ProjectRecord> a sh:NodeShape ;
  rdfs:label "EU Data · Research project Record projection"@en ;
  rdfs:comment "This is a partial-Record compatibility shape, NOT a complete-source conformance check."@en ;
  sh:targetClass <http://data.europa.eu/s66#Project> ;
  sh:nodeKind sh:BlankNodeOrIRI .

