&lt;dd id="record-extra-value-{position()}" class="break-words text-sm"&gt;
&lt;xsl:for-each select="distinct-values(current-group()/fct:column[3] ! normalize-space(string(.)))[. != '']"&gt;
&lt;xsl:choose&gt;
&lt;xsl:when test="matches(., '^https?://')"&gt;&lt;a id="record-extra-uri-{position()}-{$groupIndex}" data-maestro-record-uri="{.}" href="#" class="text-primary hover:underline"&gt;&lt;xsl:value-of select="tokenize(., '[/#]')[last()]"/&gt;&lt;/a&gt;&lt;/xsl:when&gt;
&lt;xsl:otherwise&gt;&lt;span id="record-extra-text-{position()}-{$groupIndex}"&gt;&lt;xsl:value-of select="."/&gt;&lt;/span&gt;&lt;/xsl:otherwise&gt;
&lt;/xsl:choose&gt;&lt;xsl:if test="position() ne last()"&gt;&lt;span id="record-extra-separator-{position()}-{$groupIndex}"&gt; · &lt;/span&gt;&lt;/xsl:if&gt;
&lt;/xsl:for-each&gt;
&lt;/dd&gt;&lt;/div&gt;
&lt;/xsl:for-each-group&gt;
&lt;/dl&gt;&lt;/section&gt;&lt;/xsl:if&gt;&lt;footer id="record-footer" class="border-t px-5 py-3 text-xs text-muted-foreground"&gt;DBpedia record · Maestro formatter&lt;/footer&gt;&lt;/article&gt;&lt;svg:svg xmlns:svg="http://www.w3.org/2000/svg" id="dbpedia-organisation-record-heading-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" mui:parent="record_title_icon"&gt;&lt;svg:rect id="dbpedia-organisation-record-icon-1" x="4" y="2" width="16" height="20" rx="2"/&gt;&lt;svg:path id="dbpedia-organisation-record-icon-2" d="M9 22v-4h6v4M8 6h.01M16 6h.01M12 6h.01M12 10h.01M12 14h.01M16 10h.01M16 14h.01M8 10h.01M8 14h.01"/&gt;&lt;/svg:svg&gt;&lt;/section&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</rdf:value>
