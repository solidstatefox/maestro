  <rdf:Description rdf:about="gttp://ggg.maestro.ecosys/shacl/template#DbpediaFilmRecordTemplate">
    <rdfs:label xml:lang="en">Film cinematic card</rdfs:label>
    <rdf:value>&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:fct="http://openlinksw.com/services/facets/1.0/" xmlns:mctx="gttp://ggg.maestro.ecosys/ns/xslt/context#" xmlns:m="gttp://ggg.maestro.ecosys/ns/xslt/commerce#" version="3.0" exclude-result-prefixes="xs fct mctx m"&gt;
&lt;xsl:output method="html" encoding="UTF-8" omit-xml-declaration="yes"/&gt;
&lt;xsl:param name="recordUri" as="xs:string" select="''"/&gt;
&lt;xsl:variable name="rows" select="/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row"/&gt;
&lt;xsl:function name="m:values" as="xs:string*"&gt;&lt;xsl:param name="names" as="xs:string*"/&gt;
&lt;xsl:sequence select="distinct-values($rows[lower-case(tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()]) = $names]/fct:column[3] ! normalize-space(string(.)))[. ne '']"/&gt;
&lt;/xsl:function&gt;
&lt;xsl:function name="m:first" as="xs:string"&gt;&lt;xsl:param name="names" as="xs:string*"/&gt;&lt;xsl:sequence select="string((m:values($names))[1])"/&gt;&lt;/xsl:function&gt;
&lt;xsl:function name="m:pretty" as="xs:string"&gt;&lt;xsl:param name="uri" as="xs:string"/&gt;&lt;xsl:sequence select="replace(tokenize($uri, '[/#]')[last()], '_', ' ')"/&gt;&lt;/xsl:function&gt;
&lt;xsl:function name="m:is-uri" as="xs:boolean"&gt;&lt;xsl:param name="value" as="xs:string"/&gt;&lt;xsl:sequence select="matches($value, '^https?://')"/&gt;&lt;/xsl:function&gt;
&lt;xsl:template name="m:field"&gt;&lt;xsl:param name="key" as="xs:string"/&gt;&lt;xsl:param name="names" as="xs:string*"/&gt;&lt;xsl:param name="n" as="xs:string"/&gt;
&lt;xsl:variable name="values" select="m:values($names)"/&gt;
&lt;xsl:if test="exists($values)"&gt;&lt;div id="field-{$n}" class="flex flex-col gap-1 border-b border-border/60 py-3 sm:grid sm:grid-cols-[7.5rem_1fr] sm:gap-4"&gt;&lt;dt id="field-label-{$n}" class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground"&gt;&lt;xsl:value-of select="$key"/&gt;&lt;/dt&gt;&lt;dd id="field-data-{$n}" class="min-w-0 text-sm leading-relaxed text-foreground"&gt;&lt;xsl:for-each select="$values"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="m:is-uri(.)"&gt;&lt;a id="field-link-{$n}-{position()}" class="text-primary underline-offset-4 hover:underline" data-maestro-record-uri="{.}" href="#"&gt;&lt;xsl:value-of select="m:pretty(.)"/&gt;&lt;/a&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;span id="field-text-{$n}-{position()}"&gt;&lt;xsl:value-of select="."/&gt;&lt;/span&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="position() ne last()"&gt;&lt;span id="field-separator-{$n}-{position()}" class="text-muted-foreground"&gt; · &lt;/span&gt;&lt;/xsl:if&gt;&lt;/xsl:for-each&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;
&lt;/xsl:template&gt;
&lt;xsl:template name="m:extras"&gt;&lt;xsl:param name="excluded" as="xs:string*"/&gt;
&lt;xsl:variable name="other" select="$rows[fct:column[2] and fct:column[3] and not(lower-case(tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()]) = $excluded)]"/&gt;
&lt;xsl:if test="exists($other)"&gt;&lt;section id="record-additional-section" class="border-t border-border/70 px-6 py-5"&gt;&lt;h3 id="record-additional-title" class="mb-3 text-xs font-semibold uppercase tracking-[.18em] text-muted-foreground"&gt;Additional details&lt;/h3&gt;&lt;dl id="record-additional-list" class="divide-y divide-border/50"&gt;&lt;xsl:for-each-group select="$other" group-by="normalize-space(string(fct:column[2]))"&gt;&lt;xsl:variable name="idx" select="position()"/&gt;&lt;xsl:variable name="prop" select="current-grouping-key()"/&gt;&lt;div id="record-extra-{$idx}" class="grid gap-1 py-2 text-sm sm:grid-cols-[8rem_1fr]"&gt;&lt;dt id="record-extra-label-{$idx}" class="text-xs font-medium text-muted-foreground" title="{$prop}"&gt;&lt;xsl:value-of select="m:pretty($prop)"/&gt;&lt;/dt&gt;&lt;dd id="record-extra-values-{$idx}" class="min-w-0 break-words"&gt;&lt;xsl:for-each select="distinct-values(current-group()/fct:column[3] ! normalize-space(string(.)))[. ne '']"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="m:is-uri(.)"&gt;&lt;a id="record-extra-link-{$idx}-{position()}" data-maestro-record-uri="{.}" href="#" class="text-primary hover:underline"&gt;&lt;xsl:value-of select="m:pretty(.)"/&gt;&lt;/a&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;span id="record-extra-value-{$idx}-{position()}"&gt;&lt;xsl:value-of select="."/&gt;&lt;/span&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="position() ne last()"&gt;&lt;span id="record-extra-sep-{$idx}-{position()}"&gt; · &lt;/span&gt;&lt;/xsl:if&gt;&lt;/xsl:for-each&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:for-each-group&gt;&lt;/dl&gt;&lt;/section&gt;&lt;/xsl:if&gt;
&lt;/xsl:template&gt;
&lt;xsl:template match="/"&gt;
&lt;xsl:variable name="title" select="(m:values(('label','title','name'))[not(m:is-uri(.))], m:pretty($recordUri))[1]"/&gt;
&lt;xsl:variable name="summary" select="m:first(('abstract','description','plot','synopsis'))"/&gt;
&lt;xsl:variable name="poster" select="(m:values(('thumbnail','depiction','poster','image','cover'))[m:is-uri(.)])[1]"/&gt;
&lt;xsl:variable name="dateRow" select="($rows[lower-case(tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()]) = ('releasedate','publicationdate','datepublished','year')])[1]"/&gt;
&lt;xsl:variable name="date" select="normalize-space(string($dateRow/fct:column[3]))"/&gt;
&lt;xsl:variable name="dateProperty" select="normalize-space(string($dateRow/fct:column[2]))"/&gt;
&lt;xsl:variable name="imdbRaw" select="m:values(('imdbid','imdb'))"/&gt;
&lt;xsl:variable name="imdb" select="(for $v in $imdbRaw return if (matches($v, 'tt[0-9]+')) then replace($v, '^.*?(tt[0-9]+).*$', '$1') else '')[. ne ''][1]"/&gt;
&lt;xsl:variable name="lookup" select="concat($title, ' film ', substring($date,1,4))"/&gt;
&lt;section xmlns:mui="gttp://ggg.maestro.ecosys/ns/ui#" mui:framework="next@^16.4.0" id="maestro-record-viewer" class="mx-auto w-full max-w-5xl p-1"&gt;
&lt;article id="record-card" class="overflow-hidden rounded-2xl border border-slate-700 bg-[#0b101b] text-white shadow-2xl"&gt;
&lt;div id="film-hero" class="relative overflow-hidden bg-gradient-to-br from-[#273b55] via-[#101725] to-[#080b12] px-6 py-8 sm:px-9 sm:py-11"&gt;
&lt;div id="film-hero-grid" class="relative grid gap-7 sm:grid-cols-[minmax(0,1fr)_minmax(0,12rem)] sm:items-center"&gt;
&lt;div id="film-copy" class="min-w-0"&gt;&lt;p id="film-eyebrow" class="mb-3 text-[10px] font-semibold uppercase tracking-[.35em] text-sky-200"&gt;MAESTRO PREMIERE · DBPEDIA FILM&lt;/p&gt;
&lt;h2 id="film-title" class="max-w-2xl break-words text-3xl font-bold tracking-tight sm:text-5xl"&gt;&lt;xsl:value-of select="$title"/&gt;&lt;/h2&gt;
&lt;div id="film-highlights" class="mt-4 flex flex-wrap items-center gap-2 text-xs font-medium text-slate-300"&gt;
&lt;xsl:if test="$date and $dateProperty"&gt;&lt;button type="button" id="film-year" class="cursor-pointer rounded-full border border-white/20 bg-white/10 px-3 py-1 hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-sky-300" data-maestro-filter-property="{$dateProperty}" data-maestro-filter-value="{substring($date,1,4)}" data-maestro-filter-op="contains" title="Find films whose release date contains this year"&gt;&lt;xsl:value-of select="substring($date,1,4)"/&gt;&lt;/button&gt;&lt;/xsl:if&gt;
&lt;xsl:for-each select="m:values(('genre'))[position() le 2]"&gt;&lt;span id="film-genre-chip-{position()}" class="rounded-full border border-white/20 bg-white/10 px-3 py-1"&gt;&lt;xsl:value-of select="if (m:is-uri(.)) then m:pretty(.) else ."/&gt;&lt;/span&gt;&lt;/xsl:for-each&gt;
&lt;xsl:variable name="runtimeRow" select="($rows[lower-case(tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()]) = ('filmruntime','runtime','duration')])[1]"/&gt;
&lt;xsl:variable name="runtime" select="normalize-space(string($runtimeRow/fct:column[3]))"/&gt;
&lt;xsl:variable name="runtimeProperty" select="normalize-space(string($runtimeRow/fct:column[2]))"/&gt;
&lt;xsl:variable name="runtimeLabel" select="if ($runtimeProperty = ('http://dbpedia.org/ontology/runtime','http://dbpedia.org/ontology/filmRuntime') and $runtime castable as xs:double) then concat(format-number(xs:double($runtime) div 60, '0.#'), ' min') else if ($runtimeProperty = 'http://dbpedia.org/ontology/Work/runtime' and $runtime castable as xs:double) then concat($runtime, ' min') else if (matches($runtime, '^PT[0-9]+M$')) then concat(replace($runtime, '^PT([0-9]+)M$', '$1'), ' min') else $runtime"/&gt;
&lt;xsl:if test="$runtime"&gt;&lt;span id="film-runtime" class="rounded-full border border-white/20 bg-white/10 px-3 py-1"&gt;&lt;xsl:value-of select="$runtimeLabel"/&gt;&lt;/span&gt;&lt;/xsl:if&gt;
&lt;/div&gt;
&lt;xsl:if test="$summary"&gt;&lt;p id="film-synopsis" class="mt-6 max-w-2xl text-sm leading-7 text-slate-200 sm:text-base"&gt;&lt;xsl:value-of select="$summary"/&gt;&lt;/p&gt;&lt;/xsl:if&gt;
&lt;div id="film-action-row" class="mt-7 flex flex-wrap gap-3"&gt;
&lt;a id="film-google-search" href="{concat('https://www.google.com/search?q=', encode-for-uri($lookup))}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full bg-white px-5 py-3 text-xs font-semibold text-slate-950 shadow-md transition hover:bg-sky-100"&gt;Search Google ↗&lt;/a&gt;
&lt;a id="film-imdb" href="{if ($imdb) then concat('https://www.imdb.com/title/', $imdb, '/') else concat('https://www.imdb.com/find/?q=', encode-for-uri($lookup), '&amp;amp;s=tt')}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-5 py-3 text-xs font-semibold text-white hover:bg-white/20"&gt;IMDb &lt;xsl:choose&gt;&lt;xsl:when test="$imdb"&gt;↗&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;search ↗&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/a&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;div id="film-poster-frame" class="mx-auto flex aspect-[2/3] w-full max-w-48 items-center justify-center overflow-hidden rounded-xl border border-white/20 bg-slate-800 shadow-[0_14px_35px_rgba(0,0,0,.6)]"&gt;
&lt;xsl:choose&gt;&lt;xsl:when test="$poster"&gt;&lt;img id="film-poster" src="{$poster}" alt="Film artwork" class="h-full w-full object-cover" loading="lazy" referrerpolicy="no-referrer"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;span id="film-poster-placeholder" class="px-4 text-center text-xl font-semibold tracking-wide text-slate-400"&gt;MAESTRO CINEMA&lt;/span&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;
&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;
&lt;section id="film-availability" class="border-t border-white/10 bg-[#0f1623] px-6 py-7 sm:px-9"&gt;&lt;div id="film-availability-head" class="mb-5 flex flex-wrap items-end justify-between gap-3"&gt;&lt;h3 id="film-availability-title" class="text-lg font-bold tracking-tight"&gt;Find where to watch&lt;/h3&gt;&lt;p id="film-availability-note" class="text-xs text-slate-400"&gt;Search links only · availability not verified&lt;/p&gt;&lt;/div&gt;
&lt;div id="film-service-grid" class="grid grid-cols-2 gap-3 sm:grid-cols-3"&gt;
&lt;a id="film-service-netflix" href="{concat('https://www.netflix.com/search?q=', encode-for-uri($title))}" target="_blank" rel="noopener noreferrer" class="flex min-h-16 items-center gap-3 rounded-xl border border-white/15 bg-white/5 px-3 py-3 text-left transition hover:border-sky-300/60 hover:bg-white/15"&gt;&lt;span id="film-service-netflix-logo-frame" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white p-1.5"&gt;&lt;img id="film-service-netflix-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/netflix.svg" alt="Netflix logo" class="h-full w-full object-contain" loading="lazy"/&gt;&lt;/span&gt;&lt;span id="film-service-netflix-label" class="min-w-0 text-xs font-semibold text-slate-100"&gt;Netflix&lt;/span&gt;&lt;/a&gt;
&lt;a id="film-service-primevideo" href="{concat('https://www.amazon.com/s?i=instant-video&amp;amp;k=', encode-for-uri($title))}" target="_blank" rel="noopener noreferrer" class="flex min-h-16 items-center gap-3 rounded-xl border border-white/15 bg-white/5 px-3 py-3 text-left transition hover:border-sky-300/60 hover:bg-white/15"&gt;&lt;span id="film-service-primevideo-logo-frame" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white p-1.5"&gt;&lt;img id="film-service-primevideo-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/primevideo.svg" alt="Prime Video logo" class="h-full w-full object-contain" loading="lazy"/&gt;&lt;/span&gt;&lt;span id="film-service-primevideo-label" class="min-w-0 text-xs font-semibold text-slate-100"&gt;Prime Video&lt;/span&gt;&lt;/a&gt;
&lt;a id="film-service-disneyplus" href="{concat('https://www.disneyplus.com/search/', encode-for-uri($title))}" target="_blank" rel="noopener noreferrer" class="flex min-h-16 items-center gap-3 rounded-xl border border-white/15 bg-white/5 px-3 py-3 text-left transition hover:border-sky-300/60 hover:bg-white/15"&gt;&lt;span id="film-service-disneyplus-logo-frame" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white p-1.5"&gt;&lt;img id="film-service-disneyplus-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/disneyplus.svg" alt="Disney+ logo" class="h-full w-full object-contain" loading="lazy"/&gt;&lt;/span&gt;&lt;span id="film-service-disneyplus-label" class="min-w-0 text-xs font-semibold text-slate-100"&gt;Disney+&lt;/span&gt;&lt;/a&gt;
&lt;a id="film-service-appletv" href="{concat('https://tv.apple.com/search?term=', encode-for-uri($title))}" target="_blank" rel="noopener noreferrer" class="flex min-h-16 items-center gap-3 rounded-xl border border-white/15 bg-white/5 px-3 py-3 text-left transition hover:border-sky-300/60 hover:bg-white/15"&gt;&lt;span id="film-service-appletv-logo-frame" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white p-1.5"&gt;&lt;img id="film-service-appletv-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/appletv.svg" alt="Apple TV logo" class="h-full w-full object-contain" loading="lazy"/&gt;&lt;/span&gt;&lt;span id="film-service-appletv-label" class="min-w-0 text-xs font-semibold text-slate-100"&gt;Apple TV&lt;/span&gt;&lt;/a&gt;
&lt;a id="film-service-hulu" href="{concat('https://www.hulu.com/search?q=', encode-for-uri($title))}" target="_blank" rel="noopener noreferrer" class="flex min-h-16 items-center gap-3 rounded-xl border border-white/15 bg-white/5 px-3 py-3 text-left transition hover:border-sky-300/60 hover:bg-white/15"&gt;&lt;span id="film-service-hulu-logo-frame" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white p-1.5"&gt;&lt;img id="film-service-hulu-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/hulu.svg" alt="Hulu logo" class="h-full w-full object-contain" loading="lazy"/&gt;&lt;/span&gt;&lt;span id="film-service-hulu-label" class="min-w-0 text-xs font-semibold text-slate-100"&gt;Hulu&lt;/span&gt;&lt;/a&gt;
&lt;a id="film-service-youtube" href="{concat('https://www.youtube.com/results?search_query=', encode-for-uri($title))}" target="_blank" rel="noopener noreferrer" class="flex min-h-16 items-center gap-3 rounded-xl border border-white/15 bg-white/5 px-3 py-3 text-left transition hover:border-sky-300/60 hover:bg-white/15"&gt;&lt;span id="film-service-youtube-logo-frame" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white p-1.5"&gt;&lt;img id="film-service-youtube-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/youtube.svg" alt="YouTube logo" class="h-full w-full object-contain" loading="lazy"/&gt;&lt;/span&gt;&lt;span id="film-service-youtube-label" class="min-w-0 text-xs font-semibold text-slate-100"&gt;YouTube&lt;/span&gt;&lt;/a&gt;
&lt;/div&gt;&lt;/section&gt;
&lt;section id="film-details" class="border-t border-white/10 bg-[#111827] px-6 py-6 sm:px-9"&gt;&lt;h3 id="film-details-heading" class="mb-2 text-xs font-semibold uppercase tracking-[.2em] text-sky-200"&gt;Behind the scenes&lt;/h3&gt;&lt;dl id="film-details-list" class="grid gap-x-6 sm:grid-cols-2"&gt;
&lt;xsl:call-template name="m:field"&gt;&lt;xsl:with-param name="key" select="'Director'"/&gt;&lt;xsl:with-param name="names" select="('director')"/&gt;&lt;xsl:with-param name="n" select="'director'"/&gt;&lt;/xsl:call-template&gt;
&lt;xsl:call-template name="m:field"&gt;&lt;xsl:with-param name="key" select="'Cast'"/&gt;&lt;xsl:with-param name="names" select="('starring','actor')"/&gt;&lt;xsl:with-param name="n" select="'cast'"/&gt;&lt;/xsl:call-template&gt;
&lt;xsl:call-template name="m:field"&gt;&lt;xsl:with-param name="key" select="'Country'"/&gt;&lt;xsl:with-param name="names" select="('country')"/&gt;&lt;xsl:with-param name="n" select="'country'"/&gt;&lt;/xsl:call-template&gt;
&lt;xsl:call-template name="m:field"&gt;&lt;xsl:with-param name="key" select="'Language'"/&gt;&lt;xsl:with-param name="names" select="('language')"/&gt;&lt;xsl:with-param name="n" select="'language'"/&gt;&lt;/xsl:call-template&gt;
&lt;xsl:call-template name="m:field"&gt;&lt;xsl:with-param name="key" select="'Production'"/&gt;&lt;xsl:with-param name="names" select="('producer','productioncompany','distributor')"/&gt;&lt;xsl:with-param name="n" select="'production'"/&gt;&lt;/xsl:call-template&gt;
&lt;/dl&gt;&lt;/section&gt;
&lt;xsl:call-template name="m:extras"&gt;&lt;xsl:with-param name="excluded" select="('type','label','title','name','abstract','description','plot','synopsis','thumbnail','depiction','poster','image','cover','releasedate','publicationdate','datepublished','year','genre','runtime','duration','imdbid','imdb','director','starring','actor','country','language','producer','productioncompany','distributor')"/&gt;&lt;/xsl:call-template&gt;
&lt;footer id="film-footer" class="border-t border-white/10 px-6 py-4 text-center text-[10px] uppercase tracking-[.25em] text-slate-400"&gt;Film metadata · DBpedia · Maestro&lt;/footer&gt;
&lt;/article&gt;&lt;svg:svg xmlns:svg="http://www.w3.org/2000/svg" id="dbpedia-film-record-heading-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" mui:parent="record_title_icon"&gt;&lt;svg:rect id="dbpedia-film-record-icon-1" x="2" y="2" width="20" height="20" rx="2.18"/&gt;&lt;svg:path id="dbpedia-film-record-icon-2" d="M7 2v20M17 2v20M2 12h20M2 7h5M2 17h5M17 7h5M17 17h5"/&gt;&lt;/svg:svg&gt;&lt;/section&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4280096a4b904cf9ab8a611727d4fad1">
