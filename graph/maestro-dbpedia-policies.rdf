  <rdf:Description rdf:about="gttp://ggg.maestro.ecosys/shacl/template#DbpediaOrganisationRecordTemplate">
    <rdfs:label xml:lang="en">Organisation profile card</rdfs:label>
    <rdf:value>&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:fct="http://openlinksw.com/services/facets/1.0/" xmlns:mctx="gttp://ggg.maestro.ecosys/ns/xslt/context#" xmlns:m="gttp://ggg.maestro.ecosys/ns/xslt/dbpedia#" version="3.0" exclude-result-prefixes="xs fct mctx m"&gt;
&lt;xsl:output method="html" encoding="UTF-8" omit-xml-declaration="yes"/&gt;&lt;xsl:param name="recordUri"/&gt;
&lt;xsl:function name="m:values" as="xs:string"&gt;
&lt;xsl:param name="ctx" as="node()"/&gt;&lt;xsl:param name="predicate" as="xs:string"/&gt;
&lt;xsl:variable name="localName" select="tokenize($predicate, '[/#]')[last()]"/&gt;
&lt;xsl:variable name="rows" select="$ctx/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[2] = $predicate or tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()] = $localName]"/&gt;
&lt;xsl:sequence select="string-join(distinct-values($rows/fct:column[3] ! normalize-space(string(.)))[. != ''], ', ')"/&gt;
&lt;/xsl:function&gt;
&lt;xsl:template match="/"&gt;&lt;section xmlns:mui="gttp://ggg.maestro.ecosys/ns/ui#" mui:framework="next@^16.4.0" id="maestro-record-viewer" class="mx-auto w-full max-w-2xl p-1"&gt;&lt;article id="record-card" class="rounded-xl border bg-card text-card-foreground shadow-sm"&gt;&lt;header id="record-header" class="border-b bg-muted/40 px-5 py-4"&gt;&lt;p id="record-category" class="text-xs font-semibold uppercase tracking-wide text-muted-foreground"&gt;DBpedia · Organisation&lt;/p&gt;&lt;h2 id="record-title" class="mt-1 break-words text-xl font-semibold"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="m:values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label') != ''"&gt;&lt;xsl:value-of select="m:values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label')"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:value-of select="$recordUri"/&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/h2&gt;&lt;/header&gt;&lt;dl id="record-fields" class="px-5 py-2"&gt;      &lt;xsl:variable name="v0" select="m:values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label')"/&gt;
      &lt;xsl:if test="$v0 != ''"&gt;&lt;div id="record-row-0" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-0" class="text-xs font-medium text-muted-foreground"&gt;Name&lt;/dt&gt;&lt;dd id="record-value-0" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v0"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;      &lt;xsl:variable name="v1" select="m:values(root(.), 'http://dbpedia.org/ontology/foundingDate')"/&gt;
      &lt;xsl:if test="$v1 != ''"&gt;&lt;div id="record-row-1" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-1" class="text-xs font-medium text-muted-foreground"&gt;Founded&lt;/dt&gt;&lt;dd id="record-value-1" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v1"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;      &lt;xsl:variable name="v2" select="m:values(root(.), 'http://dbpedia.org/ontology/headquarter')"/&gt;
      &lt;xsl:if test="$v2 != ''"&gt;&lt;div id="record-row-2" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-2" class="text-xs font-medium text-muted-foreground"&gt;Headquarters&lt;/dt&gt;&lt;dd id="record-value-2" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v2"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;      &lt;xsl:variable name="v3" select="m:values(root(.), 'http://dbpedia.org/ontology/location')"/&gt;
      &lt;xsl:if test="$v3 != ''"&gt;&lt;div id="record-row-3" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-3" class="text-xs font-medium text-muted-foreground"&gt;Location&lt;/dt&gt;&lt;dd id="record-value-3" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v3"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;      &lt;xsl:variable name="v4" select="m:values(root(.), 'http://dbpedia.org/ontology/industry')"/&gt;
      &lt;xsl:if test="$v4 != ''"&gt;&lt;div id="record-row-4" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-4" class="text-xs font-medium text-muted-foreground"&gt;Industry&lt;/dt&gt;&lt;dd id="record-value-4" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v4"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;&lt;/dl&gt;&lt;xsl:variable name="allPropertyRows" select="root(.)/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[2] and fct:column[3] and not(fct:column[2] = ('http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://www.w3.org/2000/01/rdf-schema#label', 'http://purl.org/dc/terms/subject', 'http://dbpedia.org/ontology/abstract', 'http://xmlns.com/foaf/0.1/depiction', 'http://dbpedia.org/ontology/thumbnail'))]"/&gt;
&lt;xsl:if test="exists($allPropertyRows)"&gt;
&lt;section id="record-additional-section" class="border-t px-5 py-4"&gt;
&lt;h3 id="record-additional-title" class="mb-2 text-sm font-semibold"&gt;Additional details&lt;/h3&gt;
&lt;dl id="record-additional-list" class="divide-y"&gt;
&lt;xsl:for-each-group select="$allPropertyRows" group-by="normalize-space(string(fct:column[2]))"&gt;
&lt;xsl:variable name="predicate" select="current-grouping-key()"/&gt;&lt;xsl:variable name="groupIndex" select="position()"/&gt;
&lt;div id="record-extra-{position()}" class="grid gap-1 py-2 sm:grid-cols-[9rem_1fr]"&gt;
