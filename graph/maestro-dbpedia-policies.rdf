  <rdf:Description rdf:about="gttp://ggg.maestro.ecosys/shacl/template#DbpediaPlaceRecordTemplate">
    <rdfs:label xml:lang="en">Place profile card</rdfs:label>
    <rdf:value>&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:fct="http://openlinksw.com/services/facets/1.0/" xmlns:mctx="gttp://ggg.maestro.ecosys/ns/xslt/context#" xmlns:m="gttp://ggg.maestro.ecosys/ns/xslt/dbpedia#" version="3.0" exclude-result-prefixes="xs fct mctx m"&gt;
&lt;xsl:output method="html" encoding="UTF-8" omit-xml-declaration="yes"/&gt;&lt;xsl:param name="recordUri"/&gt;
&lt;xsl:function name="m:values" as="xs:string"&gt;
&lt;xsl:param name="ctx" as="node()"/&gt;&lt;xsl:param name="predicate" as="xs:string"/&gt;
&lt;xsl:variable name="localName" select="tokenize($predicate, '[/#]')[last()]"/&gt;
&lt;xsl:variable name="rows" select="$ctx/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[2] = $predicate or tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()] = $localName]"/&gt;
&lt;xsl:sequence select="string-join(distinct-values($rows/fct:column[3] ! normalize-space(string(.)))[. != ''], ', ')"/&gt;
&lt;/xsl:function&gt;
&lt;xsl:template match="/"&gt;&lt;section xmlns:mui="gttp://ggg.maestro.ecosys/ns/ui#" mui:framework="next@^16.4.0" id="maestro-record-viewer" class="mx-auto w-full max-w-2xl p-1"&gt;&lt;article id="record-card" class="rounded-xl border bg-card text-card-foreground shadow-sm"&gt;&lt;header id="record-header" class="border-b bg-muted/40 px-5 py-4"&gt;&lt;p id="record-category" class="text-xs font-semibold uppercase tracking-wide text-muted-foreground"&gt;DBpedia · Place&lt;/p&gt;&lt;h2 id="record-title" class="mt-1 break-words text-xl font-semibold"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="m:values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label') != ''"&gt;&lt;xsl:value-of select="m:values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label')"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:value-of select="$recordUri"/&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/h2&gt;&lt;/header&gt;&lt;dl id="record-fields" class="px-5 py-2"&gt;      &lt;xsl:variable name="v0" select="m:values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label')"/&gt;
      &lt;xsl:if test="$v0 != ''"&gt;&lt;div id="record-row-0" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-0" class="text-xs font-medium text-muted-foreground"&gt;Name&lt;/dt&gt;&lt;dd id="record-value-0" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v0"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;      &lt;xsl:variable name="v1" select="m:values(root(.), 'http://dbpedia.org/ontology/country')"/&gt;
      &lt;xsl:if test="$v1 != ''"&gt;&lt;div id="record-row-1" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-1" class="text-xs font-medium text-muted-foreground"&gt;Country&lt;/dt&gt;&lt;dd id="record-value-1" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v1"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;      &lt;xsl:variable name="v2" select="m:values(root(.), 'http://dbpedia.org/ontology/region')"/&gt;
      &lt;xsl:if test="$v2 != ''"&gt;&lt;div id="record-row-2" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-2" class="text-xs font-medium text-muted-foreground"&gt;Region&lt;/dt&gt;&lt;dd id="record-value-2" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v2"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;      &lt;xsl:variable name="v3" select="m:values(root(.), 'http://dbpedia.org/ontology/areaTotal')"/&gt;
      &lt;xsl:if test="$v3 != ''"&gt;&lt;div id="record-row-3" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-3" class="text-xs font-medium text-muted-foreground"&gt;Area&lt;/dt&gt;&lt;dd id="record-value-3" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v3"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;      &lt;xsl:variable name="v4" select="m:values(root(.), 'http://www.w3.org/2003/01/geo/wgs84_pos#lat')"/&gt;
      &lt;xsl:if test="$v4 != ''"&gt;&lt;div id="record-row-4" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-4" class="text-xs font-medium text-muted-foreground"&gt;Latitude&lt;/dt&gt;&lt;dd id="record-value-4" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v4"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;      &lt;xsl:variable name="v5" select="m:values(root(.), 'http://www.w3.org/2003/01/geo/wgs84_pos#long')"/&gt;
      &lt;xsl:if test="$v5 != ''"&gt;&lt;div id="record-row-5" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-5" class="text-xs font-medium text-muted-foreground"&gt;Longitude&lt;/dt&gt;&lt;dd id="record-value-5" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v5"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;&lt;/dl&gt;&lt;xsl:variable name="allPropertyRows" select="root(.)/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[2] and fct:column[3] and not(fct:column[2] = ('http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://www.w3.org/2000/01/rdf-schema#label', 'http://purl.org/dc/terms/subject', 'http://dbpedia.org/ontology/abstract', 'http://xmlns.com/foaf/0.1/depiction', 'http://dbpedia.org/ontology/thumbnail'))]"/&gt;
&lt;xsl:if test="exists($allPropertyRows)"&gt;
&lt;section id="record-additional-section" class="border-t px-5 py-4"&gt;
&lt;h3 id="record-additional-title" class="mb-2 text-sm font-semibold"&gt;Additional details&lt;/h3&gt;
&lt;dl id="record-additional-list" class="divide-y"&gt;
&lt;xsl:for-each-group select="$allPropertyRows" group-by="normalize-space(string(fct:column[2]))"&gt;
&lt;xsl:variable name="predicate" select="current-grouping-key()"/&gt;&lt;xsl:variable name="groupIndex" select="position()"/&gt;
&lt;div id="record-extra-{position()}" class="grid gap-1 py-2 sm:grid-cols-[9rem_1fr]"&gt;
&lt;dt id="record-extra-key-{position()}" class="break-all text-xs font-medium text-muted-foreground" title="{$predicate}"&gt;&lt;xsl:value-of select="tokenize($predicate, '[/#]')[last()]"/&gt;&lt;/dt&gt;
&lt;dd id="record-extra-value-{position()}" class="break-words text-sm"&gt;
&lt;xsl:for-each select="distinct-values(current-group()/fct:column[3] ! normalize-space(string(.)))[. != '']"&gt;
&lt;xsl:choose&gt;
&lt;xsl:when test="matches(., '^https?://')"&gt;&lt;a id="record-extra-uri-{position()}-{$groupIndex}" data-maestro-record-uri="{.}" href="#" class="text-primary hover:underline"&gt;&lt;xsl:value-of select="tokenize(., '[/#]')[last()]"/&gt;&lt;/a&gt;&lt;/xsl:when&gt;
&lt;xsl:otherwise&gt;&lt;span id="record-extra-text-{position()}-{$groupIndex}"&gt;&lt;xsl:value-of select="."/&gt;&lt;/span&gt;&lt;/xsl:otherwise&gt;
&lt;/xsl:choose&gt;&lt;xsl:if test="position() ne last()"&gt;&lt;span id="record-extra-separator-{position()}-{$groupIndex}"&gt; · &lt;/span&gt;&lt;/xsl:if&gt;
&lt;/xsl:for-each&gt;
&lt;/dd&gt;&lt;/div&gt;
&lt;/xsl:for-each-group&gt;
&lt;/dl&gt;&lt;/section&gt;&lt;/xsl:if&gt;&lt;footer id="record-footer" class="border-t px-5 py-3 text-xs text-muted-foreground"&gt;DBpedia record · Maestro formatter&lt;/footer&gt;&lt;/article&gt;&lt;svg:svg xmlns:svg="http://www.w3.org/2000/svg" id="dbpedia-place-record-heading-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" mui:parent="record_title_icon"&gt;&lt;svg:path id="dbpedia-place-record-icon-1" d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/&gt;&lt;svg:circle id="dbpedia-place-record-icon-2" cx="12" cy="10" r="2"/&gt;&lt;/svg:svg&gt;&lt;/section&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</rdf:value>
