  <rdf:Description rdf:about="gttp://ggg.maestro.ecosys/shacl/template#DbpediaBookRecordTemplate">
    <rdfs:label xml:lang="en">Book literary card</rdfs:label>
    <rdf:value>&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:fct="http://openlinksw.com/services/facets/1.0/" xmlns:mctx="gttp://ggg.maestro.ecosys/ns/xslt/context#" xmlns:m="gttp://ggg.maestro.ecosys/ns/xslt/commerce#" version="3.0" exclude-result-prefixes="xs fct mctx m"&gt;
&lt;xsl:output method="html" encoding="UTF-8" omit-xml-declaration="yes"/&gt;
&lt;xsl:param name="recordUri" as="xs:string" select="''"/&gt;
&lt;xsl:variable name="allRows" select="/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row"/&gt;
&lt;xsl:variable name="rows" select="$allRows[normalize-space(string(fct:column[1])) = $recordUri]"/&gt;
&lt;xsl:function name="m:values" as="xs:string*"&gt;&lt;xsl:param name="names" as="xs:string*"/&gt;
&lt;xsl:sequence select="distinct-values($rows[lower-case(tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()]) = $names]/fct:column[3] ! normalize-space(string(.)))[. ne '']"/&gt;
&lt;/xsl:function&gt;
&lt;xsl:function name="m:linked-values" as="xs:string*"&gt;&lt;xsl:param name="subject" as="xs:string"/&gt;&lt;xsl:param name="names" as="xs:string*"/&gt;
&lt;xsl:sequence select="distinct-values($allRows[normalize-space(string(fct:column[1])) = $subject and lower-case(tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()]) = $names]/fct:column[3] ! normalize-space(string(.)))[. ne '']"/&gt;
&lt;/xsl:function&gt;
&lt;xsl:function name="m:first" as="xs:string"&gt;&lt;xsl:param name="names" as="xs:string*"/&gt;&lt;xsl:sequence select="string((m:values($names))[1])"/&gt;&lt;/xsl:function&gt;
&lt;xsl:function name="m:pretty" as="xs:string"&gt;&lt;xsl:param name="uri" as="xs:string"/&gt;&lt;xsl:sequence select="replace(tokenize($uri, '[/#]')[last()], '_', ' ')"/&gt;&lt;/xsl:function&gt;
&lt;xsl:function name="m:is-uri" as="xs:boolean"&gt;&lt;xsl:param name="value" as="xs:string"/&gt;&lt;xsl:sequence select="matches($value, '^https?://')"/&gt;&lt;/xsl:function&gt;
&lt;xsl:template name="m:field"&gt;&lt;xsl:param name="key" as="xs:string"/&gt;&lt;xsl:param name="names" as="xs:string*"/&gt;&lt;xsl:param name="n" as="xs:string"/&gt;
&lt;xsl:variable name="values" select="m:values($names)"/&gt;
&lt;xsl:if test="exists($values)"&gt;&lt;div id="field-{$n}" class="flex flex-col gap-1 border-b border-border/60 py-3 sm:grid sm:grid-cols-[7.5rem_1fr] sm:gap-4"&gt;&lt;dt id="field-label-{$n}" class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground"&gt;&lt;xsl:value-of select="$key"/&gt;&lt;/dt&gt;&lt;dd id="field-data-{$n}" class="min-w-0 text-sm leading-relaxed text-foreground"&gt;&lt;xsl:for-each select="$values"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="m:is-uri(.)"&gt;&lt;a id="field-link-{$n}-{position()}" class="text-primary underline-offset-4 hover:underline" data-maestro-record-uri="{.}" href="#"&gt;&lt;xsl:value-of select="m:pretty(.)"/&gt;&lt;/a&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;span id="field-text-{$n}-{position()}"&gt;&lt;xsl:value-of select="."/&gt;&lt;/span&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="position() ne last()"&gt;&lt;span id="field-separator-{$n}-{position()}" class="text-muted-foreground"&gt; · &lt;/span&gt;&lt;/xsl:if&gt;&lt;/xsl:for-each&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;
&lt;/xsl:template&gt;
&lt;xsl:template name="m:extras"&gt;&lt;xsl:param name="excluded" as="xs:string*"/&gt;
&lt;xsl:variable name="other" select="$rows[fct:column[2] and fct:column[3] and not(lower-case(tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()]) = $excluded)]"/&gt;
&lt;xsl:if test="exists($other)"&gt;&lt;section id="record-additional-section" class="border-t border-border/70 px-6 py-5"&gt;&lt;h3 id="record-additional-title" class="mb-3 text-xs font-semibold uppercase tracking-[.18em] text-muted-foreground"&gt;Additional details&lt;/h3&gt;&lt;dl id="record-additional-list" class="divide-y divide-border/50"&gt;&lt;xsl:for-each-group select="$other" group-by="normalize-space(string(fct:column[2]))"&gt;&lt;xsl:variable name="idx" select="position()"/&gt;&lt;xsl:variable name="prop" select="current-grouping-key()"/&gt;&lt;div id="record-extra-{$idx}" class="grid gap-1 py-2 text-sm sm:grid-cols-[8rem_1fr]"&gt;&lt;dt id="record-extra-label-{$idx}" class="text-xs font-medium text-muted-foreground" title="{$prop}"&gt;&lt;xsl:value-of select="m:pretty($prop)"/&gt;&lt;/dt&gt;&lt;dd id="record-extra-values-{$idx}" class="min-w-0 break-words"&gt;&lt;xsl:for-each select="distinct-values(current-group()/fct:column[3] ! normalize-space(string(.)))[. ne '']"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="m:is-uri(.)"&gt;&lt;a id="record-extra-link-{$idx}-{position()}" data-maestro-record-uri="{.}" href="#" class="text-primary hover:underline"&gt;&lt;xsl:value-of select="m:pretty(.)"/&gt;&lt;/a&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;span id="record-extra-value-{$idx}-{position()}"&gt;&lt;xsl:value-of select="."/&gt;&lt;/span&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="position() ne last()"&gt;&lt;span id="record-extra-sep-{$idx}-{position()}"&gt; · &lt;/span&gt;&lt;/xsl:if&gt;&lt;/xsl:for-each&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:for-each-group&gt;&lt;/dl&gt;&lt;/section&gt;&lt;/xsl:if&gt;
&lt;/xsl:template&gt;
&lt;xsl:template match="/"&gt;
&lt;xsl:variable name="title" select="(m:values(('label','title','name','headline'))[not(m:is-uri(.))], m:pretty($recordUri))[1]"/&gt;
&lt;xsl:variable name="author" select="m:values(('author','writer','creator'))"/&gt;
&lt;xsl:variable name="cover" select="(m:values(('thumbnail','thumbnailurl','depiction','cover','coverart','image'))[m:is-uri(.)])[1]"/&gt;
&lt;xsl:variable name="rawIsbn" select="m:values(('isbn','isbn10','isbn13'))"/&gt;
&lt;xsl:variable name="isbn" select="(for $v in $rawIsbn return replace(upper-case($v), '[^0-9X]', ''))[matches(., '^[0-9]{13}$|^[0-9]{9}[0-9X]$')][1]"/&gt;
&lt;xsl:variable name="lookup" select="if ($isbn) then $isbn else $title"/&gt;
&lt;section xmlns:mui="gttp://ggg.maestro.ecosys/ns/ui#" mui:framework="next@^16.4.0" id="maestro-record-viewer" class="mx-auto w-full max-w-4xl p-1"&gt;
&lt;article id="record-card" class="overflow-hidden rounded-2xl border border-stone-300/60 bg-[#faf7f1] text-stone-900 shadow-lg dark:border-stone-700 dark:bg-[#211e1a] dark:text-stone-100"&gt;
&lt;div id="book-topline" class="h-1.5 bg-[#53735a]"/&gt;
&lt;div id="book-hero" class="grid gap-7 px-6 pb-7 pt-8 sm:grid-cols-[minmax(0,11rem)_1fr] sm:px-9"&gt;
&lt;div id="book-cover-frame" class="flex min-h-56 items-center justify-center overflow-hidden rounded-sm border border-[#b7a88d] bg-[#e3d5bd] shadow-[7px_9px_15px_rgba(0,0,0,.22)] dark:border-stone-700 dark:bg-stone-800"&gt;
&lt;xsl:choose&gt;&lt;xsl:when test="$cover"&gt;&lt;img id="book-cover" alt="Book cover" src="{$cover}" class="max-h-72 w-full object-contain" loading="lazy" referrerpolicy="no-referrer"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;div id="book-cover-placeholder" class="px-5 py-12 text-center"&gt;&lt;p id="book-cover-mark" class="font-serif text-5xl text-[#546b56]"&gt;✦&lt;/p&gt;&lt;p id="book-cover-text" class="mt-4 border-t border-stone-400/60 pt-4 font-serif text-lg font-semibold"&gt;&lt;xsl:value-of select="$title"/&gt;&lt;/p&gt;&lt;/div&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;
&lt;/div&gt;
&lt;div id="book-intro" class="min-w-0 self-center"&gt;
&lt;p id="book-eyebrow" class="text-[10px] font-semibold uppercase tracking-[.32em] text-[#53735a] dark:text-[#a5c5a8]"&gt;THE READING ROOM · DBPEDIA&lt;/p&gt;
&lt;h2 id="book-title" class="mt-4 break-words font-serif text-3xl font-semibold leading-tight tracking-tight sm:text-4xl"&gt;&lt;xsl:value-of select="$title"/&gt;&lt;/h2&gt;
&lt;xsl:if test="exists($author)"&gt;&lt;p id="book-author" class="mt-3 font-serif text-lg italic text-stone-600 dark:text-stone-300"&gt;by &lt;xsl:for-each select="$author"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="m:is-uri(.)"&gt;&lt;a id="book-author-link-{position()}" href="#" data-maestro-record-uri="{.}" class="underline decoration-stone-400 underline-offset-4"&gt;&lt;xsl:value-of select="m:pretty(.)"/&gt;&lt;/a&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;span id="book-author-text-{position()}"&gt;&lt;xsl:value-of select="."/&gt;&lt;/span&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="position()!=last()"&gt; · &lt;/xsl:if&gt;&lt;/xsl:for-each&gt;&lt;/p&gt;&lt;/xsl:if&gt;
&lt;xsl:variable name="summary" select="m:first(('abstract','description','comment'))"/&gt;
&lt;xsl:if test="$summary"&gt;&lt;p id="book-summary" class="mt-5 max-w-prose text-sm leading-7 text-stone-600 dark:text-stone-300"&gt;&lt;xsl:value-of select="$summary"/&gt;&lt;/p&gt;&lt;/xsl:if&gt;
&lt;xsl:if test="$isbn"&gt;&lt;div id="book-isbn" class="mt-5 inline-flex rounded-md border border-stone-300 bg-white/60 px-3 py-2 text-xs font-medium tracking-wider dark:border-stone-600 dark:bg-stone-800"&gt;ISBN &lt;xsl:value-of select="$isbn"/&gt;&lt;/div&gt;&lt;/xsl:if&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;div id="book-meta-wrap" class="border-y border-stone-300/70 bg-white/50 px-6 py-2 dark:border-stone-700 dark:bg-stone-900/40 sm:px-9"&gt;&lt;dl id="book-meta" class="grid gap-x-6 sm:grid-cols-2"&gt;
&lt;xsl:call-template name="m:field"&gt;&lt;xsl:with-param name="key" select="'Publisher'"/&gt;&lt;xsl:with-param name="names" select="('publisher')"/&gt;&lt;xsl:with-param name="n" select="'publisher'"/&gt;&lt;/xsl:call-template&gt;
&lt;xsl:call-template name="m:field"&gt;&lt;xsl:with-param name="key" select="'Published'"/&gt;&lt;xsl:with-param name="names" select="('publicationdate','releasedate','datepublished','year')"/&gt;&lt;xsl:with-param name="n" select="'date'"/&gt;&lt;/xsl:call-template&gt;
&lt;xsl:call-template name="m:field"&gt;&lt;xsl:with-param name="key" select="'Genre'"/&gt;&lt;xsl:with-param name="names" select="('literarygenre','genre')"/&gt;&lt;xsl:with-param name="n" select="'genre'"/&gt;&lt;/xsl:call-template&gt;
&lt;xsl:call-template name="m:field"&gt;&lt;xsl:with-param name="key" select="'Language'"/&gt;&lt;xsl:with-param name="names" select="('language','originallanguage','inlanguage')"/&gt;&lt;xsl:with-param name="n" select="'language'"/&gt;&lt;/xsl:call-template&gt;
&lt;xsl:call-template name="m:field"&gt;&lt;xsl:with-param name="key" select="'Pages'"/&gt;&lt;xsl:with-param name="names" select="('numberofpages','pages')"/&gt;&lt;xsl:with-param name="n" select="'pages'"/&gt;&lt;/xsl:call-template&gt;
&lt;/dl&gt;&lt;/div&gt;
&lt;xsl:variable name="reviewEntries" select="m:values(('review','reviews','hasreview','bookreview','criticsreview','userreview','reviewbody','reviewtext'))"/&gt;
&lt;xsl:variable name="ratingValues" select="m:values(('ratingvalue','averagerating','rating','score'))"/&gt;
&lt;xsl:variable name="aggregateRatings" select="m:values(('aggregaterating'))"/&gt;
&lt;xsl:variable name="ratingCount" select="m:first(('ratingcount'))"/&gt;
&lt;xsl:variable name="reviewCount" select="m:first(('reviewcount','numberofreviews'))"/&gt;
&lt;xsl:variable name="bestRating" select="m:first(('bestrating'))"/&gt;
&lt;xsl:if test="exists($reviewEntries) or exists($ratingValues) or exists($aggregateRatings) or $ratingCount ne '' or $reviewCount ne ''"&gt;
&lt;section id="book-reviews-ratings" class="border-t border-[#c5b59d]/60 bg-[#f1ece3] px-6 py-7 dark:border-stone-700 dark:bg-[#29251f] sm:px-9"&gt;
&lt;div id="book-reviews-heading" class="mb-5 flex items-center gap-3"&gt;&lt;span id="book-reviews-star" aria-hidden="true" class="text-2xl text-[#a07835]"&gt;★&lt;/span&gt;&lt;div id="book-reviews-heading-text"&gt;&lt;p id="book-reviews-eyebrow" class="text-[10px] font-semibold uppercase tracking-[.25em] text-[#53735a] dark:text-[#a5c5a8]"&gt;Readers &amp;amp; critics&lt;/p&gt;&lt;h3 id="book-reviews-title" class="font-serif text-2xl font-semibold"&gt;Reviews &amp;amp; ratings&lt;/h3&gt;&lt;/div&gt;&lt;/div&gt;
&lt;xsl:if test="exists($ratingValues) or exists($aggregateRatings) or $ratingCount ne '' or $reviewCount ne ''"&gt;
&lt;div id="book-rating-summary" class="mb-5 flex flex-wrap gap-3"&gt;
&lt;xsl:for-each select="$ratingValues"&gt;
&lt;xsl:variable name="rawValue" select="normalize-space(.)"/&gt;
&lt;xsl:variable name="numericRating" select="if ($rawValue castable as xs:decimal) then xs:decimal($rawValue) else ()"/&gt;
&lt;xsl:variable name="numericBest" select="if ($bestRating castable as xs:decimal and xs:decimal($bestRating) gt 0) then xs:decimal($bestRating) else if (exists($numericRating) and $numericRating gt 5) then ceiling($numericRating) else 5"/&gt;
&lt;xsl:variable name="starSlots" as="xs:integer" select="xs:integer(ceiling($numericBest))"/&gt;
&lt;xsl:variable name="stars" select="if (exists($numericRating)) then max((0, min(($numericBest, floor($numericRating * 2 + 0.5) div 2)))) else ()"/&gt;
&lt;div id="book-rating-{position()}" class="rounded-lg border border-[#d1c1a7] bg-white/70 px-4 py-3 dark:border-stone-600 dark:bg-stone-800"&gt;
&lt;div id="book-rating-label-{position()}" class="text-[10px] font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400"&gt;Rating&lt;/div&gt;
&lt;xsl:choose&gt;
&lt;xsl:when test="exists($stars)"&gt;
&lt;div id="book-rating-stars-{position()}" class="mt-2 flex items-center gap-0.5" role="img" aria-label="{concat($rawValue, ' out of ', $numericBest, ', shown as ', $stars, ' out of ', $starSlots, ' stars')}"&gt;
&lt;xsl:variable name="ratingIndex" select="position()"/&gt;
&lt;xsl:for-each select="1 to $starSlots"&gt;
&lt;xsl:variable name="starIndex" select="."/&gt;
&lt;xsl:variable name="goldWidth" select="if ($stars ge $starIndex) then 24 else if ($stars ge $starIndex - 0.5) then 12 else 0"/&gt;
&lt;svg xmlns="http://www.w3.org/2000/svg" id="book-rating-star-{$ratingIndex}-{$starIndex}" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" class="shrink-0"&gt;
&lt;defs&gt;&lt;clipPath id="book-rating-star-clip-{$ratingIndex}-{$starIndex}"&gt;&lt;rect id="book-rating-star-cliprect-{$ratingIndex}-{$starIndex}" x="0" y="0" width="{$goldWidth}" height="24"/&gt;&lt;/clipPath&gt;&lt;/defs&gt;
&lt;path id="book-rating-star-muted-{$ratingIndex}-{$starIndex}" d="m12 2 3.09 6.26 6.91 1-5 4.87 1.18 6.89L12 17.77l-6.18 3.25L7 14.13l-5-4.87 6.91-1L12 2Z" fill="currentColor" class="text-stone-300 dark:text-stone-600"/&gt;
&lt;path id="book-rating-star-gold-{$ratingIndex}-{$starIndex}" d="m12 2 3.09 6.26 6.91 1-5 4.87 1.18 6.89L12 17.77l-6.18 3.25L7 14.13l-5-4.87 6.91-1L12 2Z" fill="#eab308" clip-path="url(#book-rating-star-clip-{$ratingIndex}-{$starIndex})"/&gt;
&lt;/svg&gt;
&lt;/xsl:for-each&gt;
&lt;/div&gt;
&lt;/xsl:when&gt;
&lt;xsl:when test="m:is-uri($rawValue)"&gt;&lt;a id="book-rating-link-{position()}" href="#" data-maestro-record-uri="{$rawValue}" class="mt-1 block text-primary hover:underline"&gt;&lt;xsl:value-of select="m:pretty($rawValue)"/&gt;&lt;/a&gt;&lt;/xsl:when&gt;
&lt;xsl:otherwise&gt;&lt;span id="book-rating-text-{position()}" class="mt-1 block text-sm"&gt;&lt;xsl:value-of select="$rawValue"/&gt;&lt;/span&gt;&lt;/xsl:otherwise&gt;
&lt;/xsl:choose&gt;
&lt;/div&gt;
&lt;/xsl:for-each&gt;
&lt;xsl:for-each select="$aggregateRatings"&gt;
&lt;div id="book-aggregate-{position()}" class="rounded-lg border border-[#d1c1a7] bg-white/70 px-4 py-3 dark:border-stone-600 dark:bg-stone-800"&gt;
&lt;div id="book-aggregate-title-{position()}" class="text-[10px] font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400"&gt;Aggregate rating&lt;/div&gt;
&lt;div id="book-aggregate-value-{position()}" class="mt-1 font-serif text-base font-semibold"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="m:is-uri(.)"&gt;&lt;a id="book-aggregate-link-{position()}" href="#" data-maestro-record-uri="{.}" class="text-primary hover:underline"&gt;&lt;xsl:value-of select="m:pretty(.)"/&gt;&lt;/a&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;span id="book-aggregate-text-{position()}"&gt;&lt;xsl:value-of select="."/&gt;&lt;/span&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/div&gt;
&lt;/div&gt;
&lt;/xsl:for-each&gt;
&lt;xsl:if test="$ratingCount ne ''"&gt;&lt;div id="book-rating-count" class="rounded-lg border border-[#d1c1a7] bg-white/70 px-4 py-3 dark:border-stone-600 dark:bg-stone-800"&gt;&lt;div id="book-rating-count-label" class="text-[10px] font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400"&gt;Ratings&lt;/div&gt;&lt;div id="book-rating-count-value" class="mt-1 font-serif text-xl font-semibold"&gt;&lt;xsl:value-of select="$ratingCount"/&gt;&lt;/div&gt;&lt;/div&gt;&lt;/xsl:if&gt;
&lt;xsl:if test="$reviewCount ne ''"&gt;&lt;div id="book-review-count" class="rounded-lg border border-[#d1c1a7] bg-white/70 px-4 py-3 dark:border-stone-600 dark:bg-stone-800"&gt;&lt;div id="book-review-count-label" class="text-[10px] font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400"&gt;Reviews&lt;/div&gt;&lt;div id="book-review-count-value" class="mt-1 font-serif text-xl font-semibold"&gt;&lt;xsl:value-of select="$reviewCount"/&gt;&lt;/div&gt;&lt;/div&gt;&lt;/xsl:if&gt;
&lt;/div&gt;&lt;/xsl:if&gt;
&lt;xsl:if test="exists($reviewEntries)"&gt;
&lt;div id="book-review-table-scroll" class="overflow-x-auto rounded-xl border border-[#d1c1a7] bg-white/75 dark:border-stone-600 dark:bg-stone-800/80"&gt;
&lt;table id="book-review-table" class="w-full min-w-[35rem] border-collapse text-left text-sm"&gt;
&lt;thead id="book-review-table-head" class="bg-[#e8dfd1] text-xs uppercase tracking-wider text-stone-600 dark:bg-stone-700 dark:text-stone-200"&gt;&lt;tr id="book-review-head-row"&gt;&lt;th id="book-review-head-author" class="px-4 py-3"&gt;Reviewer&lt;/th&gt;&lt;th id="book-review-head-stars" class="px-4 py-3"&gt;Rating&lt;/th&gt;&lt;th id="book-review-head-body" class="px-4 py-3"&gt;Review&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;
&lt;tbody id="book-review-table-body" class="divide-y divide-[#d1c1a7] dark:divide-stone-700"&gt;
&lt;xsl:for-each select="$reviewEntries"&gt;
&lt;xsl:variable name="index" select="position()"/&gt;
&lt;xsl:variable name="reviewUri" select="."/&gt;
&lt;xsl:variable name="authors" select="if (m:is-uri($reviewUri)) then m:linked-values($reviewUri, ('author')) else ()"/&gt;
&lt;xsl:variable name="ratingUris" select="if (m:is-uri($reviewUri)) then m:linked-values($reviewUri, ('reviewrating')) else ()"/&gt;
&lt;xsl:variable name="ratingValue" select="string((for $r in $ratingUris return m:linked-values($r, ('ratingvalue')), m:linked-values($reviewUri, ('ratingvalue')))[1])"/&gt;
&lt;xsl:variable name="bestValue" select="string((for $r in $ratingUris return m:linked-values($r, ('bestrating')), m:linked-values($reviewUri, ('bestrating')))[1])"/&gt;
&lt;xsl:variable name="body" select="string((m:linked-values($reviewUri, ('reviewbody','description')), if (not(m:is-uri($reviewUri))) then $reviewUri else ())[1])"/&gt;
&lt;xsl:variable name="score" select="if ($ratingValue castable as xs:decimal) then max((0, xs:decimal($ratingValue))) else 0"/&gt;
&lt;xsl:variable name="maximum" select="if ($bestValue castable as xs:decimal and xs:decimal($bestValue) gt 0) then xs:decimal($bestValue) else if ($score gt 5) then xs:decimal(ceiling($score)) else xs:decimal(5)"/&gt;
&lt;xsl:variable name="slots" select="xs:integer(min((20, ceiling($maximum))))"/&gt;
&lt;xsl:variable name="filled" select="min(($slots, floor(($score div $maximum) * $slots * 2 + 0.5) div 2))"/&gt;
&lt;tr id="book-review-row-{$index}" class="align-top"&gt;
&lt;td id="book-review-author-{$index}" class="px-4 py-4 font-medium"&gt;
&lt;xsl:choose&gt;&lt;xsl:when test="exists($authors)"&gt;&lt;xsl:for-each select="$authors"&gt;&lt;xsl:variable name="name" select="string((m:linked-values(., ('name','label')), m:pretty(.))[1])"/&gt;&lt;xsl:choose&gt;&lt;xsl:when test="m:is-uri(.)"&gt;&lt;a id="book-review-author-link-{$index}-{position()}" data-maestro-record-uri="{.}" href="#" class="text-primary hover:underline"&gt;&lt;xsl:value-of select="$name"/&gt;&lt;/a&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;span id="book-review-author-name-{$index}-{position()}"&gt;&lt;xsl:value-of select="."/&gt;&lt;/span&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:for-each&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;a id="book-review-source-{$index}" href="#" data-maestro-record-uri="{$reviewUri}" class="text-primary hover:underline"&gt;Review source&lt;/a&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;
&lt;/td&gt;
&lt;td id="book-review-stars-cell-{$index}" class="px-4 py-4"&gt;
&lt;xsl:choose&gt;&lt;xsl:when test="$ratingValue castable as xs:decimal"&gt;&lt;div id="book-review-stars-{$index}" class="flex items-center gap-0.5" role="img" aria-label="{concat($ratingValue, ' of ', $maximum)}"&gt;
&lt;xsl:for-each select="1 to $slots"&gt;&lt;xsl:variable name="star" select="."/&gt;&lt;xsl:variable name="width" select="if ($filled ge $star) then 24 else if ($filled ge $star - 0.5) then 12 else 0"/&gt;
&lt;svg xmlns="http://www.w3.org/2000/svg" id="book-review-star-{$index}-{$star}" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"&gt;&lt;defs&gt;&lt;clipPath id="book-review-star-clip-{$index}-{$star}"&gt;&lt;rect id="book-review-star-clip-rect-{$index}-{$star}" x="0" y="0" width="{$width}" height="24"/&gt;&lt;/clipPath&gt;&lt;/defs&gt;&lt;path id="book-review-star-muted-{$index}-{$star}" d="m12 2 3.09 6.26 6.91 1-5 4.87 1.18 6.89L12 17.77l-6.18 3.25L7 14.13l-5-4.87 6.91-1L12 2Z" fill="#a8a29e"/&gt;&lt;path id="book-review-star-gold-{$index}-{$star}" d="m12 2 3.09 6.26 6.91 1-5 4.87 1.18 6.89L12 17.77l-6.18 3.25L7 14.13l-5-4.87 6.91-1L12 2Z" fill="#eab308" clip-path="url(#book-review-star-clip-{$index}-{$star})"/&gt;&lt;/svg&gt;
&lt;/xsl:for-each&gt;&lt;/div&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;span id="book-review-no-rating-{$index}" class="text-stone-500"&gt;Not rated&lt;/span&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;
&lt;/td&gt;
&lt;td id="book-review-body-{$index}" class="max-w-lg whitespace-pre-line break-words px-4 py-4 leading-6"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$body ne ''"&gt;&lt;xsl:value-of select="$body"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;a id="book-review-body-link-{$index}" href="#" data-maestro-record-uri="{$reviewUri}" class="text-primary hover:underline"&gt;Open review&lt;/a&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/xsl:for-each&gt;
&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;
&lt;/xsl:if&gt;
&lt;/section&gt;&lt;/xsl:if&gt;
&lt;section id="book-links" class="px-6 py-6 sm:px-9"&gt;&lt;h3 id="book-links-title" class="mb-1 font-serif text-xl font-semibold"&gt;Find this book&lt;/h3&gt;&lt;p id="book-links-note" class="mb-4 text-xs text-stone-500 dark:text-stone-400"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$isbn"&gt;Search by ISBN · seller listings are not verified&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;Search by title · ISBN not found in this record&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/p&gt;
&lt;div id="book-shop-grid" class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3"&gt;
&lt;a id="book-amazon" href="{concat('https://www.amazon.com/s?k=', encode-for-uri($lookup))}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-lg border border-[#c5b59d] bg-white px-4 py-3 text-sm font-semibold shadow-sm transition hover:border-[#53735a] hover:shadow-md dark:border-stone-600 dark:bg-stone-800"&gt;Amazon &lt;span id="book-amazon-arrow"&gt;↗&lt;/span&gt;&lt;/a&gt;
&lt;a id="book-barnes" href="{concat('https://www.barnesandnoble.com/s/', encode-for-uri($lookup))}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-lg border border-[#c5b59d] bg-white px-4 py-3 text-sm font-semibold shadow-sm transition hover:border-[#53735a] hover:shadow-md dark:border-stone-600 dark:bg-stone-800"&gt;Barnes &amp;amp; Noble &lt;span id="book-barnes-arrow"&gt;↗&lt;/span&gt;&lt;/a&gt;
&lt;a id="book-google" href="{concat('https://books.google.com/books?q=', encode-for-uri($lookup))}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-lg border border-[#c5b59d] bg-white px-4 py-3 text-sm font-semibold shadow-sm transition hover:border-[#53735a] hover:shadow-md dark:border-stone-600 dark:bg-stone-800"&gt;Google Books &lt;span id="book-google-arrow"&gt;↗&lt;/span&gt;&lt;/a&gt;
&lt;a id="book-openlibrary" href="{if ($isbn) then concat('https://openlibrary.org/isbn/', encode-for-uri($isbn)) else concat('https://openlibrary.org/search?q=', encode-for-uri($title))}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-lg border border-[#c5b59d] bg-white px-4 py-3 text-sm font-semibold shadow-sm transition hover:border-[#53735a] hover:shadow-md dark:border-stone-600 dark:bg-stone-800"&gt;Open Library &lt;span id="book-openlibrary-arrow"&gt;↗&lt;/span&gt;&lt;/a&gt;
&lt;a id="book-goodreads" href="{concat('https://www.goodreads.com/search?q=', encode-for-uri($lookup))}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-lg border border-[#c5b59d] bg-white px-4 py-3 text-sm font-semibold shadow-sm transition hover:border-[#53735a] hover:shadow-md dark:border-stone-600 dark:bg-stone-800"&gt;Goodreads &lt;span id="book-goodreads-arrow"&gt;↗&lt;/span&gt;&lt;/a&gt;
&lt;a id="book-bookshop" href="{concat('https://bookshop.org/search?keywords=', encode-for-uri($lookup))}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-lg border border-[#c5b59d] bg-white px-4 py-3 text-sm font-semibold shadow-sm transition hover:border-[#53735a] hover:shadow-md dark:border-stone-600 dark:bg-stone-800"&gt;Bookshop.org &lt;span id="book-bookshop-arrow"&gt;↗&lt;/span&gt;&lt;/a&gt;
&lt;/div&gt;&lt;/section&gt;
&lt;xsl:call-template name="m:extras"&gt;&lt;xsl:with-param name="excluded" select="('type','label','title','name','abstract','description','comment','author','writer','creator','thumbnail','thumbnailurl','depiction','cover','coverart','image','isbn','isbn10','isbn13','publisher','publicationdate','releasedate','datepublished','year','literarygenre','genre','language','originallanguage','inlanguage','numberofpages','pages','review','reviews','hasreview','bookreview','criticsreview','userreview','reviewbody','reviewtext','ratingvalue','averagerating','rating','score','aggregaterating','ratingcount','reviewcount','numberofreviews','bestrating')"/&gt;&lt;/xsl:call-template&gt;
&lt;footer id="book-footer" class="px-6 pb-5 pt-2 text-center text-[10px] uppercase tracking-[.22em] text-stone-500 dark:text-stone-400"&gt;Book metadata · DBpedia · Maestro&lt;/footer&gt;
&lt;/article&gt;&lt;svg:svg xmlns:svg="http://www.w3.org/2000/svg" id="dbpedia-book-record-heading-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" mui:parent="record_title_icon"&gt;&lt;svg:path id="dbpedia-book-record-icon-1" d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/&gt;&lt;svg:path id="dbpedia-book-record-icon-2" d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/&gt;&lt;/svg:svg&gt;&lt;/section&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="gttp://ggg.maestro.ecosys/shacl/template#DbpediaSpeciesRecordTemplate">
    <rdfs:label xml:lang="en">Species taxonomy card</rdfs:label>
    <rdf:value>&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:fct="http://openlinksw.com/services/facets/1.0/" xmlns:mctx="gttp://ggg.maestro.ecosys/ns/xslt/context#" xmlns:m="gttp://ggg.maestro.ecosys/ns/xslt/dbpedia#" version="3.0" exclude-result-prefixes="xs fct mctx m"&gt;
&lt;xsl:output method="html" encoding="UTF-8" omit-xml-declaration="yes"/&gt;&lt;xsl:param name="recordUri"/&gt;
&lt;xsl:function name="m:values" as="xs:string"&gt;
&lt;xsl:param name="ctx" as="node()"/&gt;&lt;xsl:param name="predicate" as="xs:string"/&gt;
&lt;xsl:variable name="localName" select="tokenize($predicate, '[/#]')[last()]"/&gt;
&lt;xsl:variable name="rows" select="$ctx/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[2] = $predicate or tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()] = $localName]"/&gt;
&lt;xsl:sequence select="string-join(distinct-values($rows/fct:column[3] ! normalize-space(string(.)))[. != ''], ', ')"/&gt;
&lt;/xsl:function&gt;
&lt;xsl:template match="/"&gt;&lt;section xmlns:mui="gttp://ggg.maestro.ecosys/ns/ui#" mui:framework="next@^16.4.0" id="maestro-record-viewer" class="mx-auto w-full max-w-2xl p-1"&gt;&lt;article id="record-card" class="rounded-xl border bg-card text-card-foreground shadow-sm"&gt;&lt;header id="record-header" class="border-b bg-muted/40 px-5 py-4"&gt;&lt;p id="record-category" class="text-xs font-semibold uppercase tracking-wide text-muted-foreground"&gt;DBpedia · Species&lt;/p&gt;&lt;h2 id="record-title" class="mt-1 break-words text-xl font-semibold"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="m:values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label') != ''"&gt;&lt;xsl:value-of select="m:values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label')"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:value-of select="$recordUri"/&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/h2&gt;&lt;/header&gt;&lt;dl id="record-fields" class="px-5 py-2"&gt;      &lt;xsl:variable name="v0" select="m:values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label')"/&gt;
      &lt;xsl:if test="$v0 != ''"&gt;&lt;div id="record-row-0" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-0" class="text-xs font-medium text-muted-foreground"&gt;Name&lt;/dt&gt;&lt;dd id="record-value-0" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v0"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;      &lt;xsl:variable name="v1" select="m:values(root(.), 'http://dbpedia.org/ontology/scientificName')"/&gt;
      &lt;xsl:if test="$v1 != ''"&gt;&lt;div id="record-row-1" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-1" class="text-xs font-medium text-muted-foreground"&gt;Scientific name&lt;/dt&gt;&lt;dd id="record-value-1" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v1"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;      &lt;xsl:variable name="v2" select="m:values(root(.), 'http://dbpedia.org/ontology/kingdom')"/&gt;
      &lt;xsl:if test="$v2 != ''"&gt;&lt;div id="record-row-2" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-2" class="text-xs font-medium text-muted-foreground"&gt;Kingdom&lt;/dt&gt;&lt;dd id="record-value-2" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v2"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;      &lt;xsl:variable name="v3" select="m:values(root(.), 'http://dbpedia.org/ontology/family')"/&gt;
      &lt;xsl:if test="$v3 != ''"&gt;&lt;div id="record-row-3" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-3" class="text-xs font-medium text-muted-foreground"&gt;Family&lt;/dt&gt;&lt;dd id="record-value-3" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v3"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;      &lt;xsl:variable name="v4" select="m:values(root(.), 'http://dbpedia.org/ontology/genus')"/&gt;
      &lt;xsl:if test="$v4 != ''"&gt;&lt;div id="record-row-4" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-4" class="text-xs font-medium text-muted-foreground"&gt;Genus&lt;/dt&gt;&lt;dd id="record-value-4" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v4"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;      &lt;xsl:variable name="v5" select="m:values(root(.), 'http://dbpedia.org/ontology/conservationStatus')"/&gt;
      &lt;xsl:if test="$v5 != ''"&gt;&lt;div id="record-row-5" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"&gt;&lt;dt id="record-key-5" class="text-xs font-medium text-muted-foreground"&gt;Conservation status&lt;/dt&gt;&lt;dd id="record-value-5" class="break-words text-sm"&gt;&lt;xsl:value-of select="$v5"/&gt;&lt;/dd&gt;&lt;/div&gt;&lt;/xsl:if&gt;&lt;/dl&gt;&lt;xsl:variable name="allPropertyRows" select="root(.)/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[2] and fct:column[3] and not(fct:column[2] = ('http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://www.w3.org/2000/01/rdf-schema#label', 'http://purl.org/dc/terms/subject', 'http://dbpedia.org/ontology/abstract', 'http://xmlns.com/foaf/0.1/depiction', 'http://dbpedia.org/ontology/thumbnail'))]"/&gt;
&lt;xsl:if test="exists($allPropertyRows)"&gt;
&lt;section id="record-additional-section" class="border-t px-5 py-4"&gt;
&lt;h3 id="record-additional-title" class="mb-2 text-sm font-semibold"&gt;Additional details&lt;/h3&gt;
&lt;dl id="record-additional-list" class="divide-y"&gt;
&lt;xsl:for-each-group select="$allPropertyRows" group-by="normalize-space(string(fct:column[2]))"&gt;
&lt;xsl:variable name="predicate" select="current-grouping-key()"/&gt;&lt;xsl:variable name="groupIndex" select="position()"/&gt;
&lt;div id="record-extra-{position()}" class="grid gap-1 py-2 sm:grid-cols-[9rem_1fr]"&gt;
&lt;dt id="record-extra-key-{position()}" class="break-all text-xs font-medium text-muted-foreground" title="{$predicate}"&gt;&lt;xsl:value-of select="tokenize($predicate, '[/#]')[last()]"/&gt;&lt;/dt&gt;
&lt;dd id="record-extra-value-{position()}" class="break-words text-sm"&gt;
&lt;xsl:for-each select="distinct-values(current-group()/fct:column[3] ! normalize-space(string(.)))[. != '']"&gt;
&lt;xsl:choose&gt;
&lt;xsl:when test="matches(., '^https?://')"&gt;&lt;a id="record-extra-uri-{position()}-{$groupIndex}" data-maestro-record-uri="{.}" href="#" class="text-primary hover:underline"&gt;&lt;xsl:value-of select="tokenize(., '[/#]')[last()]"/&gt;&lt;/a&gt;&lt;/xsl:when&gt;
&lt;xsl:otherwise&gt;&lt;span id="record-extra-text-{position()}-{$groupIndex}"&gt;&lt;xsl:value-of select="."/&gt;&lt;/span&gt;&lt;/xsl:otherwise&gt;
&lt;/xsl:choose&gt;&lt;xsl:if test="position() ne last()"&gt;&lt;span id="record-extra-separator-{position()}-{$groupIndex}"&gt; · &lt;/span&gt;&lt;/xsl:if&gt;
&lt;/xsl:for-each&gt;
&lt;/dd&gt;&lt;/div&gt;
&lt;/xsl:for-each-group&gt;
&lt;/dl&gt;&lt;/section&gt;&lt;/xsl:if&gt;&lt;footer id="record-footer" class="border-t px-5 py-3 text-xs text-muted-foreground"&gt;DBpedia record · Maestro formatter&lt;/footer&gt;&lt;/article&gt;&lt;svg:svg xmlns:svg="http://www.w3.org/2000/svg" id="dbpedia-species-record-heading-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" mui:parent="record_title_icon"&gt;&lt;svg:path id="dbpedia-species-record-icon-1" d="M11 20A7 7 0 0 1 4 13C4 5 16 3 21 3c0 5-2 17-10 17Z"/&gt;&lt;svg:path id="dbpedia-species-record-icon-2" d="M3 21c0-6 6-12 12-12"/&gt;&lt;/svg:svg&gt;&lt;/section&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1866a0e1444845d885ab317ed4c989bb">
    <sh:name xml:lang="en">Publisher</sh:name>
    <sh:path rdf:nodeID="N19a01bd444924b4c81fc0347a0fafbc9"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N287dd61fac114b71b9fcab462277eb16">
    <sh:name xml:lang="en">Cover</sh:name>
