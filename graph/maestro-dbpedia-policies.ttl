      <xsl:if test="$v1 != ''"><div id="record-row-1" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"><dt id="record-key-1" class="text-xs font-medium text-muted-foreground">Creator</dt><dd id="record-value-1" class="break-words text-sm"><xsl:value-of select="$v1"/></dd></div></xsl:if>      <xsl:variable name="v2" select="m:values(root(.), 'http://dbpedia.org/ontology/releaseDate')"/>
      <xsl:if test="$v2 != ''"><div id="record-row-2" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"><dt id="record-key-2" class="text-xs font-medium text-muted-foreground">Release date</dt><dd id="record-value-2" class="break-words text-sm"><xsl:value-of select="$v2"/></dd></div></xsl:if>      <xsl:variable name="v3" select="m:values(root(.), 'http://dbpedia.org/ontology/genre')"/>
      <xsl:if test="$v3 != ''"><div id="record-row-3" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"><dt id="record-key-3" class="text-xs font-medium text-muted-foreground">Genre</dt><dd id="record-value-3" class="break-words text-sm"><xsl:value-of select="$v3"/></dd></div></xsl:if>      <xsl:variable name="v4" select="m:values(root(.), 'http://dbpedia.org/ontology/language')"/>
      <xsl:if test="$v4 != ''"><div id="record-row-4" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"><dt id="record-key-4" class="text-xs font-medium text-muted-foreground">Language</dt><dd id="record-value-4" class="break-words text-sm"><xsl:value-of select="$v4"/></dd></div></xsl:if></dl><xsl:variable name="allPropertyRows" select="root(.)/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[2] and fct:column[3] and not(fct:column[2] = ('http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://www.w3.org/2000/01/rdf-schema#label', 'http://purl.org/dc/terms/subject', 'http://dbpedia.org/ontology/abstract', 'http://xmlns.com/foaf/0.1/depiction', 'http://dbpedia.org/ontology/thumbnail'))]"/>
<xsl:if test="exists($allPropertyRows)">
<section id="record-additional-section" class="border-t px-5 py-4">
<h3 id="record-additional-title" class="mb-2 text-sm font-semibold">Additional details</h3>
<dl id="record-additional-list" class="divide-y">
<xsl:for-each-group select="$allPropertyRows" group-by="normalize-space(string(fct:column[2]))">
<xsl:variable name="predicate" select="current-grouping-key()"/><xsl:variable name="groupIndex" select="position()"/>
<div id="record-extra-{position()}" class="grid gap-1 py-2 sm:grid-cols-[9rem_1fr]">
<dt id="record-extra-key-{position()}" class="break-all text-xs font-medium text-muted-foreground" title="{$predicate}"><xsl:value-of select="tokenize($predicate, '[/#]')[last()]"/></dt>
<dd id="record-extra-value-{position()}" class="break-words text-sm">
<xsl:for-each select="distinct-values(current-group()/fct:column[3] ! normalize-space(string(.)))[. != '']">
<xsl:choose>
<xsl:when test="matches(., '^https?://')"><a id="record-extra-uri-{position()}-{$groupIndex}" data-maestro-record-uri="{.}" href="#" class="text-primary hover:underline"><xsl:value-of select="tokenize(., '[/#]')[last()]"/></a></xsl:when>
<xsl:otherwise><span id="record-extra-text-{position()}-{$groupIndex}"><xsl:value-of select="."/></span></xsl:otherwise>
</xsl:choose><xsl:if test="position() ne last()"><span id="record-extra-separator-{position()}-{$groupIndex}"> · </span></xsl:if>
</xsl:for-each>
</dd></div>
</xsl:for-each-group>
</dl></section></xsl:if><footer id="record-footer" class="border-t px-5 py-3 text-xs text-muted-foreground">DBpedia record · Maestro formatter</footer></article><svg:svg xmlns:svg="http://www.w3.org/2000/svg" id="dbpedia-work-record-heading-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" mui:parent="record_title_icon"><svg:path id="dbpedia-work-record-icon-1" d="M12 7v14"/><svg:path id="dbpedia-work-record-icon-2" d="M3 18V5a2 2 0 0 1 2-2h3a4 4 0 0 1 4 4 4 4 0 0 1 4-4h3a2 2 0 0 1 2 2v13a1 1 0 0 1-1 1h-4a4 4 0 0 0-4 2 4 4 0 0 0-4-2H4a1 1 0 0 1-1-1Z"/></svg:svg></section></xsl:template></xsl:stylesheet>""" .

