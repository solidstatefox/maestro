@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dbp: <http://dbpedia.org/property/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo1: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix mui: <gttp://ggg.maestro.ecosys/ns/ui#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix schemahttps: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<gttp://ggg.maestro.ecosys/shacl/policy/dbpedia-book> a mui:ClassPolicy ;
    rdfs:label "DBpedia Book policy"@en ;
    mui:forClass dbo:Book,
        schema1:Book,
        schemahttps:Book ;
    mui:recordShape <gttp://ggg.maestro.ecosys/shacl/shape#DbpediaBookRecordShape> ;
    mui:xsltTemplate <gttp://ggg.maestro.ecosys/shacl/template#DbpediaBookRecordTemplate> .

<gttp://ggg.maestro.ecosys/shacl/policy/dbpedia-film> a mui:ClassPolicy ;
    rdfs:label "DBpedia Film policy"@en ;
    mui:forClass dbo:Film ;
    mui:recordShape <gttp://ggg.maestro.ecosys/shacl/shape#DbpediaFilmRecordShape> ;
    mui:xsltTemplate <gttp://ggg.maestro.ecosys/shacl/template#DbpediaFilmRecordTemplate> .

<gttp://ggg.maestro.ecosys/shacl/policy/dbpedia-organisation> a mui:ClassPolicy ;
    rdfs:label "DBpedia Organisation policy"@en ;
    mui:forClass dbo:Organisation ;
    mui:recordShape <gttp://ggg.maestro.ecosys/shacl/shape#DbpediaOrganisationRecordShape> ;
    mui:xsltTemplate <gttp://ggg.maestro.ecosys/shacl/template#DbpediaOrganisationRecordTemplate> .

<gttp://ggg.maestro.ecosys/shacl/policy/dbpedia-person> a mui:ClassPolicy ;
    rdfs:label "DBpedia Person policy"@en ;
    mui:forClass dbo:Person ;
    mui:recordShape <gttp://ggg.maestro.ecosys/shacl/shape#DbpediaPersonRecordShape> ;
    mui:xsltTemplate <gttp://ggg.maestro.ecosys/shacl/template#DbpediaPersonRecordTemplate> .

<gttp://ggg.maestro.ecosys/shacl/policy/dbpedia-place> a mui:ClassPolicy ;
    rdfs:label "DBpedia Place policy"@en ;
    mui:forClass dbo:Place ;
    mui:recordShape <gttp://ggg.maestro.ecosys/shacl/shape#DbpediaPlaceRecordShape> ;
    mui:xsltTemplate <gttp://ggg.maestro.ecosys/shacl/template#DbpediaPlaceRecordTemplate> .

<gttp://ggg.maestro.ecosys/shacl/policy/dbpedia-species> a mui:ClassPolicy ;
    rdfs:label "DBpedia Species policy"@en ;
    mui:forClass dbo:Species ;
    mui:recordShape <gttp://ggg.maestro.ecosys/shacl/shape#DbpediaSpeciesRecordShape> ;
    mui:xsltTemplate <gttp://ggg.maestro.ecosys/shacl/template#DbpediaSpeciesRecordTemplate> .

<gttp://ggg.maestro.ecosys/shacl/policy/dbpedia-work> a mui:ClassPolicy ;
    rdfs:label "DBpedia Work policy"@en ;
    mui:forClass dbo:Work ;
    mui:recordShape <gttp://ggg.maestro.ecosys/shacl/shape#DbpediaWorkRecordShape> ;
    mui:xsltTemplate <gttp://ggg.maestro.ecosys/shacl/template#DbpediaWorkRecordTemplate> .

<gttp://ggg.maestro.ecosys/shacl/template#DbpediaBookReviewQueryPivot> rdfs:label "Book review query pivot"@en ;
    rdf:value """<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:fct="http://openlinksw.com/services/facets/1.0/"
  xmlns:fctq="http://openlinksw.com/services/facets/1.0"
  xmlns:mctx="gttp://ggg.maestro.ecosys/ns/xslt/context#"
  version="3.0" exclude-result-prefixes="xs fct fctq mctx">
  <xsl:output method="xml" encoding="UTF-8" omit-xml-declaration="yes"/>
  <xsl:param name="recordUri" as="xs:string"/>
  <xsl:template match="/">
    <xsl:variable name="live" select="/mctx:context/mctx:live-query/fctq:query"/>
    <xsl:variable name="reviewPredicate" as="xs:string"
      select="string((/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[
        fct:column[1] = $recordUri and
        fct:column[2] = ('http://schema.org/review','https://schema.org/review',
          'http://schema.org/reviews','https://schema.org/reviews')
      ]/fct:column[2])[1])"/>
    <xsl:variable name="schemaNamespace" as="xs:string"
      select="if (starts-with($reviewPredicate, 'https:')) then 'https://schema.org/' else 'http://schema.org/'"/>
    <query xmlns="http://openlinksw.com/services/facets/1.0">
      <xsl:copy-of select="$live/@*"/>
      <value datatype="uri"><xsl:value-of select="$recordUri"/></value>
      <property iri="{$reviewPredicate}">
        <view type="list-values" limit="5" offset="0"/>
        <property iri="{$schemaNamespace}author" project="yes">
          <property iri="{$schemaNamespace}name" project="yes"/>
        </property>
        <property iri="{$schemaNamespace}reviewBody" project="yes"/>
        <property iri="{$schemaNamespace}reviewRating" project="yes">
          <property iri="{$schemaNamespace}ratingValue" project="yes"/>
          <property iri="{$schemaNamespace}bestRating" project="yes"/>
        </property>
      </property>
    </query>
  </xsl:template>
</xsl:stylesheet>""" .

<gttp://ggg.maestro.ecosys/shacl/shape#DbpediaBookRecordShape> a sh:NodeShape ;
    rdfs:label "DBpedia Book validator"@en ;
    sh:property [ sh:name "Author"@en ;
            sh:path [ sh:alternativePath ( dbo:author dbp:author schema1:author schemahttps:author schema1:creator schemahttps:creator ) ] ],
        [ sh:name "Language"@en ;
            sh:path [ sh:alternativePath ( dbo:language schema1:inLanguage schemahttps:inLanguage ) ] ],
        [ sh:name "Cover"@en ;
            sh:path [ sh:alternativePath ( dbo:thumbnail dbo:depiction schema1:image schemahttps:image schema1:thumbnailUrl schemahttps:thumbnailUrl ) ] ],
        [ sh:name "Pages"@en ;
            sh:path [ sh:alternativePath ( dbp:pages schema1:numberOfPages schemahttps:numberOfPages ) ] ],
        [ sh:name "Description"@en ;
            sh:nodeKind sh:Literal ;
            sh:path [ sh:alternativePath ( dbo:abstract schema1:description schemahttps:description rdfs:comment ) ] ],
        [ sh:name "ISBN"@en ;
            sh:nodeKind sh:Literal ;
            sh:path [ sh:alternativePath ( dbo:isbn dbp:isbn schema1:isbn schemahttps:isbn bibo:isbn bibo:isbn10 bibo:isbn13 ) ] ],
        [ sh:name "Publisher"@en ;
            sh:path [ sh:alternativePath ( dbo:publisher dbp:publisher schema1:publisher schemahttps:publisher ) ] ],
        [ sh:name "Publication date"@en ;
            sh:path [ sh:alternativePath ( dbo:publicationDate dbo:releaseDate dbp:published schema1:datePublished schemahttps:datePublished ) ] ],
        [ sh:minCount 1 ;
            sh:name "Title"@en ;
            sh:nodeKind sh:Literal ;
            sh:path [ sh:alternativePath ( rdfs:label schema1:name schemahttps:name schema1:headline schemahttps:headline dbo:title dbp:title ) ] ] ;
    sh:targetClass dbo:Book,
        schema1:Book,
        schemahttps:Book .

<gttp://ggg.maestro.ecosys/shacl/shape#DbpediaFilmRecordShape> a sh:NodeShape ;
    rdfs:label "DBpedia Film validator"@en ;
    sh:property [ sh:name "Release date"@en ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:releaseDate ],
        [ sh:name "IMDb identifier"@en ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:imdbId ],
        [ sh:name "IMDb ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:path dbp:imdbId ],
        [ sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "Label"@en ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:name "Genre"@en ;
            sh:path dbo:genre ],
        [ sh:name "Director"@en ;
            sh:path dbo:director ],
        [ sh:name "Synopsis"@en ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:abstract ] ;
    sh:targetClass dbo:Film .

<gttp://ggg.maestro.ecosys/shacl/shape#DbpediaOrganisationRecordShape> a sh:NodeShape ;
    rdfs:label "DBpedia Organisation validator"@en ;
    sh:property [ sh:name "DBpedia Organisation field" ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:foundingDate ],
        [ sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "Label" ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ] ;
    sh:targetClass dbo:Organisation .

<gttp://ggg.maestro.ecosys/shacl/shape#DbpediaPersonRecordShape> a sh:NodeShape ;
    rdfs:label "DBpedia Person validator"@en ;
    sh:property [ sh:name "Abstract"@en ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:abstract ],
        [ sh:minCount 1 ;
            sh:name "Subject categories"@en ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:subject ],
        [ sh:name "DBpedia Person field" ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:birthDate ],
        [ sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "Label" ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ] ;
    sh:targetClass dbo:Person .

<gttp://ggg.maestro.ecosys/shacl/shape#DbpediaPlaceRecordShape> a sh:NodeShape ;
    rdfs:label "DBpedia Place validator"@en ;
    sh:property [ sh:name "DBpedia Place field" ;
            sh:nodeKind sh:Literal ;
            sh:path geo1:lat ],
        [ sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "Label" ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ] ;
    sh:targetClass dbo:Place .

<gttp://ggg.maestro.ecosys/shacl/shape#DbpediaSpeciesRecordShape> a sh:NodeShape ;
    rdfs:label "DBpedia Species validator"@en ;
    sh:property [ sh:name "DBpedia Species field" ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:scientificName ],
        [ sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "Label" ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ] ;
    sh:targetClass dbo:Species .

<gttp://ggg.maestro.ecosys/shacl/shape#DbpediaWorkRecordShape> a sh:NodeShape ;
    rdfs:label "DBpedia Work validator"@en ;
    sh:property [ sh:name "DBpedia Work field" ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:releaseDate ],
        [ sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "Label" ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ] ;
    sh:targetClass dbo:Work .

<gttp://ggg.maestro.ecosys/shacl/template#DbpediaBookRecordTemplate> rdfs:label "Book literary card"@en ;
    rdf:value """<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:fct="http://openlinksw.com/services/facets/1.0/" xmlns:mctx="gttp://ggg.maestro.ecosys/ns/xslt/context#" xmlns:m="gttp://ggg.maestro.ecosys/ns/xslt/commerce#" version="3.0" exclude-result-prefixes="xs fct mctx m">
<xsl:output method="html" encoding="UTF-8" omit-xml-declaration="yes"/>
<xsl:param name="recordUri" as="xs:string" select="''"/>
<xsl:variable name="allRows" select="/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row"/>
<xsl:variable name="rows" select="$allRows[normalize-space(string(fct:column[1])) = $recordUri]"/>
<xsl:function name="m:values" as="xs:string*"><xsl:param name="names" as="xs:string*"/>
<xsl:sequence select="distinct-values($rows[lower-case(tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()]) = $names]/fct:column[3] ! normalize-space(string(.)))[. ne '']"/>
</xsl:function>
<xsl:function name="m:linked-values" as="xs:string*"><xsl:param name="subject" as="xs:string"/><xsl:param name="names" as="xs:string*"/>
<xsl:sequence select="distinct-values($allRows[normalize-space(string(fct:column[1])) = $subject and lower-case(tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()]) = $names]/fct:column[3] ! normalize-space(string(.)))[. ne '']"/>
</xsl:function>
<xsl:function name="m:first" as="xs:string"><xsl:param name="names" as="xs:string*"/><xsl:sequence select="string((m:values($names))[1])"/></xsl:function>
<xsl:function name="m:pretty" as="xs:string"><xsl:param name="uri" as="xs:string"/><xsl:sequence select="replace(tokenize($uri, '[/#]')[last()], '_', ' ')"/></xsl:function>
<xsl:function name="m:is-uri" as="xs:boolean"><xsl:param name="value" as="xs:string"/><xsl:sequence select="matches($value, '^https?://')"/></xsl:function>
<xsl:template name="m:field"><xsl:param name="key" as="xs:string"/><xsl:param name="names" as="xs:string*"/><xsl:param name="n" as="xs:string"/>
<xsl:variable name="values" select="m:values($names)"/>
<xsl:if test="exists($values)"><div id="field-{$n}" class="flex flex-col gap-1 border-b border-border/60 py-3 sm:grid sm:grid-cols-[7.5rem_1fr] sm:gap-4"><dt id="field-label-{$n}" class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground"><xsl:value-of select="$key"/></dt><dd id="field-data-{$n}" class="min-w-0 text-sm leading-relaxed text-foreground"><xsl:for-each select="$values"><xsl:choose><xsl:when test="m:is-uri(.)"><a id="field-link-{$n}-{position()}" class="text-primary underline-offset-4 hover:underline" data-maestro-record-uri="{.}" href="#"><xsl:value-of select="m:pretty(.)"/></a></xsl:when><xsl:otherwise><span id="field-text-{$n}-{position()}"><xsl:value-of select="."/></span></xsl:otherwise></xsl:choose><xsl:if test="position() ne last()"><span id="field-separator-{$n}-{position()}" class="text-muted-foreground"> · </span></xsl:if></xsl:for-each></dd></div></xsl:if>
</xsl:template>
<xsl:template name="m:extras"><xsl:param name="excluded" as="xs:string*"/>
<xsl:variable name="other" select="$rows[fct:column[2] and fct:column[3] and not(lower-case(tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()]) = $excluded)]"/>
<xsl:if test="exists($other)"><section id="record-additional-section" class="border-t border-border/70 px-6 py-5"><h3 id="record-additional-title" class="mb-3 text-xs font-semibold uppercase tracking-[.18em] text-muted-foreground">Additional details</h3><dl id="record-additional-list" class="divide-y divide-border/50"><xsl:for-each-group select="$other" group-by="normalize-space(string(fct:column[2]))"><xsl:variable name="idx" select="position()"/><xsl:variable name="prop" select="current-grouping-key()"/><div id="record-extra-{$idx}" class="grid gap-1 py-2 text-sm sm:grid-cols-[8rem_1fr]"><dt id="record-extra-label-{$idx}" class="text-xs font-medium text-muted-foreground" title="{$prop}"><xsl:value-of select="m:pretty($prop)"/></dt><dd id="record-extra-values-{$idx}" class="min-w-0 break-words"><xsl:for-each select="distinct-values(current-group()/fct:column[3] ! normalize-space(string(.)))[. ne '']"><xsl:choose><xsl:when test="m:is-uri(.)"><a id="record-extra-link-{$idx}-{position()}" data-maestro-record-uri="{.}" href="#" class="text-primary hover:underline"><xsl:value-of select="m:pretty(.)"/></a></xsl:when><xsl:otherwise><span id="record-extra-value-{$idx}-{position()}"><xsl:value-of select="."/></span></xsl:otherwise></xsl:choose><xsl:if test="position() ne last()"><span id="record-extra-sep-{$idx}-{position()}"> · </span></xsl:if></xsl:for-each></dd></div></xsl:for-each-group></dl></section></xsl:if>
</xsl:template>
<xsl:template match="/">
<xsl:variable name="title" select="(m:values(('label','title','name','headline'))[not(m:is-uri(.))], m:pretty($recordUri))[1]"/>
<xsl:variable name="author" select="m:values(('author','writer','creator'))"/>
<xsl:variable name="cover" select="(m:values(('thumbnail','thumbnailurl','depiction','cover','coverart','image'))[m:is-uri(.)])[1]"/>
<xsl:variable name="rawIsbn" select="m:values(('isbn','isbn10','isbn13'))"/>
<xsl:variable name="isbn" select="(for $v in $rawIsbn return replace(upper-case($v), '[^0-9X]', ''))[matches(., '^[0-9]{13}$|^[0-9]{9}[0-9X]$')][1]"/>
<xsl:variable name="lookup" select="if ($isbn) then $isbn else $title"/>
<section xmlns:mui="gttp://ggg.maestro.ecosys/ns/ui#" mui:framework="next@^16.4.0" id="maestro-record-viewer" class="mx-auto w-full max-w-4xl p-1">
<article id="record-card" class="overflow-hidden rounded-2xl border border-stone-300/60 bg-[#faf7f1] text-stone-900 shadow-lg dark:border-stone-700 dark:bg-[#211e1a] dark:text-stone-100">
<div id="book-topline" class="h-1.5 bg-[#53735a]"/>
<div id="book-hero" class="grid gap-7 px-6 pb-7 pt-8 sm:grid-cols-[minmax(0,11rem)_1fr] sm:px-9">
<div id="book-cover-frame" class="flex min-h-56 items-center justify-center overflow-hidden rounded-sm border border-[#b7a88d] bg-[#e3d5bd] shadow-[7px_9px_15px_rgba(0,0,0,.22)] dark:border-stone-700 dark:bg-stone-800">
<xsl:choose><xsl:when test="$cover"><img id="book-cover" alt="Book cover" src="{$cover}" class="max-h-72 w-full object-contain" loading="lazy" referrerpolicy="no-referrer"/></xsl:when><xsl:otherwise><div id="book-cover-placeholder" class="px-5 py-12 text-center"><p id="book-cover-mark" class="font-serif text-5xl text-[#546b56]">✦</p><p id="book-cover-text" class="mt-4 border-t border-stone-400/60 pt-4 font-serif text-lg font-semibold"><xsl:value-of select="$title"/></p></div></xsl:otherwise></xsl:choose>
</div>
<div id="book-intro" class="min-w-0 self-center">
<p id="book-eyebrow" class="text-[10px] font-semibold uppercase tracking-[.32em] text-[#53735a] dark:text-[#a5c5a8]">THE READING ROOM · DBPEDIA</p>
<h2 id="book-title" class="mt-4 break-words font-serif text-3xl font-semibold leading-tight tracking-tight sm:text-4xl"><xsl:value-of select="$title"/></h2>
<xsl:if test="exists($author)"><p id="book-author" class="mt-3 font-serif text-lg italic text-stone-600 dark:text-stone-300">by <xsl:for-each select="$author"><xsl:choose><xsl:when test="m:is-uri(.)"><a id="book-author-link-{position()}" href="#" data-maestro-record-uri="{.}" class="underline decoration-stone-400 underline-offset-4"><xsl:value-of select="m:pretty(.)"/></a></xsl:when><xsl:otherwise><span id="book-author-text-{position()}"><xsl:value-of select="."/></span></xsl:otherwise></xsl:choose><xsl:if test="position()!=last()"> · </xsl:if></xsl:for-each></p></xsl:if>
<xsl:variable name="summary" select="m:first(('abstract','description','comment'))"/>
<xsl:if test="$summary"><p id="book-summary" class="mt-5 max-w-prose text-sm leading-7 text-stone-600 dark:text-stone-300"><xsl:value-of select="$summary"/></p></xsl:if>
<xsl:if test="$isbn"><div id="book-isbn" class="mt-5 inline-flex rounded-md border border-stone-300 bg-white/60 px-3 py-2 text-xs font-medium tracking-wider dark:border-stone-600 dark:bg-stone-800">ISBN <xsl:value-of select="$isbn"/></div></xsl:if>
</div></div>
<div id="book-meta-wrap" class="border-y border-stone-300/70 bg-white/50 px-6 py-2 dark:border-stone-700 dark:bg-stone-900/40 sm:px-9"><dl id="book-meta" class="grid gap-x-6 sm:grid-cols-2">
<xsl:call-template name="m:field"><xsl:with-param name="key" select="'Publisher'"/><xsl:with-param name="names" select="('publisher')"/><xsl:with-param name="n" select="'publisher'"/></xsl:call-template>
<xsl:call-template name="m:field"><xsl:with-param name="key" select="'Published'"/><xsl:with-param name="names" select="('publicationdate','releasedate','datepublished','year')"/><xsl:with-param name="n" select="'date'"/></xsl:call-template>
<xsl:call-template name="m:field"><xsl:with-param name="key" select="'Genre'"/><xsl:with-param name="names" select="('literarygenre','genre')"/><xsl:with-param name="n" select="'genre'"/></xsl:call-template>
<xsl:call-template name="m:field"><xsl:with-param name="key" select="'Language'"/><xsl:with-param name="names" select="('language','originallanguage','inlanguage')"/><xsl:with-param name="n" select="'language'"/></xsl:call-template>
<xsl:call-template name="m:field"><xsl:with-param name="key" select="'Pages'"/><xsl:with-param name="names" select="('numberofpages','pages')"/><xsl:with-param name="n" select="'pages'"/></xsl:call-template>
</dl></div>
<xsl:variable name="reviewEntries" select="m:values(('review','reviews','hasreview','bookreview','criticsreview','userreview','reviewbody','reviewtext'))"/>
<xsl:variable name="ratingValues" select="m:values(('ratingvalue','averagerating','rating','score'))"/>
<xsl:variable name="aggregateRatings" select="m:values(('aggregaterating'))"/>
<xsl:variable name="ratingCount" select="m:first(('ratingcount'))"/>
<xsl:variable name="reviewCount" select="m:first(('reviewcount','numberofreviews'))"/>
<xsl:variable name="bestRating" select="m:first(('bestrating'))"/>
<xsl:if test="exists($reviewEntries) or exists($ratingValues) or exists($aggregateRatings) or $ratingCount ne '' or $reviewCount ne ''">
<section id="book-reviews-ratings" class="border-t border-[#c5b59d]/60 bg-[#f1ece3] px-6 py-7 dark:border-stone-700 dark:bg-[#29251f] sm:px-9">
<div id="book-reviews-heading" class="mb-5 flex items-center gap-3"><span id="book-reviews-star" aria-hidden="true" class="text-2xl text-[#a07835]">★</span><div id="book-reviews-heading-text"><p id="book-reviews-eyebrow" class="text-[10px] font-semibold uppercase tracking-[.25em] text-[#53735a] dark:text-[#a5c5a8]">Readers &amp; critics</p><h3 id="book-reviews-title" class="font-serif text-2xl font-semibold">Reviews &amp; ratings</h3></div></div>
<xsl:if test="exists($ratingValues) or exists($aggregateRatings) or $ratingCount ne '' or $reviewCount ne ''">
<div id="book-rating-summary" class="mb-5 flex flex-wrap gap-3">
<xsl:for-each select="$ratingValues">
<xsl:variable name="rawValue" select="normalize-space(.)"/>
<xsl:variable name="numericRating" select="if ($rawValue castable as xs:decimal) then xs:decimal($rawValue) else ()"/>
<xsl:variable name="numericBest" select="if ($bestRating castable as xs:decimal and xs:decimal($bestRating) gt 0) then xs:decimal($bestRating) else if (exists($numericRating) and $numericRating gt 5) then ceiling($numericRating) else 5"/>
<xsl:variable name="starSlots" as="xs:integer" select="xs:integer(ceiling($numericBest))"/>
<xsl:variable name="stars" select="if (exists($numericRating)) then max((0, min(($numericBest, floor($numericRating * 2 + 0.5) div 2)))) else ()"/>
<div id="book-rating-{position()}" class="rounded-lg border border-[#d1c1a7] bg-white/70 px-4 py-3 dark:border-stone-600 dark:bg-stone-800">
<div id="book-rating-label-{position()}" class="text-[10px] font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400">Rating</div>
<xsl:choose>
<xsl:when test="exists($stars)">
<div id="book-rating-stars-{position()}" class="mt-2 flex items-center gap-0.5" role="img" aria-label="{concat($rawValue, ' out of ', $numericBest, ', shown as ', $stars, ' out of ', $starSlots, ' stars')}">
<xsl:variable name="ratingIndex" select="position()"/>
<xsl:for-each select="1 to $starSlots">
<xsl:variable name="starIndex" select="."/>
<xsl:variable name="goldWidth" select="if ($stars ge $starIndex) then 24 else if ($stars ge $starIndex - 0.5) then 12 else 0"/>
<svg xmlns="http://www.w3.org/2000/svg" id="book-rating-star-{$ratingIndex}-{$starIndex}" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" class="shrink-0">
<defs id="book-rating-defs-{$ratingIndex}-{$starIndex}"><clipPath id="book-rating-star-clip-{$ratingIndex}-{$starIndex}"><rect id="book-rating-star-cliprect-{$ratingIndex}-{$starIndex}" x="0" y="0" width="{$goldWidth}" height="24"/></clipPath></defs>
<path id="book-rating-star-muted-{$ratingIndex}-{$starIndex}" d="m12 2 3.09 6.26 6.91 1-5 4.87 1.18 6.89L12 17.77l-6.18 3.25L7 14.13l-5-4.87 6.91-1L12 2Z" fill="currentColor" class="text-stone-300 dark:text-stone-600"/>
<path id="book-rating-star-gold-{$ratingIndex}-{$starIndex}" d="m12 2 3.09 6.26 6.91 1-5 4.87 1.18 6.89L12 17.77l-6.18 3.25L7 14.13l-5-4.87 6.91-1L12 2Z" fill="#eab308" clip-path="url(#book-rating-star-clip-{$ratingIndex}-{$starIndex})"/>
</svg>
</xsl:for-each>
</div>
</xsl:when>
<xsl:when test="m:is-uri($rawValue)"><a id="book-rating-link-{position()}" href="#" data-maestro-record-uri="{$rawValue}" class="mt-1 block text-primary hover:underline"><xsl:value-of select="m:pretty($rawValue)"/></a></xsl:when>
<xsl:otherwise><span id="book-rating-text-{position()}" class="mt-1 block text-sm"><xsl:value-of select="$rawValue"/></span></xsl:otherwise>
</xsl:choose>
</div>
</xsl:for-each>
<xsl:for-each select="$aggregateRatings">
<div id="book-aggregate-{position()}" class="rounded-lg border border-[#d1c1a7] bg-white/70 px-4 py-3 dark:border-stone-600 dark:bg-stone-800">
<div id="book-aggregate-title-{position()}" class="text-[10px] font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400">Aggregate rating</div>
<div id="book-aggregate-value-{position()}" class="mt-1 font-serif text-base font-semibold"><xsl:choose><xsl:when test="m:is-uri(.)"><a id="book-aggregate-link-{position()}" href="#" data-maestro-record-uri="{.}" class="text-primary hover:underline"><xsl:value-of select="m:pretty(.)"/></a></xsl:when><xsl:otherwise><span id="book-aggregate-text-{position()}"><xsl:value-of select="."/></span></xsl:otherwise></xsl:choose></div>
</div>
</xsl:for-each>
<xsl:if test="$ratingCount ne ''"><div id="book-rating-count" class="rounded-lg border border-[#d1c1a7] bg-white/70 px-4 py-3 dark:border-stone-600 dark:bg-stone-800"><div id="book-rating-count-label" class="text-[10px] font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400">Ratings</div><div id="book-rating-count-value" class="mt-1 font-serif text-xl font-semibold"><xsl:value-of select="$ratingCount"/></div></div></xsl:if>
<xsl:if test="$reviewCount ne ''"><div id="book-review-count" class="rounded-lg border border-[#d1c1a7] bg-white/70 px-4 py-3 dark:border-stone-600 dark:bg-stone-800"><div id="book-review-count-label" class="text-[10px] font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400">Reviews</div><div id="book-review-count-value" class="mt-1 font-serif text-xl font-semibold"><xsl:value-of select="$reviewCount"/></div></div></xsl:if>
</div></xsl:if>
<xsl:if test="exists($reviewEntries)">
<div id="book-review-table-scroll" class="overflow-x-auto rounded-xl border border-[#d1c1a7] bg-white/75 dark:border-stone-600 dark:bg-stone-800/80">
<table id="book-review-table" class="w-full min-w-[35rem] border-collapse text-left text-sm">
<thead id="book-review-table-head" class="bg-[#e8dfd1] text-xs uppercase tracking-wider text-stone-600 dark:bg-stone-700 dark:text-stone-200"><tr id="book-review-head-row"><th id="book-review-head-author" class="px-4 py-3">Reviewer</th><th id="book-review-head-stars" class="px-4 py-3">Rating</th><th id="book-review-head-body" class="px-4 py-3">Review</th></tr></thead>
<tbody id="book-review-table-body" class="divide-y divide-[#d1c1a7] dark:divide-stone-700">
<xsl:for-each select="$reviewEntries">
<xsl:variable name="index" select="position()"/>
<xsl:variable name="reviewUri" select="."/>
<xsl:variable name="authors" select="if (m:is-uri($reviewUri)) then m:linked-values($reviewUri, ('author')) else ()"/>
<xsl:variable name="ratingUris" select="if (m:is-uri($reviewUri)) then m:linked-values($reviewUri, ('reviewrating')) else ()"/>
<xsl:variable name="ratingValue" select="string((for $r in $ratingUris return m:linked-values($r, ('ratingvalue')), m:linked-values($reviewUri, ('ratingvalue')))[1])"/>
<xsl:variable name="bestValue" select="string((for $r in $ratingUris return m:linked-values($r, ('bestrating')), m:linked-values($reviewUri, ('bestrating')))[1])"/>
<xsl:variable name="body" select="string((m:linked-values($reviewUri, ('reviewbody','description')), if (not(m:is-uri($reviewUri))) then $reviewUri else ())[1])"/>
<xsl:variable name="score" select="if ($ratingValue castable as xs:decimal) then max((0, xs:decimal($ratingValue))) else 0"/>
<xsl:variable name="maximum" select="if ($bestValue castable as xs:decimal and xs:decimal($bestValue) gt 0) then xs:decimal($bestValue) else if ($score gt 5) then xs:decimal(ceiling($score)) else xs:decimal(5)"/>
<xsl:variable name="slots" select="xs:integer(min((20, ceiling($maximum))))"/>
<xsl:variable name="filled" select="min(($slots, floor(($score div $maximum) * $slots * 2 + 0.5) div 2))"/>
<tr id="book-review-row-{$index}" class="align-top">
<td id="book-review-author-{$index}" class="px-4 py-4 font-medium">
<xsl:choose><xsl:when test="exists($authors)"><xsl:for-each select="$authors"><xsl:variable name="name" select="string((m:linked-values(., ('name','label')), m:pretty(.))[1])"/><xsl:choose><xsl:when test="m:is-uri(.)"><a id="book-review-author-link-{$index}-{position()}" data-maestro-record-uri="{.}" href="#" class="text-primary hover:underline"><xsl:value-of select="$name"/></a></xsl:when><xsl:otherwise><span id="book-review-author-name-{$index}-{position()}"><xsl:value-of select="."/></span></xsl:otherwise></xsl:choose></xsl:for-each></xsl:when><xsl:otherwise><a id="book-review-source-{$index}" href="#" data-maestro-record-uri="{$reviewUri}" class="text-primary hover:underline">Review source</a></xsl:otherwise></xsl:choose>
</td>
<td id="book-review-stars-cell-{$index}" class="px-4 py-4">
<xsl:choose><xsl:when test="$ratingValue castable as xs:decimal"><div id="book-review-stars-{$index}" class="flex items-center gap-0.5" role="img" aria-label="{concat($ratingValue, ' of ', $maximum)}">
<xsl:for-each select="1 to $slots"><xsl:variable name="star" select="."/><xsl:variable name="width" select="if ($filled ge $star) then 24 else if ($filled ge $star - 0.5) then 12 else 0"/>
<svg xmlns="http://www.w3.org/2000/svg" id="book-review-star-{$index}-{$star}" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><defs id="book-review-defs-{$index}-{$star}"><clipPath id="book-review-star-clip-{$index}-{$star}"><rect id="book-review-star-clip-rect-{$index}-{$star}" x="0" y="0" width="{$width}" height="24"/></clipPath></defs><path id="book-review-star-muted-{$index}-{$star}" d="m12 2 3.09 6.26 6.91 1-5 4.87 1.18 6.89L12 17.77l-6.18 3.25L7 14.13l-5-4.87 6.91-1L12 2Z" fill="#a8a29e"/><path id="book-review-star-gold-{$index}-{$star}" d="m12 2 3.09 6.26 6.91 1-5 4.87 1.18 6.89L12 17.77l-6.18 3.25L7 14.13l-5-4.87 6.91-1L12 2Z" fill="#eab308" clip-path="url(#book-review-star-clip-{$index}-{$star})"/></svg>
</xsl:for-each></div></xsl:when><xsl:otherwise><span id="book-review-no-rating-{$index}" class="text-stone-500">Not rated</span></xsl:otherwise></xsl:choose>
</td>
<td id="book-review-body-{$index}" class="max-w-lg whitespace-pre-line break-words px-4 py-4 leading-6"><xsl:choose><xsl:when test="$body ne ''"><xsl:value-of select="$body"/></xsl:when><xsl:otherwise><a id="book-review-body-link-{$index}" href="#" data-maestro-record-uri="{$reviewUri}" class="text-primary hover:underline">Open review</a></xsl:otherwise></xsl:choose></td>
</tr>
</xsl:for-each>
</tbody></table></div>
</xsl:if>
</section></xsl:if>
<section id="book-links" class="px-6 py-6 sm:px-9"><h3 id="book-links-title" class="mb-1 font-serif text-xl font-semibold">Find this book</h3><p id="book-links-note" class="mb-4 text-xs text-stone-500 dark:text-stone-400"><xsl:choose><xsl:when test="$isbn">Search by ISBN · seller listings are not verified</xsl:when><xsl:otherwise>Search by title · ISBN not found in this record</xsl:otherwise></xsl:choose></p>
<div id="book-shop-grid" class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
<a id="book-amazon" href="{concat('https://www.amazon.com/s?k=', encode-for-uri($lookup))}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-lg border border-[#c5b59d] bg-white px-4 py-3 text-sm font-semibold shadow-sm transition hover:border-[#53735a] hover:shadow-md dark:border-stone-600 dark:bg-stone-800">Amazon <span id="book-amazon-arrow">↗</span></a>
<a id="book-barnes" href="{concat('https://www.barnesandnoble.com/s/', encode-for-uri($lookup))}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-lg border border-[#c5b59d] bg-white px-4 py-3 text-sm font-semibold shadow-sm transition hover:border-[#53735a] hover:shadow-md dark:border-stone-600 dark:bg-stone-800">Barnes &amp; Noble <span id="book-barnes-arrow">↗</span></a>
<a id="book-google" href="{concat('https://books.google.com/books?q=', encode-for-uri($lookup))}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-lg border border-[#c5b59d] bg-white px-4 py-3 text-sm font-semibold shadow-sm transition hover:border-[#53735a] hover:shadow-md dark:border-stone-600 dark:bg-stone-800">Google Books <span id="book-google-arrow">↗</span></a>
<a id="book-openlibrary" href="{if ($isbn) then concat('https://openlibrary.org/isbn/', encode-for-uri($isbn)) else concat('https://openlibrary.org/search?q=', encode-for-uri($title))}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-lg border border-[#c5b59d] bg-white px-4 py-3 text-sm font-semibold shadow-sm transition hover:border-[#53735a] hover:shadow-md dark:border-stone-600 dark:bg-stone-800">Open Library <span id="book-openlibrary-arrow">↗</span></a>
<a id="book-goodreads" href="{concat('https://www.goodreads.com/search?q=', encode-for-uri($lookup))}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-lg border border-[#c5b59d] bg-white px-4 py-3 text-sm font-semibold shadow-sm transition hover:border-[#53735a] hover:shadow-md dark:border-stone-600 dark:bg-stone-800">Goodreads <span id="book-goodreads-arrow">↗</span></a>
<a id="book-bookshop" href="{concat('https://bookshop.org/search?keywords=', encode-for-uri($lookup))}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-lg border border-[#c5b59d] bg-white px-4 py-3 text-sm font-semibold shadow-sm transition hover:border-[#53735a] hover:shadow-md dark:border-stone-600 dark:bg-stone-800">Bookshop.org <span id="book-bookshop-arrow">↗</span></a>
</div></section>
<xsl:call-template name="m:extras"><xsl:with-param name="excluded" select="('type','label','title','name','abstract','description','comment','author','writer','creator','thumbnail','thumbnailurl','depiction','cover','coverart','image','isbn','isbn10','isbn13','publisher','publicationdate','releasedate','datepublished','year','literarygenre','genre','language','originallanguage','inlanguage','numberofpages','pages','review','reviews','hasreview','bookreview','criticsreview','userreview','reviewbody','reviewtext','ratingvalue','averagerating','rating','score','aggregaterating','ratingcount','reviewcount','numberofreviews','bestrating')"/></xsl:call-template>
<footer id="book-footer" class="px-6 pb-5 pt-2 text-center text-[10px] uppercase tracking-[.22em] text-stone-500 dark:text-stone-400">Book metadata · DBpedia · Maestro</footer>
</article><svg:svg xmlns:svg="http://www.w3.org/2000/svg" id="dbpedia-book-record-heading-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" mui:parent="record_title_icon"><svg:path id="dbpedia-book-record-icon-1" d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><svg:path id="dbpedia-book-record-icon-2" d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg:svg></section></xsl:template></xsl:stylesheet>""" .

<gttp://ggg.maestro.ecosys/shacl/template#DbpediaFilmRecordTemplate> rdfs:label "Film cinematic card"@en ;
    rdf:value """<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:fct="http://openlinksw.com/services/facets/1.0/" xmlns:mctx="gttp://ggg.maestro.ecosys/ns/xslt/context#" xmlns:m="gttp://ggg.maestro.ecosys/ns/xslt/commerce#" version="3.0" exclude-result-prefixes="xs fct mctx m">
<xsl:output method="html" encoding="UTF-8" omit-xml-declaration="yes"/>
<xsl:param name="recordUri" as="xs:string" select="''"/>
<xsl:variable name="rows" select="/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row"/>
<xsl:function name="m:values" as="xs:string*"><xsl:param name="names" as="xs:string*"/>
<xsl:sequence select="distinct-values($rows[lower-case(tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()]) = $names]/fct:column[3] ! normalize-space(string(.)))[. ne '']"/>
</xsl:function>
<xsl:function name="m:first" as="xs:string"><xsl:param name="names" as="xs:string*"/><xsl:sequence select="string((m:values($names))[1])"/></xsl:function>
<xsl:function name="m:pretty" as="xs:string"><xsl:param name="uri" as="xs:string"/><xsl:sequence select="replace(tokenize($uri, '[/#]')[last()], '_', ' ')"/></xsl:function>
<xsl:function name="m:is-uri" as="xs:boolean"><xsl:param name="value" as="xs:string"/><xsl:sequence select="matches($value, '^https?://')"/></xsl:function>
<xsl:template name="m:field"><xsl:param name="key" as="xs:string"/><xsl:param name="names" as="xs:string*"/><xsl:param name="n" as="xs:string"/>
<xsl:variable name="values" select="m:values($names)"/>
<xsl:if test="exists($values)"><div id="field-{$n}" class="flex flex-col gap-1 border-b border-border/60 py-3 sm:grid sm:grid-cols-[7.5rem_1fr] sm:gap-4"><dt id="field-label-{$n}" class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground"><xsl:value-of select="$key"/></dt><dd id="field-data-{$n}" class="min-w-0 text-sm leading-relaxed text-foreground"><xsl:for-each select="$values"><xsl:choose><xsl:when test="m:is-uri(.)"><a id="field-link-{$n}-{position()}" class="text-primary underline-offset-4 hover:underline" data-maestro-record-uri="{.}" href="#"><xsl:value-of select="m:pretty(.)"/></a></xsl:when><xsl:otherwise><span id="field-text-{$n}-{position()}"><xsl:value-of select="."/></span></xsl:otherwise></xsl:choose><xsl:if test="position() ne last()"><span id="field-separator-{$n}-{position()}" class="text-muted-foreground"> · </span></xsl:if></xsl:for-each></dd></div></xsl:if>
</xsl:template>
<xsl:template name="m:extras"><xsl:param name="excluded" as="xs:string*"/>
<xsl:variable name="other" select="$rows[fct:column[2] and fct:column[3] and not(lower-case(tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()]) = $excluded)]"/>
<xsl:if test="exists($other)"><section id="record-additional-section" class="border-t border-border/70 px-6 py-5"><h3 id="record-additional-title" class="mb-3 text-xs font-semibold uppercase tracking-[.18em] text-muted-foreground">Additional details</h3><dl id="record-additional-list" class="divide-y divide-border/50"><xsl:for-each-group select="$other" group-by="normalize-space(string(fct:column[2]))"><xsl:variable name="idx" select="position()"/><xsl:variable name="prop" select="current-grouping-key()"/><div id="record-extra-{$idx}" class="grid gap-1 py-2 text-sm sm:grid-cols-[8rem_1fr]"><dt id="record-extra-label-{$idx}" class="text-xs font-medium text-muted-foreground" title="{$prop}"><xsl:value-of select="m:pretty($prop)"/></dt><dd id="record-extra-values-{$idx}" class="min-w-0 break-words"><xsl:for-each select="distinct-values(current-group()/fct:column[3] ! normalize-space(string(.)))[. ne '']"><xsl:choose><xsl:when test="m:is-uri(.)"><a id="record-extra-link-{$idx}-{position()}" data-maestro-record-uri="{.}" href="#" class="text-primary hover:underline"><xsl:value-of select="m:pretty(.)"/></a></xsl:when><xsl:otherwise><span id="record-extra-value-{$idx}-{position()}"><xsl:value-of select="."/></span></xsl:otherwise></xsl:choose><xsl:if test="position() ne last()"><span id="record-extra-sep-{$idx}-{position()}"> · </span></xsl:if></xsl:for-each></dd></div></xsl:for-each-group></dl></section></xsl:if>
</xsl:template>
<xsl:template match="/">
<xsl:variable name="title" select="(m:values(('label','title','name'))[not(m:is-uri(.))], m:pretty($recordUri))[1]"/>
<xsl:variable name="summary" select="m:first(('abstract','description','plot','synopsis'))"/>
<xsl:variable name="poster" select="(m:values(('thumbnail','depiction','poster','image','cover'))[m:is-uri(.)])[1]"/>
<xsl:variable name="date" select="m:first(('releasedate','publicationdate','datepublished','year'))"/>
<xsl:variable name="imdbRaw" select="m:values(('imdbid','imdb'))"/>
<xsl:variable name="imdb" select="(for $v in $imdbRaw return if (matches($v, 'tt[0-9]+')) then replace($v, '^.*?(tt[0-9]+).*$', '$1') else '')[. ne ''][1]"/>
<xsl:variable name="lookup" select="concat($title, ' film ', substring($date,1,4))"/>
<section xmlns:mui="gttp://ggg.maestro.ecosys/ns/ui#" mui:framework="next@^16.4.0" id="maestro-record-viewer" class="mx-auto w-full max-w-5xl p-1">
<article id="record-card" class="overflow-hidden rounded-2xl border border-slate-700 bg-[#0b101b] text-white shadow-2xl">
<div id="film-hero" class="relative overflow-hidden bg-gradient-to-br from-[#273b55] via-[#101725] to-[#080b12] px-6 py-8 sm:px-9 sm:py-11">
<div id="film-hero-grid" class="relative grid gap-7 sm:grid-cols-[minmax(0,1fr)_minmax(0,12rem)] sm:items-center">
<div id="film-copy" class="min-w-0"><p id="film-eyebrow" class="mb-3 text-[10px] font-semibold uppercase tracking-[.35em] text-sky-200">MAESTRO PREMIERE · DBPEDIA FILM</p>
<h2 id="film-title" class="max-w-2xl break-words text-3xl font-bold tracking-tight sm:text-5xl"><xsl:value-of select="$title"/></h2>
<div id="film-highlights" class="mt-4 flex flex-wrap items-center gap-2 text-xs font-medium text-slate-300">
<xsl:if test="$date"><span id="film-year" class="rounded-full border border-white/20 bg-white/10 px-3 py-1"><xsl:value-of select="substring($date,1,4)"/></span></xsl:if>
<xsl:for-each select="m:values(('genre'))[position() le 2]"><span id="film-genre-chip-{position()}" class="rounded-full border border-white/20 bg-white/10 px-3 py-1"><xsl:value-of select="if (m:is-uri(.)) then m:pretty(.) else ."/></span></xsl:for-each>
<xsl:variable name="runtime" select="m:first(('runtime','duration'))"/><xsl:if test="$runtime"><span id="film-runtime" class="rounded-full border border-white/20 bg-white/10 px-3 py-1"><xsl:value-of select="$runtime"/></span></xsl:if>
</div>
<xsl:if test="$summary"><p id="film-synopsis" class="mt-6 max-w-2xl text-sm leading-7 text-slate-200 sm:text-base"><xsl:value-of select="$summary"/></p></xsl:if>
<div id="film-action-row" class="mt-7 flex flex-wrap gap-3">
<a id="film-google-search" href="{concat('https://www.google.com/search?q=', encode-for-uri($lookup))}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full bg-white px-5 py-3 text-xs font-semibold text-slate-950 shadow-md transition hover:bg-sky-100">Search Google ↗</a>
<a id="film-imdb" href="{if ($imdb) then concat('https://www.imdb.com/title/', $imdb, '/') else concat('https://www.imdb.com/find/?q=', encode-for-uri($lookup), '&amp;s=tt')}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-5 py-3 text-xs font-semibold text-white hover:bg-white/20">IMDb <xsl:choose><xsl:when test="$imdb">↗</xsl:when><xsl:otherwise>search ↗</xsl:otherwise></xsl:choose></a>
</div></div>
<div id="film-poster-frame" class="mx-auto flex aspect-[2/3] w-full max-w-48 items-center justify-center overflow-hidden rounded-xl border border-white/20 bg-slate-800 shadow-[0_14px_35px_rgba(0,0,0,.6)]">
<xsl:choose><xsl:when test="$poster"><img id="film-poster" src="{$poster}" alt="Film artwork" class="h-full w-full object-cover" loading="lazy" referrerpolicy="no-referrer"/></xsl:when><xsl:otherwise><span id="film-poster-placeholder" class="px-4 text-center text-xl font-semibold tracking-wide text-slate-400">MAESTRO CINEMA</span></xsl:otherwise></xsl:choose>
</div></div></div>
<section id="film-availability" class="border-t border-white/10 bg-[#0f1623] px-6 py-7 sm:px-9"><div id="film-availability-head" class="mb-5 flex flex-wrap items-end justify-between gap-3"><h3 id="film-availability-title" class="text-lg font-bold tracking-tight">Find where to watch</h3><p id="film-availability-note" class="text-xs text-slate-400">Search links only · availability not verified</p></div>
<div id="film-service-grid" class="grid grid-cols-2 gap-3 sm:grid-cols-3">
<a id="film-service-netflix" href="{concat('https://www.netflix.com/search?q=', encode-for-uri($title))}" target="_blank" rel="noopener noreferrer" class="flex min-h-16 items-center gap-3 rounded-xl border border-white/15 bg-white/5 px-3 py-3 text-left transition hover:border-sky-300/60 hover:bg-white/15"><span id="film-service-netflix-logo-frame" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white p-1.5"><img id="film-service-netflix-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/netflix.svg" alt="Netflix logo" class="h-full w-full object-contain" loading="lazy"/></span><span id="film-service-netflix-label" class="min-w-0 text-xs font-semibold text-slate-100">Netflix</span></a>
<a id="film-service-primevideo" href="{concat('https://www.amazon.com/s?i=instant-video&amp;k=', encode-for-uri($title))}" target="_blank" rel="noopener noreferrer" class="flex min-h-16 items-center gap-3 rounded-xl border border-white/15 bg-white/5 px-3 py-3 text-left transition hover:border-sky-300/60 hover:bg-white/15"><span id="film-service-primevideo-logo-frame" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white p-1.5"><img id="film-service-primevideo-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/primevideo.svg" alt="Prime Video logo" class="h-full w-full object-contain" loading="lazy"/></span><span id="film-service-primevideo-label" class="min-w-0 text-xs font-semibold text-slate-100">Prime Video</span></a>
<a id="film-service-disneyplus" href="{concat('https://www.disneyplus.com/search/', encode-for-uri($title))}" target="_blank" rel="noopener noreferrer" class="flex min-h-16 items-center gap-3 rounded-xl border border-white/15 bg-white/5 px-3 py-3 text-left transition hover:border-sky-300/60 hover:bg-white/15"><span id="film-service-disneyplus-logo-frame" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white p-1.5"><img id="film-service-disneyplus-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/disneyplus.svg" alt="Disney+ logo" class="h-full w-full object-contain" loading="lazy"/></span><span id="film-service-disneyplus-label" class="min-w-0 text-xs font-semibold text-slate-100">Disney+</span></a>
<a id="film-service-appletv" href="{concat('https://tv.apple.com/search?term=', encode-for-uri($title))}" target="_blank" rel="noopener noreferrer" class="flex min-h-16 items-center gap-3 rounded-xl border border-white/15 bg-white/5 px-3 py-3 text-left transition hover:border-sky-300/60 hover:bg-white/15"><span id="film-service-appletv-logo-frame" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white p-1.5"><img id="film-service-appletv-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/appletv.svg" alt="Apple TV logo" class="h-full w-full object-contain" loading="lazy"/></span><span id="film-service-appletv-label" class="min-w-0 text-xs font-semibold text-slate-100">Apple TV</span></a>
<a id="film-service-hulu" href="{concat('https://www.hulu.com/search?q=', encode-for-uri($title))}" target="_blank" rel="noopener noreferrer" class="flex min-h-16 items-center gap-3 rounded-xl border border-white/15 bg-white/5 px-3 py-3 text-left transition hover:border-sky-300/60 hover:bg-white/15"><span id="film-service-hulu-logo-frame" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white p-1.5"><img id="film-service-hulu-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/hulu.svg" alt="Hulu logo" class="h-full w-full object-contain" loading="lazy"/></span><span id="film-service-hulu-label" class="min-w-0 text-xs font-semibold text-slate-100">Hulu</span></a>
<a id="film-service-youtube" href="{concat('https://www.youtube.com/results?search_query=', encode-for-uri($title))}" target="_blank" rel="noopener noreferrer" class="flex min-h-16 items-center gap-3 rounded-xl border border-white/15 bg-white/5 px-3 py-3 text-left transition hover:border-sky-300/60 hover:bg-white/15"><span id="film-service-youtube-logo-frame" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white p-1.5"><img id="film-service-youtube-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/youtube.svg" alt="YouTube logo" class="h-full w-full object-contain" loading="lazy"/></span><span id="film-service-youtube-label" class="min-w-0 text-xs font-semibold text-slate-100">YouTube</span></a>
</div></section>
<section id="film-details" class="border-t border-white/10 bg-[#111827] px-6 py-6 sm:px-9"><h3 id="film-details-heading" class="mb-2 text-xs font-semibold uppercase tracking-[.2em] text-sky-200">Behind the scenes</h3><dl id="film-details-list" class="grid gap-x-6 sm:grid-cols-2">
<xsl:call-template name="m:field"><xsl:with-param name="key" select="'Director'"/><xsl:with-param name="names" select="('director')"/><xsl:with-param name="n" select="'director'"/></xsl:call-template>
<xsl:call-template name="m:field"><xsl:with-param name="key" select="'Cast'"/><xsl:with-param name="names" select="('starring','actor')"/><xsl:with-param name="n" select="'cast'"/></xsl:call-template>
<xsl:call-template name="m:field"><xsl:with-param name="key" select="'Country'"/><xsl:with-param name="names" select="('country')"/><xsl:with-param name="n" select="'country'"/></xsl:call-template>
<xsl:call-template name="m:field"><xsl:with-param name="key" select="'Language'"/><xsl:with-param name="names" select="('language')"/><xsl:with-param name="n" select="'language'"/></xsl:call-template>
<xsl:call-template name="m:field"><xsl:with-param name="key" select="'Production'"/><xsl:with-param name="names" select="('producer','productioncompany','distributor')"/><xsl:with-param name="n" select="'production'"/></xsl:call-template>
</dl></section>
<xsl:call-template name="m:extras"><xsl:with-param name="excluded" select="('type','label','title','name','abstract','description','plot','synopsis','thumbnail','depiction','poster','image','cover','releasedate','publicationdate','datepublished','year','genre','runtime','duration','imdbid','imdb','director','starring','actor','country','language','producer','productioncompany','distributor')"/></xsl:call-template>
<footer id="film-footer" class="border-t border-white/10 px-6 py-4 text-center text-[10px] uppercase tracking-[.25em] text-slate-400">Film metadata · DBpedia · Maestro</footer>
</article><svg:svg xmlns:svg="http://www.w3.org/2000/svg" id="dbpedia-film-record-heading-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" mui:parent="record_title_icon"><svg:rect id="dbpedia-film-record-icon-1" x="2" y="2" width="20" height="20" rx="2.18"/><svg:path id="dbpedia-film-record-icon-2" d="M7 2v20M17 2v20M2 12h20M2 7h5M2 17h5M17 7h5M17 17h5"/></svg:svg></section></xsl:template></xsl:stylesheet>""" .

<gttp://ggg.maestro.ecosys/shacl/template#DbpediaOrganisationRecordTemplate> rdfs:label "Organisation profile card"@en ;
    rdf:value """<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:fct="http://openlinksw.com/services/facets/1.0/" xmlns:mctx="gttp://ggg.maestro.ecosys/ns/xslt/context#" xmlns:m="gttp://ggg.maestro.ecosys/ns/xslt/dbpedia#" version="3.0" exclude-result-prefixes="xs fct mctx m">
<xsl:output method="html" encoding="UTF-8" omit-xml-declaration="yes"/><xsl:param name="recordUri"/>
<xsl:function name="m:values" as="xs:string">
<xsl:param name="ctx" as="node()"/><xsl:param name="predicate" as="xs:string"/>
<xsl:variable name="localName" select="tokenize($predicate, '[/#]')[last()]"/>
<xsl:variable name="rows" select="$ctx/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[2] = $predicate or tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()] = $localName]"/>
<xsl:sequence select="string-join(distinct-values($rows/fct:column[3] ! normalize-space(string(.)))[. != ''], ', ')"/>
</xsl:function>
<xsl:template match="/"><section xmlns:mui="gttp://ggg.maestro.ecosys/ns/ui#" mui:framework="next@^16.4.0" id="maestro-record-viewer" class="mx-auto w-full max-w-2xl p-1"><article id="record-card" class="rounded-xl border bg-card text-card-foreground shadow-sm"><header id="record-header" class="border-b bg-muted/40 px-5 py-4"><p id="record-category" class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">DBpedia · Organisation</p><h2 id="record-title" class="mt-1 break-words text-xl font-semibold"><xsl:choose><xsl:when test="m:values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label') != ''"><xsl:value-of select="m:values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label')"/></xsl:when><xsl:otherwise><xsl:value-of select="$recordUri"/></xsl:otherwise></xsl:choose></h2></header><dl id="record-fields" class="px-5 py-2">      <xsl:variable name="v0" select="m:values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label')"/>
      <xsl:if test="$v0 != ''"><div id="record-row-0" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"><dt id="record-key-0" class="text-xs font-medium text-muted-foreground">Name</dt><dd id="record-value-0" class="break-words text-sm"><xsl:value-of select="$v0"/></dd></div></xsl:if>      <xsl:variable name="v1" select="m:values(root(.), 'http://dbpedia.org/ontology/foundingDate')"/>
      <xsl:if test="$v1 != ''"><div id="record-row-1" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"><dt id="record-key-1" class="text-xs font-medium text-muted-foreground">Founded</dt><dd id="record-value-1" class="break-words text-sm"><xsl:value-of select="$v1"/></dd></div></xsl:if>      <xsl:variable name="v2" select="m:values(root(.), 'http://dbpedia.org/ontology/headquarter')"/>
      <xsl:if test="$v2 != ''"><div id="record-row-2" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"><dt id="record-key-2" class="text-xs font-medium text-muted-foreground">Headquarters</dt><dd id="record-value-2" class="break-words text-sm"><xsl:value-of select="$v2"/></dd></div></xsl:if>      <xsl:variable name="v3" select="m:values(root(.), 'http://dbpedia.org/ontology/location')"/>
      <xsl:if test="$v3 != ''"><div id="record-row-3" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"><dt id="record-key-3" class="text-xs font-medium text-muted-foreground">Location</dt><dd id="record-value-3" class="break-words text-sm"><xsl:value-of select="$v3"/></dd></div></xsl:if>      <xsl:variable name="v4" select="m:values(root(.), 'http://dbpedia.org/ontology/industry')"/>
      <xsl:if test="$v4 != ''"><div id="record-row-4" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"><dt id="record-key-4" class="text-xs font-medium text-muted-foreground">Industry</dt><dd id="record-value-4" class="break-words text-sm"><xsl:value-of select="$v4"/></dd></div></xsl:if></dl><xsl:variable name="allPropertyRows" select="root(.)/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[2] and fct:column[3] and not(fct:column[2] = ('http://www.w3.org/1999/02/22-rdf-syntax-ns#type', 'http://www.w3.org/2000/01/rdf-schema#label', 'http://purl.org/dc/terms/subject', 'http://dbpedia.org/ontology/abstract', 'http://xmlns.com/foaf/0.1/depiction', 'http://dbpedia.org/ontology/thumbnail'))]"/>
<xsl:if test="exists($allPropertyRows)">
<section id="record-additional-section" class="border-t px-5 py-4">
<h3 id="record-additional-title" class="mb-2 text-sm font-semibold">Additional details</h3>
<dl id="record-additional-list" class="divide-y">
<xsl:for-each-group select="$allPropertyRows" group-by="normalize-space(string(fct:column[2]))">
<xsl:variable name="predicate" select="current-grouping-key()"/><xsl:variable name="groupIndex" select="position()"/>
<div id="record-extra-{position()}" class="grid gap-1 py-2 sm:grid-cols-[9rem_1fr]">
<dt id="record-extra-key-{position()}" class="break-all text-xs font-medium text-muted-foreground" title="{$predicate}"><xsl:value-of select="tokenize($predicate, '[/#]')[last()]"/></dt>
<dd id="record-extra-value-{position()}" class="break-words text-sm">
<xsl:for-each select="distinct-values(current-group()/fct:column[3] ! normalize-space(string(.)))[. != '']">
<xsl:choose>
<xsl:when test="matches(., '^https?://')"><a id="record-extra-uri-{position()}-{$groupIndex}" data-maestro-record-uri="{.}" href="#" class="text-primary hover:underline"><xsl:value-of select="tokenize(., '[/#]')[last()]"/></a></xsl:when>
<xsl:otherwise><span id="record-extra-text-{position()}-{$groupIndex}"><xsl:value-of select="."/></span></xsl:otherwise>
</xsl:choose><xsl:if test="position() ne last()"><span id="record-extra-separator-{position()}-{$groupIndex}"> · </span></xsl:if>
</xsl:for-each>
</dd></div>
</xsl:for-each-group>
</dl></section></xsl:if><footer id="record-footer" class="border-t px-5 py-3 text-xs text-muted-foreground">DBpedia record · Maestro formatter</footer></article><svg:svg xmlns:svg="http://www.w3.org/2000/svg" id="dbpedia-organisation-record-heading-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" mui:parent="record_title_icon"><svg:rect id="dbpedia-organisation-record-icon-1" x="4" y="2" width="16" height="20" rx="2"/><svg:path id="dbpedia-organisation-record-icon-2" d="M9 22v-4h6v4M8 6h.01M16 6h.01M12 6h.01M12 10h.01M12 14h.01M16 10h.01M16 14h.01M8 10h.01M8 14h.01"/></svg:svg></section></xsl:template></xsl:stylesheet>""" .

<gttp://ggg.maestro.ecosys/shacl/template#DbpediaPersonRecordTemplate> rdfs:label "Person profile card"@en ;
    rdf:value """<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:fct="http://openlinksw.com/services/facets/1.0/" xmlns:mctx="gttp://ggg.maestro.ecosys/ns/xslt/context#" xmlns:m="gttp://ggg.maestro.ecosys/ns/xslt/dbpedia#" version="3.0" exclude-result-prefixes="xs fct mctx m">
<xsl:output method="html" encoding="UTF-8" omit-xml-declaration="yes"/><xsl:param name="recordUri"/>
<xsl:function name="m:values" as="xs:string">
<xsl:param name="ctx" as="node()"/><xsl:param name="predicate" as="xs:string"/>
<xsl:variable name="localName" select="tokenize($predicate, '[/#]')[last()]"/>
<xsl:variable name="rows" select="$ctx/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[2] = $predicate or tokenize(normalize-space(string(fct:column[2])), '[/#]')[last()] = $localName]"/>
<xsl:sequence select="string-join(distinct-values($rows/fct:column[3] ! normalize-space(string(.)))[. != ''], ', ')"/>
</xsl:function>
<xsl:template match="/"><section xmlns:mui="gttp://ggg.maestro.ecosys/ns/ui#" mui:framework="next@^16.4.0" id="maestro-record-viewer" class="mx-auto w-full max-w-2xl p-1"><article id="record-card" class="rounded-xl border bg-card text-card-foreground shadow-sm"><xsl:variable name="pictures" as="xs:string*" select="distinct-values(root(.)/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[2] = ('http://xmlns.com/foaf/0.1/depiction','http://dbpedia.org/ontology/thumbnail','http://dbpedia.org/ontology/depiction','https://schema.org/image','http://schema.org/image')]/fct:column[3] ! normalize-space(string(.)))[matches(., '^https?://')]"/>

<header id="record-header" class="border-b bg-muted/40 px-5 py-4"><p id="record-category" class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">DBpedia · Person</p><h2 id="record-title" class="mt-1 break-words text-xl font-semibold"><xsl:choose><xsl:when test="m:values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label') != ''"><xsl:value-of select="m:values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label')"/></xsl:when><xsl:otherwise><xsl:value-of select="$recordUri"/></xsl:otherwise></xsl:choose></h2><div id="record-intro-layout" class="{if (exists($pictures)) then 'grid gap-4 sm:grid-cols-[minmax(0,1fr)_11rem] sm:items-start' else 'block'}"><div id="record-intro-text" class="min-w-0"><xsl:variable name="abstractCandidates" select="root(.)/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[2]='http://dbpedia.org/ontology/abstract']/fct:column[3]"/><xsl:variable name="preferredAbstract" select="($abstractCandidates[starts-with(lower-case(string((@xml:lang, @lang)[1])), 'en')], $abstractCandidates)[1]"/><xsl:if test="$preferredAbstract and normalize-space(string($preferredAbstract)) != ''"><p id="record-abstract" class="mt-3 whitespace-pre-line text-sm leading-relaxed text-muted-foreground"><xsl:value-of select="normalize-space(string($preferredAbstract))"/></p></xsl:if></div><xsl:if test="exists($pictures)"><section id="record-depictions" class="min-w-0 bg-muted/20 p-2 rounded-lg" aria-label="Depictions"><div id="record-carousel" role="region" aria-roledescription="carousel" class="relative mx-auto max-w-xs"><div id="record-carousel-track" class="flex snap-x snap-mandatory gap-2 overflow-x-auto scroll-smooth rounded-lg" style="scrollbar-width:none"><xsl:for-each select="$pictures"><figure id="record-picture-{position()}" class="min-w-full shrink-0 snap-center"><img id="record-photo-{position()}" src="{.}" alt="Depiction {position()} of {count($pictures)}" referrerpolicy="no-referrer" loading="lazy" class="h-52 w-full rounded-md object-contain"/></figure></xsl:for-each></div><xsl:if test="count($pictures) gt 1"><div id="record-carousel-controls" class="pointer-events-none absolute inset-0 flex items-center justify-between px-1">
<button id="record-carousel-back" type="button" data-maestro-carousel="previous" aria-label="Previous picture" title="Previous picture" class="pointer-events-auto flex size-8 items-center justify-center rounded-full border bg-background/90 text-foreground shadow-sm hover:bg-accent">‹</button>
<button id="record-carousel-next" type="button" data-maestro-carousel="next" aria-label="Next picture" title="Next picture" class="pointer-events-auto flex size-8 items-center justify-center rounded-full border bg-background/90 text-foreground shadow-sm hover:bg-accent">›</button>
</div></xsl:if></div></section></xsl:if></div></header>
<div id="record-profile-layout" class="block"><div id="record-prominent-information" class="min-w-0"><dl id="record-fields" class="px-5 py-2">      <xsl:variable name="v0" select="m:values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label')"/>
      <xsl:if test="$v0 != ''"><div id="record-row-0" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"><dt id="record-key-0" class="text-xs font-medium text-muted-foreground">Name</dt><dd id="record-value-0" class="break-words text-sm"><xsl:value-of select="$v0"/></dd></div></xsl:if>      <xsl:variable name="v1" select="m:values(root(.), 'http://dbpedia.org/ontology/birthDate')"/>
      <xsl:if test="$v1 != ''"><div id="record-row-1" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"><dt id="record-key-1" class="text-xs font-medium text-muted-foreground">Birth date</dt><dd id="record-value-1" class="break-words text-sm"><xsl:value-of select="$v1"/></dd></div></xsl:if>      <xsl:variable name="v2" select="m:values(root(.), 'http://dbpedia.org/ontology/deathDate')"/>
      <xsl:if test="$v2 != ''"><div id="record-row-2" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"><dt id="record-key-2" class="text-xs font-medium text-muted-foreground">Death date</dt><dd id="record-value-2" class="break-words text-sm"><xsl:value-of select="$v2"/></dd></div></xsl:if>      <xsl:variable name="v3" select="m:values(root(.), 'http://dbpedia.org/ontology/birthPlace')"/>
      <xsl:if test="$v3 != ''"><div id="record-row-3" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"><dt id="record-key-3" class="text-xs font-medium text-muted-foreground">Birth place</dt><dd id="record-value-3" class="break-words text-sm"><xsl:for-each select="distinct-values(root(.)/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[2] = 'http://dbpedia.org/ontology/birthPlace' or tokenize(string(fct:column[2]), '[/#]')[last()] = tokenize('http://dbpedia.org/ontology/birthPlace', '[/#]')[last()]]/fct:column[3] ! normalize-space(string(.)))[. != '']"><xsl:choose><xsl:when test="matches(., '^https?://')"><a id="record-value-3-uri-{position()}" data-maestro-record-uri="{.}" href="#"><xsl:value-of select="."/></a></xsl:when><xsl:otherwise><span id="record-value-3-text-{position()}"><xsl:value-of select="."/></span></xsl:otherwise></xsl:choose><xsl:if test="position() != last()"><span id="record-value-3-separator-{position()}"> · </span></xsl:if></xsl:for-each></dd></div></xsl:if>      <xsl:variable name="v4" select="m:values(root(.), 'http://dbpedia.org/ontology/occupation')"/>
      <xsl:if test="$v4 != ''"><div id="record-row-4" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"><dt id="record-key-4" class="text-xs font-medium text-muted-foreground">Occupation</dt><dd id="record-value-4" class="break-words text-sm"><xsl:for-each select="distinct-values(root(.)/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[2] = 'http://dbpedia.org/ontology/occupation' or tokenize(string(fct:column[2]), '[/#]')[last()] = tokenize('http://dbpedia.org/ontology/occupation', '[/#]')[last()]]/fct:column[3] ! normalize-space(string(.)))[. != '']"><xsl:choose><xsl:when test="matches(., '^https?://')"><a id="record-value-4-uri-{position()}" data-maestro-record-uri="{.}" href="#"><xsl:value-of select="."/></a></xsl:when><xsl:otherwise><span id="record-value-4-text-{position()}"><xsl:value-of select="."/></span></xsl:otherwise></xsl:choose><xsl:if test="position() != last()"><span id="record-value-4-separator-{position()}"> · </span></xsl:if></xsl:for-each></dd></div></xsl:if>      <xsl:variable name="v5" select="m:values(root(.), 'http://dbpedia.org/ontology/birthName')"/>
      <xsl:if test="$v5 != ''"><div id="record-row-5" class="grid gap-1 border-t py-2 sm:grid-cols-[9rem_1fr]"><dt id="record-key-5" class="text-xs font-medium text-muted-foreground">Birth name</dt><dd id="record-value-5" class="break-words text-sm"><xsl:value-of select="$v5"/></dd></div></xsl:if>
      <xsl:variable name="v6" select="m:values(root(.), 'http://dbpedia.org/ontology/nationality')"/>
