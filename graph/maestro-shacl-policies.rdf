  <rdf:Description rdf:about="gttp://ggg.maestro.ecosys/shacl/template#BookmarkRecordTemplate">
    <rdf:value>&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:fct="http://openlinksw.com/services/facets/1.0/" xmlns:mui="gttp://ggg.maestro.ecosys/ns/ui#" xmlns:mctx="gttp://ggg.maestro.ecosys/ns/xslt/context#" xmlns:svg="http://www.w3.org/2000/svg" xmlns:xs="http://www.w3.org/2001/XMLSchema" version="3.0" exclude-result-prefixes="xs fct mctx"&gt;&lt;xsl:output method="html" encoding="UTF-8" omit-xml-declaration="yes"/&gt;&lt;xsl:param name="recordUri"/&gt;&lt;xsl:mode on-no-match="shallow-copy"/&gt;&lt;xsl:function name="mui:joined-values" as="xs:string"&gt;&lt;xsl:param name="context" as="node()"/&gt;&lt;xsl:param name="predicate" as="xs:string"/&gt;&lt;xsl:try&gt;&lt;xsl:sequence select="string-join($context/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[.=$predicate]]/fct:column[last()] ! string(.), ', ')"/&gt;&lt;xsl:catch&gt;&lt;xsl:sequence select="''"/&gt;&lt;/xsl:catch&gt;&lt;/xsl:try&gt;&lt;/xsl:function&gt;&lt;xsl:template match="/"&gt;&lt;section id="maestro-record-viewer" data-slot="card" class="mx-auto flex w-full max-w-2xl flex-col gap-6 p-1" mui:framework="next@^16.4.0"&gt;
  &lt;div id="bookmark-hero" data-slot="card" class="relative overflow-hidden rounded-xl border bg-card text-card-foreground shadow-sm"&gt;
    &lt;div id="bookmark-hero-glow" aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-sky-500 via-violet-500 to-fuchsia-500"/&gt;
    &lt;div id="bookmark-hero-content" class="relative space-y-5 p-6 sm:p-8"&gt;
      &lt;div id="bookmark-kicker-row" class="flex flex-wrap items-center justify-between gap-3"&gt;
        &lt;span id="bookmark-kind" class="inline-flex items-center gap-2 rounded-full border bg-secondary px-3 py-1 text-xs font-semibold tracking-wide text-secondary-foreground"&gt;BOOKMARK &lt;span id="bookmark-kind-link-icon" aria-hidden="true" class="inline-flex size-3 items-center justify-center"&gt;↗&lt;/span&gt;&lt;/span&gt;
        &lt;span id="bookmark-state" class="inline-flex items-center gap-2 text-xs font-medium text-muted-foreground"&gt;&lt;span id="bookmark-state-dot" aria-hidden="true" class="size-2 rounded-full bg-emerald-500"/&gt;Saved resource&lt;/span&gt;
      &lt;/div&gt;
      &lt;div id="bookmark-heading-group" class="space-y-2"&gt;
        &lt;p id="bookmark-eyebrow" class="text-sm font-medium text-muted-foreground"&gt;Your collection&lt;/p&gt;
        &lt;div id="bookmark-title-row" class="flex min-w-0 items-center gap-2"&gt;
          &lt;a id="bookmark-title-link" class="inline-flex min-w-0 items-center gap-2 break-words text-2xl font-semibold tracking-tight text-primary underline-offset-4 hover:underline cursor-pointer sm:text-3xl" mui:href="xpath:/fct:facets/fct:result[@type='describe']/fct:row[fct:column[.='https://schema.org/url']]/fct:column[last()]" target="_self" rel="noopener noreferrer" aria-label="Open the saved query state"&gt;
            &lt;span id="bookmark-title-text" mui:data="http://purl.org/dc/terms/title"&gt;&lt;xsl:value-of select="mui:joined-values(root(.), 'http://purl.org/dc/terms/title')"/&gt;&lt;/span&gt;
            &lt;svg:svg id="bookmark-title-binoculars-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block size-5 shrink-0" role="img" aria-label="Open saved query"&gt;
              &lt;svg:path id="bookmark-title-binoculars-center" d="M10 10h4"/&gt;
              &lt;svg:path id="bookmark-title-binoculars-right-stem" d="M19 7V4a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v3"/&gt;
              &lt;svg:path id="bookmark-title-binoculars-right-body" d="M20 21a2 2 0 0 0 2-2v-3.851c0-1.39-2-2.962-2-4.829V8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v11a2 2 0 0 0 2 2z"/&gt;
              &lt;svg:path id="bookmark-title-binoculars-crossbar" d="M22 16 2 16"/&gt;
              &lt;svg:path id="bookmark-title-binoculars-left-body" d="M4 21a2 2 0 0 1-2-2v-3.851c0-1.39 2-2.962 2-4.829V8a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v11a2 2 0 0 1-2 2z"/&gt;
              &lt;svg:path id="bookmark-title-binoculars-left-stem" d="M9 7V4a1 1 0 0 0-1-1H6a1 1 0 0 0-1 1v3"/&gt;
            &lt;/svg:svg&gt;
          &lt;/a&gt;
        &lt;/div&gt;
        &lt;p id="bookmark-title-detail" class="break-words text-sm leading-6 text-muted-foreground" mui:data="http://purl.org/dc/terms/created"&gt;&lt;xsl:value-of select="mui:joined-values(root(.), 'http://purl.org/dc/terms/created')"/&gt;&lt;/p&gt;
      &lt;/div&gt;
      &lt;div id="bookmark-description-section" class="space-y-2 rounded-lg bg-muted/40 p-4"&gt;
        &lt;h3 id="bookmark-description-heading" class="text-sm font-semibold"&gt;Description&lt;/h3&gt;
        &lt;p id="bookmark-description" class="whitespace-pre-wrap break-words text-sm leading-7 text-muted-foreground" mui:data="http://purl.org/dc/terms/description"&gt;&lt;xsl:value-of select="mui:joined-values(root(.), 'http://purl.org/dc/terms/description')"/&gt;&lt;/p&gt;
      &lt;/div&gt;
      &lt;div id="bookmark-tags-section" class="space-y-2"&gt;
        &lt;h3 id="bookmark-tags-heading" class="text-sm font-semibold"&gt;Tags&lt;/h3&gt;
        &lt;div id="bookmark-tags" class="flex flex-wrap gap-2" mui:data="maestro:bookmark-tags"/&gt;
      &lt;/div&gt;
      &lt;div id="bookmark-metadata" class="grid gap-3 rounded-lg border p-4 sm:grid-cols-2"&gt;
        &lt;div id="bookmark-hash-field" class="min-w-0 space-y-1"&gt;
          &lt;p id="bookmark-hash-label" class="text-xs font-medium text-muted-foreground"&gt;Bookmark hash&lt;/p&gt;
          &lt;p id="bookmark-hash" class="break-all font-mono text-xs leading-5" mui:data="https://schema.org/identifier"&gt;&lt;xsl:value-of select="mui:joined-values(root(.), 'https://schema.org/identifier')"/&gt;&lt;/p&gt;
        &lt;/div&gt;

      &lt;/div&gt;

    &lt;/div&gt;
    &lt;div id="bookmark-footer" class="flex flex-wrap items-center justify-between gap-3 border-t bg-muted/30 px-6 py-4 text-xs text-muted-foreground sm:px-8"&gt;
      &lt;span id="bookmark-footer-brand" class="font-medium"&gt;Maestro Record Viewer&lt;/span&gt;
      &lt;span id="bookmark-footer-note"&gt;Rendered from the record's linked data&lt;/span&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;svg:svg id="maestro-bookmarkrecordtemplate-heading-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" mui:parent="record_title_icon"&gt;&lt;svg:path id="maestro-bookmarkrecordtemplate-icon-0" d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/&gt;&lt;/svg:svg&gt;&lt;/section&gt;
&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</rdf:value>
    <rdfs:label xml:lang="en">Bookmark card</rdfs:label>
  </rdf:Description>
