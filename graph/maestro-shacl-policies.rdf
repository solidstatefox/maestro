  <rdf:Description rdf:about="gttp://ggg.maestro.ecosys/shacl/template#QueryHistoryVisitRecordTemplate">
    <rdf:value>&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:fct="http://openlinksw.com/services/facets/1.0/" xmlns:mui="gttp://ggg.maestro.ecosys/ns/ui#" xmlns:mctx="gttp://ggg.maestro.ecosys/ns/xslt/context#" xmlns:svg="http://www.w3.org/2000/svg" xmlns:xs="http://www.w3.org/2001/XMLSchema" version="3.0" exclude-result-prefixes="xs fct mctx"&gt;&lt;xsl:output method="html" encoding="UTF-8" omit-xml-declaration="yes"/&gt;&lt;xsl:param name="recordUri"/&gt;&lt;xsl:mode on-no-match="shallow-copy"/&gt;&lt;xsl:function name="mui:joined-values" as="xs:string"&gt;&lt;xsl:param name="context" as="node()"/&gt;&lt;xsl:param name="predicate" as="xs:string"/&gt;&lt;xsl:try&gt;&lt;xsl:sequence select="string-join($context/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[.=$predicate]]/fct:column[last()] ! string(.), ', ')"/&gt;&lt;xsl:catch&gt;&lt;xsl:sequence select="''"/&gt;&lt;/xsl:catch&gt;&lt;/xsl:try&gt;&lt;/xsl:function&gt;&lt;xsl:template match="/"&gt;&lt;section id="maestro-record-viewer" class="mx-auto flex w-full max-w-2xl flex-col gap-4 p-1" mui:framework="next@^16.4.0"&gt;&lt;article id="history-record"&gt;&lt;h2 id="history-title" mui:data="http://www.w3.org/2000/01/rdf-schema#label"&gt;&lt;xsl:value-of select="mui:joined-values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label')"/&gt;&lt;/h2&gt;&lt;p id="history-type-label"&gt;Query history bookmark&lt;/p&gt;&lt;p id="history-state-url" mui:data="https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#historyStateUrl"&gt;&lt;xsl:value-of select="mui:joined-values(root(.), 'https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#historyStateUrl')"/&gt;&lt;/p&gt;&lt;p id="history-created" mui:data="https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#historyCreated"&gt;&lt;xsl:value-of select="mui:joined-values(root(.), 'https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#historyCreated')"/&gt;&lt;/p&gt;&lt;/article&gt;&lt;svg:svg id="maestro-queryhistoryvisitrecordtemplate-heading-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" mui:parent="record_title_icon"&gt;&lt;svg:path id="maestro-queryhistoryvisitrecordtemplate-icon-0" d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/&gt;&lt;svg:path id="maestro-queryhistoryvisitrecordtemplate-icon-1" d="M3 3v5h5"/&gt;&lt;svg:path id="maestro-queryhistoryvisitrecordtemplate-icon-2" d="M12 7v5l4 2"/&gt;&lt;/svg:svg&gt;&lt;/section&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</rdf:value>
  </rdf:Description>
</rdf:RDF>
