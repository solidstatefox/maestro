  <rdf:Description rdf:about="gttp://ggg.maestro.ecosys/shacl/template#BookmarkQueryResultsTemplate">
    <rdfs:label xml:lang="en">Bookmark with query results</rdfs:label>
    <rdf:value>&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:fct="http://openlinksw.com/services/facets/1.0/" xmlns:mui="gttp://ggg.maestro.ecosys/ns/ui#" xmlns:mctx="gttp://ggg.maestro.ecosys/ns/xslt/context#" xmlns:svg="http://www.w3.org/2000/svg" xmlns:xs="http://www.w3.org/2001/XMLSchema" version="3.0" exclude-result-prefixes="xs fct mctx"&gt;&lt;xsl:output method="html" encoding="UTF-8" omit-xml-declaration="yes"/&gt;&lt;xsl:param name="recordUri"/&gt;&lt;xsl:mode on-no-match="shallow-copy"/&gt;&lt;xsl:function name="mui:joined-values" as="xs:string"&gt;&lt;xsl:param name="context" as="node()"/&gt;&lt;xsl:param name="predicate" as="xs:string"/&gt;&lt;xsl:try&gt;&lt;xsl:sequence select="string-join($context/mctx:context/mctx:describe/fct:facets/fct:result[@type='describe']/fct:row[fct:column[.=$predicate]]/fct:column[last()] ! string(.), ', ')"/&gt;&lt;xsl:catch&gt;&lt;xsl:sequence select="''"/&gt;&lt;/xsl:catch&gt;&lt;/xsl:try&gt;&lt;/xsl:function&gt;&lt;xsl:template match="/"&gt;&lt;section id="maestro-record-viewer" class="mx-auto flex w-full max-w-2xl flex-col gap-4 p-1" mui:framework="next@^16.4.0"&gt;&lt;article id="bookmark-query-results-card" class="rounded-xl border p-5"&gt;&lt;p id="bookmark-query-results-kicker" class="text-xs font-semibold uppercase tracking-wide text-muted-foreground"&gt;Saved query&lt;/p&gt;&lt;h2 id="bookmark-query-results-title" class="mt-2 text-xl font-semibold" mui:data="http://www.w3.org/2000/01/rdf-schema#label"&gt;&lt;xsl:value-of select="mui:joined-values(root(.), 'http://www.w3.org/2000/01/rdf-schema#label')"/&gt;&lt;/h2&gt;&lt;p id="bookmark-query-results-description" class="mt-2 text-sm text-muted-foreground" mui:data="http://purl.org/dc/terms/description"&gt;&lt;xsl:value-of select="mui:joined-values(root(.), 'http://purl.org/dc/terms/description')"/&gt;&lt;/p&gt;&lt;section id="bookmark-query-results-section" class="mt-5 rounded-lg bg-muted/40 p-4"&gt;&lt;h3 id="bookmark-query-results-heading" class="font-semibold"&gt;Results from the saved query&lt;/h3&gt;&lt;p id="bookmark-query-results-count" class="mt-1 text-sm text-muted-foreground" mui:history-query-count="true"&gt;Loading count…&lt;/p&gt;&lt;ol id="bookmark-query-results-list" class="mt-3 list-decimal space-y-2 pl-5" mui:history-query-results="true"&gt;&lt;li id="bookmark-query-result-item" class="break-words text-sm"/&gt;&lt;/ol&gt;&lt;/section&gt;&lt;p id="bookmark-query-results-created" class="mt-4 text-xs text-muted-foreground" mui:data="http://purl.org/dc/terms/created"&gt;&lt;xsl:value-of select="mui:joined-values(root(.), 'http://purl.org/dc/terms/created')"/&gt;&lt;/p&gt;&lt;/article&gt;&lt;button id="bookmark-template-delete-button" type="button" mui:parent="record_button_bar" class="inline-flex items-center gap-2 rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-accent"&gt;&lt;svg:svg id="bookmark-template-delete-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"&gt;&lt;svg:path id="bookmark-template-delete-can" d="M3 6h18"/&gt;&lt;svg:path id="bookmark-template-delete-lid" d="M8 6V4h8v2"/&gt;&lt;svg:path id="bookmark-template-delete-body" d="m19 6-1 14H6L5 6"/&gt;&lt;svg:path id="bookmark-template-delete-lines" d="M10 11v5m4-5v5"/&gt;&lt;/svg:svg&gt; Delete Bookmark&lt;/button&gt;&lt;button id="bookmark-template-code-button" type="button" mui:parent="record_button_bar" class="inline-flex items-center gap-2 rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-accent"&gt;&lt;svg:svg id="bookmark-template-code-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"&gt;&lt;svg:path id="bookmark-template-code-left" d="m16 18 6-6-6-6"/&gt;&lt;svg:path id="bookmark-template-code-right" d="m8 6-6 6 6 6"/&gt;&lt;svg:path id="bookmark-template-code-slash" d="m14 4-4 16"/&gt;&lt;/svg:svg&gt; Code Block&lt;/button&gt;&lt;svg:svg id="maestro-bookmarkqueryresultstemplate-heading-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" mui:parent="record_title_icon"&gt;&lt;svg:path id="maestro-bookmarkqueryresultstemplate-icon-0" d="M8 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-3"/&gt;&lt;svg:path id="maestro-bookmarkqueryresultstemplate-icon-1" d="M16 3h5v5"/&gt;&lt;svg:path id="maestro-bookmarkqueryresultstemplate-icon-2" d="m10 14 11-11"/&gt;&lt;/svg:svg&gt;&lt;/section&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</rdf:value>
