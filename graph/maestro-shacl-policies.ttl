@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix mui: <gttp://ggg.maestro.ecosys/ns/ui#> .
@prefix bookmark: <http://www.w3.org/2002/01/bookmark#> .
@prefix vfct: <https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Initial Record viewer policies. This file is uploaded into the graph named by SITE_SHAPES.
# Extend these shapes and templates as the Record viewer's presentation vocabulary evolves.

<gttp://ggg.maestro.ecosys/shacl/policy/bookmark> a mui:ClassPolicy ;
    rdfs:label "Bookmark record policy"@en ;
    mui:forClass bookmark:Bookmark ;
    mui:recordShape <gttp://ggg.maestro.ecosys/shacl/shape#BookmarkRecordShape> ;
    mui:htmlTemplate <gttp://ggg.maestro.ecosys/shacl/template#BookmarkRecordTemplate>,
                     <gttp://ggg.maestro.ecosys/shacl/template#BookmarkQueryResultsTemplate> .

<gttp://ggg.maestro.ecosys/shacl/shape#BookmarkRecordShape> a sh:NodeShape ;
    rdfs:label "Bookmark record shape"@en ;
    sh:targetClass bookmark:Bookmark ;
    sh:property [ a sh:PropertyShape ; sh:path rdf:type ; sh:name "Type" ; sh:order 0 ] ;
    sh:property [ a sh:PropertyShape ; sh:path rdfs:label ; sh:name "Label" ; sh:order 1 ] ;
    sh:property [ a sh:PropertyShape ; sh:path bookmark:title ; sh:name "Title" ; sh:order 2 ] ;
    sh:property [ a sh:PropertyShape ; sh:path bookmark:recalls ; sh:name "Bookmarked resource" ; sh:nodeKind sh:IRI ; sh:order 3 ] .

<gttp://ggg.maestro.ecosys/shacl/policy/query-history-visit> a mui:ClassPolicy ;
    rdfs:label "Query history bookmark policy"@en ;
    mui:forClass vfct:QueryHistoryVisit ;
    mui:recordShape <gttp://ggg.maestro.ecosys/shacl/shape#QueryHistoryVisitRecordShape> ;
    mui:htmlTemplate <gttp://ggg.maestro.ecosys/shacl/template#QueryHistoryVisitRecordTemplate> .

<gttp://ggg.maestro.ecosys/shacl/shape#QueryHistoryVisitRecordShape> a sh:NodeShape ;
    sh:targetClass vfct:QueryHistoryVisit ;
    sh:property [ a sh:PropertyShape ; sh:path rdf:type ; sh:name "Type" ; sh:order 0 ] ;
    sh:property [ a sh:PropertyShape ; sh:path rdfs:label ; sh:name "Label" ; sh:order 1 ] ;
    sh:property [ a sh:PropertyShape ; sh:path schema:identifier ; sh:name "Bookmark hash" ; sh:order 2 ] ;
    sh:property [ a sh:PropertyShape ; sh:path dcterms:created ; sh:name "Created" ; sh:order 3 ] .

<gttp://ggg.maestro.ecosys/shacl/template#BookmarkRecordTemplate> rdf:value "<article id=\"bookmark-record\"><h2 id=\"bookmark-title\" mui:data=\"http://www.w3.org/2000/01/rdf-schema#label\"></h2><p id=\"bookmark-type-label\">Bookmark</p><p id=\"bookmark-resource\" mui:data=\"http://www.w3.org/2002/01/bookmark#recalls\"></p><p id=\"bookmark-title-value\" mui:data=\"http://www.w3.org/2002/01/bookmark#title\"></p></article>" .

<gttp://ggg.maestro.ecosys/shacl/template#QueryHistoryVisitRecordTemplate> rdf:value "<section id=\"maestro-record-viewer\" class=\"mx-auto flex w-full max-w-2xl flex-col gap-4 p-1\" mui:framework=\"next@^16.4.0\"><article id=\"history-record\"><h2 id=\"history-title\" mui:data=\"http://www.w3.org/2000/01/rdf-schema#label\"></h2><p id=\"history-type-label\">Query history bookmark</p><p id=\"history-hash\" mui:data=\"https://schema.org/identifier\"></p><p id=\"history-created\" mui:data=\"http://purl.org/dc/terms/created\"></p></article></section>" .

<gttp://ggg.maestro.ecosys/shacl/template#BookmarkRecordTemplate> rdfs:label "Bookmark card"@en .
<gttp://ggg.maestro.ecosys/shacl/template#BookmarkQueryResultsTemplate> rdfs:label "Bookmark with query results"@en ;
    rdf:value "<section id=\"maestro-record-viewer\" class=\"mx-auto flex w-full max-w-2xl flex-col gap-4 p-1\" mui:framework=\"next@^16.4.0\"><article id=\"bookmark-query-results-card\" class=\"rounded-xl border p-5\"><p id=\"bookmark-query-results-kicker\" class=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground\">Saved query</p><h2 id=\"bookmark-query-results-title\" class=\"mt-2 text-xl font-semibold\" mui:data=\"http://www.w3.org/2000/01/rdf-schema#label\"></h2><p id=\"bookmark-query-results-description\" class=\"mt-2 text-sm text-muted-foreground\" mui:data=\"http://purl.org/dc/terms/description\"></p><section id=\"bookmark-query-results-section\" class=\"mt-5 rounded-lg bg-muted/40 p-4\"><h3 id=\"bookmark-query-results-heading\" class=\"font-semibold\">Results from the saved query</h3><p id=\"bookmark-query-results-count\" class=\"mt-1 text-sm text-muted-foreground\" mui:history-query-count=\"true\">Loading count…</p><ol id=\"bookmark-query-results-list\" class=\"mt-3 list-decimal space-y-2 pl-5\" mui:history-query-results=\"true\"><li id=\"bookmark-query-result-item\" class=\"break-words text-sm\"></li></ol></section><p id=\"bookmark-query-results-created\" class=\"mt-4 text-xs text-muted-foreground\" mui:data=\"http://purl.org/dc/terms/created\"></p></article><button id=\"bookmark-template-delete-button\" type=\"button\" mui:parent=\"record_button_bar\" class=\"inline-flex items-center gap-2 rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-accent\"><svg id=\"bookmark-template-delete-icon\" aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"size-4\"><path id=\"bookmark-template-delete-can\" d=\"M3 6h18\"/><path id=\"bookmark-template-delete-lid\" d=\"M8 6V4h8v2\"/><path id=\"bookmark-template-delete-body\" d=\"m19 6-1 14H6L5 6\"/><path id=\"bookmark-template-delete-lines\" d=\"M10 11v5m4-5v5\"/></svg> Delete Bookmark</button><button id=\"bookmark-template-code-button\" type=\"button\" mui:parent=\"record_button_bar\" class=\"inline-flex items-center gap-2 rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-accent\"><svg id=\"bookmark-template-code-icon\" aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"size-4\"><path id=\"bookmark-template-code-left\" d=\"m16 18 6-6-6-6\"/><path id=\"bookmark-template-code-right\" d=\"m8 6-6 6 6 6\"/><path id=\"bookmark-template-code-slash\" d=\"m14 4-4 16\"/></svg> Code Block</button></section>" .
