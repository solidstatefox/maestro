<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:schema="http://schema.org/" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:otc="gttp://ggg.openlink.sw/nlp/transcoder#" xmlns:sh="http://www.w3.org/ns/shacl#">
<rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#Document"><rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/><rdfs:subClassOf rdf:resource="http://schema.org/DigitalDocument"/><rdfs:label>OTC Document</rdfs:label><rdfs:comment>The canonical input-document base class for future OTC document-normalization and specialized document transcoders.</rdfs:comment></rdf:Description><rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#templateLanguage"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/><rdfs:label>templateLanguage</rdfs:label><rdfs:domain rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Rule"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:comment>Template dialect used by otc:template, currently liquid. Slot names are the query projection names without their leading question marks.</rdfs:comment></rdf:Description><rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#select"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/><rdfs:label>select</rdfs:label><rdfs:domain rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Rule"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:comment>Read-only SPARQL SELECT that binds initial source resources for this rule. Executed before the survey; distinct from post-output otc:target.</rdfs:comment></rdf:Description><!-- ========================================== -->
<!-- 1. Vocabulary Definition                   -->
<rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#ask"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/><rdfs:domain rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Rule"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label>ask</rdfs:label><rdfs:comment>Read-only SPARQL ASK eligibility gate for the rule, executed after any predecessor dispatch and before source selection or survey evaluation.</rdfs:comment></rdf:Description><!-- ========================================== -->


<rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#Transcoder">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label>Transcoder</rdfs:label>
    <rdfs:comment>A survey-based transformation rule set for turning NL into structured LOD via LLM.</rdfs:comment>
</rdf:Description>


<rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#Rule">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label>Transcoder Rule</rdfs:label>
    <rdfs:comment>The basic unit: an AIML-inspired pairing of an NL survey question and an RDF template payload.</rdfs:comment>
</rdf:Description>


<rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#hasRule">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>has rule</rdfs:label>
    <rdfs:domain rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Transcoder"/>
    <rdfs:range rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Rule"/>
</rdf:Description>


<rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#target">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>target</rdfs:label>
    <rdfs:domain rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Rule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Read-only SPARQL SELECT used AFTER output generation to discover candidate successor transcoders and their linked SHACL input shapes. Runtime must validate candidate shapes against generated RDF before activating successors.</rdfs:comment>
</rdf:Description>


<rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#query">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>query</rdfs:label>
    <rdfs:domain rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Rule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>The survey question posed to the LLM densely packed with RDF schema entities.</rdfs:comment>
</rdf:Description>


<rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#assume">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>assume</rdfs:label>
    <rdfs:domain rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Rule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>A plain-language background assumption required for the survey rule.</rdfs:comment>
</rdf:Description>


<rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#template">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>template</rdfs:label>
    <rdfs:domain rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Rule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Liquid template that constructs RDF/Turtle from SPARQL and LLM-projected variables, with RDF-safe serialization filters.</rdfs:comment>
</rdf:Description>


<!-- ========================================== -->
<!-- 2. Transcoder Instances                    -->
<!-- ========================================== -->


<!-- Transcoder 1: Topic Extractor -->
<rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#ChatGPTTopicExtractor">
    <rdf:type rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Transcoder"/>
    <dcterms:title>ChatGPT Conversation Topic Extractor</dcterms:title>
    <dcterms:description>Surveys conversation text to extract core topics using dense LOD entity patterns.</dcterms:description>
    <otc:hasRule>
        <rdf:Description>
            <rdf:type rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Rule"/>
            
            
            <!-- Projection supplied by the source graph before the LLM survey. -->
            <otc:ask>PREFIX schema: &lt;http://schema.org/&gt;
ASK WHERE {
  ?conversation a schema:Conversation ; schema:hasPart ?message .
  ?message a schema:Message ;
           schema:author "assistant" ;
           schema:text ?content .
  FILTER(STRLEN(STR(?content)) &gt; 0)
}
</otc:ask><otc:select>PREFIX schema: &lt;http://schema.org/&gt;
PREFIX dcterms: &lt;http://purl.org/dc/terms/&gt;

SELECT ?conversation ?message ?conv_id ?msg_id ?content ?author
WHERE {
  ?conversation a schema:Conversation ;
                schema:hasPart ?message ;
                dcterms:identifier ?conv_id .
  ?message a schema:Message ;
           dcterms:identifier ?msg_id ;
           schema:author ?author ;
           schema:text ?content .
  FILTER(?author = "assistant" &amp;&amp; STRLEN(STR(?content)) &gt; 0)
}</otc:select>

<!-- Declarative system-level background assumptions -->
            <otc:assume>The source dataset contains populated schema:Conversation and schema:Message resources selected by otc:select.</otc:assume>
            <otc:assume>The target message has an author role of 'assistant'.</otc:assume>


            <!-- AIML-style Question Query targeting specifically the bot reply -->
            <otc:query>
                What is the primary schema:Thing the bot reply is schema:about within the schema:hasPart &gt; schema:Message identified by dcterms:identifier ?msg_id of the schema:Conversation identified by dcterms:identifier ?conv_id?
            </otc:query>


            <!-- Pure Embellishment Payload anchored to the message/reply node -->
            <otc:templateLanguage>liquid</otc:templateLanguage><otc:template>
@prefix schema: &lt;http://schema.org/&gt; .

{{ message | rdf_iri }} schema:about [
    a schema:Thing ;
    {% if resp_is_uri %}
    schema:sameAs {{ resp | rdf_iri }}
    {% else %}
    schema:name {{ resp | rdf_literal }}
    {% endif %}
] .
</otc:template>
        <otc:target>PREFIX otc: &lt;gttp://ggg.openlink.sw/nlp/transcoder#&gt;
PREFIX sh: &lt;http://www.w3.org/ns/shacl#&gt;

SELECT DISTINCT ?nextTranscoder ?shape
WHERE {
  ?nextTranscoder a otc:Transcoder ;
                  otc:validator ?shape .
  ?shape a sh:NodeShape .
  FILTER(?nextTranscoder != &lt;gttp://ggg.openlink.sw/nlp/transcoder#ChatGPTTopicExtractor&gt;)
}</otc:target></rdf:Description>
    </otc:hasRule>
<otc:validator rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#ChatGPTTopicExtractorMessageShape"/></rdf:Description>


<!-- Transcoder 2: User Sentiment Extractor -->
<rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#ChatGPTUserSentimentExtractor">
    <rdf:type rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Transcoder"/>
    <dcterms:title>ChatGPT User Sentiment Extractor</dcterms:title>
    <dcterms:description>Evaluates the user prompt in a message turn to extract overall sentiment (e.g., Positive, Neutral, Negative, Frustrated, Curious).</dcterms:description>
    <otc:hasRule>
        <rdf:Description>
            <rdf:type rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Rule"/>
            
            
            <!-- Projection supplied by the source graph before the LLM survey. -->
            <otc:ask>PREFIX schema: &lt;http://schema.org/&gt;
ASK WHERE {
  ?conversation a schema:Conversation ; schema:hasPart ?message .
  ?message a schema:Message ;
           schema:author "user" ;
           schema:text ?content .
  FILTER(STRLEN(STR(?content)) &gt; 0)
}
</otc:ask><otc:select>PREFIX schema: &lt;http://schema.org/&gt;
PREFIX dcterms: &lt;http://purl.org/dc/terms/&gt;

SELECT ?conversation ?message ?conv_id ?msg_id ?content ?author
WHERE {
  ?conversation a schema:Conversation ;
                schema:hasPart ?message ;
                dcterms:identifier ?conv_id .
  ?message a schema:Message ;
           dcterms:identifier ?msg_id ;
           schema:author ?author ;
           schema:text ?content .
  FILTER(?author = "user" &amp;&amp; STRLEN(STR(?content)) &gt; 0)
}</otc:select>

<otc:assume>The source dataset contains populated schema:Conversation and schema:Message resources selected by otc:select.</otc:assume>
            <otc:assume>The target prompt message has an author role of 'user'.</otc:assume>


            <otc:query>
                What is the primary sentiment expressed by the user in the schema:Message identified by dcterms:identifier ?msg_id within the schema:Conversation identified by dcterms:identifier ?conv_id?
            </otc:query>


            <otc:templateLanguage>liquid</otc:templateLanguage><otc:template>
@prefix schema: &lt;http://schema.org/&gt; .
@prefix otc: &lt;gttp://ggg.openlink.sw/nlp/transcoder#&gt; .

{{ message | rdf_iri }} otc:sentiment [
    a schema:SentimentAnalysis ;
    {% if resp_is_uri %}
    schema:sameAs {{ resp | rdf_iri }}
    {% else %}
    schema:queryOutput {{ resp | rdf_literal }}
    {% endif %}
] .
</otc:template>
        <otc:target>PREFIX otc: &lt;gttp://ggg.openlink.sw/nlp/transcoder#&gt;
PREFIX sh: &lt;http://www.w3.org/ns/shacl#&gt;

SELECT DISTINCT ?nextTranscoder ?shape
WHERE {
  ?nextTranscoder a otc:Transcoder ;
                  otc:validator ?shape .
  ?shape a sh:NodeShape .
  FILTER(?nextTranscoder != &lt;gttp://ggg.openlink.sw/nlp/transcoder#ChatGPTUserSentimentExtractor&gt;)
}</otc:target></rdf:Description>
    </otc:hasRule>
<otc:validator rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#ChatGPTUserSentimentExtractorMessageShape"/></rdf:Description>


<!-- Transcoder 3: Response Mode Extractor -->
<rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#ChatGPTResponseModeExtractor">
    <rdf:type rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Transcoder"/>
    <dcterms:title>ChatGPT Bot Response Mode Extractor</dcterms:title>
    <dcterms:description>Determines the communicative mode of the bot answer (asking a question, providing instructions, providing code/example, or direct compliance).</dcterms:description>
    <otc:hasRule>
        <rdf:Description>
            <rdf:type rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Rule"/>
            
            
            <!-- Projection supplied by the source graph before the LLM survey. -->
            <otc:ask>PREFIX schema: &lt;http://schema.org/&gt;
ASK WHERE {
  ?conversation a schema:Conversation ; schema:hasPart ?message .
  ?message a schema:Message ;
           schema:author "assistant" ;
           schema:text ?content .
  FILTER(STRLEN(STR(?content)) &gt; 0)
}
</otc:ask><otc:select>PREFIX schema: &lt;http://schema.org/&gt;
PREFIX dcterms: &lt;http://purl.org/dc/terms/&gt;

SELECT ?conversation ?message ?conv_id ?msg_id ?content ?author
WHERE {
  ?conversation a schema:Conversation ;
                schema:hasPart ?message ;
                dcterms:identifier ?conv_id .
  ?message a schema:Message ;
           dcterms:identifier ?msg_id ;
           schema:author ?author ;
           schema:text ?content .
  FILTER(?author = "assistant" &amp;&amp; STRLEN(STR(?content)) &gt; 0)
}</otc:select>

<otc:assume>The source dataset contains populated schema:Conversation and schema:Message resources selected by otc:select.</otc:assume>
            <otc:assume>The target message has an author role of 'assistant'.</otc:assume>


            <otc:query>
                What is the communicative mode of the bot reply in the schema:Message identified by dcterms:identifier ?msg_id of the schema:Conversation identified by dcterms:identifier ?conv_id (e.g., 'question', 'instructions', 'example', or 'direct compliance')?
            </otc:query>


            <otc:templateLanguage>liquid</otc:templateLanguage><otc:template>
@prefix schema: &lt;http://schema.org/&gt; .
@prefix otc: &lt;gttp://ggg.openlink.sw/nlp/transcoder#&gt; .

{{ message | rdf_iri }} otc:responseMode [
    a schema:ActionStatusType ;
    {% if resp_is_uri %}
    schema:sameAs {{ resp | rdf_iri }}
    {% else %}
    schema:name {{ resp | rdf_literal }}
    {% endif %}
] .
</otc:template>
        <otc:target>PREFIX otc: &lt;gttp://ggg.openlink.sw/nlp/transcoder#&gt;
PREFIX sh: &lt;http://www.w3.org/ns/shacl#&gt;

SELECT DISTINCT ?nextTranscoder ?shape
WHERE {
  ?nextTranscoder a otc:Transcoder ;
                  otc:validator ?shape .
  ?shape a sh:NodeShape .
  FILTER(?nextTranscoder != &lt;gttp://ggg.openlink.sw/nlp/transcoder#ChatGPTResponseModeExtractor&gt;)
}</otc:target></rdf:Description>
    </otc:hasRule>
<otc:validator rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#ChatGPTResponseModeExtractorMessageShape"/></rdf:Description>
<rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#validator"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/><rdfs:domain rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Transcoder"/><rdfs:range rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/><rdfs:label>validator</rdfs:label><rdfs:comment>SHACL input shape linked to the transcoder. The source focus node must conform before survey evaluation; candidate successor shapes must conform to the produced RDF (including source context where referenced).</rdfs:comment></rdf:Description><rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#ChatGPTTopicExtractorMessageShape"><rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/><sh:class rdf:resource="http://schema.org/Message"/><rdfs:label>ChatGPTTopicExtractor message input validation</rdfs:label><sh:property><rdf:Description><sh:path rdf:resource="http://schema.org/text"/><sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount><sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/><sh:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minLength></rdf:Description></sh:property><sh:property><rdf:Description><sh:path rdf:resource="http://schema.org/author"/><sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount><sh:hasValue>assistant</sh:hasValue></rdf:Description></sh:property></rdf:Description><rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#ChatGPTUserSentimentExtractorMessageShape"><rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/><sh:class rdf:resource="http://schema.org/Message"/><rdfs:label>ChatGPTUserSentimentExtractor message input validation</rdfs:label><sh:property><rdf:Description><sh:path rdf:resource="http://schema.org/text"/><sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount><sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/><sh:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minLength></rdf:Description></sh:property><sh:property><rdf:Description><sh:path rdf:resource="http://schema.org/author"/><sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount><sh:hasValue>user</sh:hasValue></rdf:Description></sh:property></rdf:Description><rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#ChatGPTResponseModeExtractorMessageShape"><rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/><sh:class rdf:resource="http://schema.org/Message"/><rdfs:label>ChatGPTResponseModeExtractor message input validation</rdfs:label><sh:property><rdf:Description><sh:path rdf:resource="http://schema.org/text"/><sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount><sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/><sh:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minLength></rdf:Description></sh:property><sh:property><rdf:Description><sh:path rdf:resource="http://schema.org/author"/><sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount><sh:hasValue>assistant</sh:hasValue></rdf:Description></sh:property></rdf:Description><rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#rootTranscoder"><rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/><rdfs:subClassOf rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Transcoder"/><rdfs:label>OTC root transcoder</rdfs:label></rdf:Description><rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#dispatchShape"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/><rdfs:domain rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#rootTranscoder"/><rdfs:range rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/><rdfs:comment>A SHACL shape eligible for dispatch by this root; validated by the specialist before Qwen evaluation.</rdfs:comment></rdf:Description><rdf:Description rdf:about="gttp://ggg.openlink.sw/nlp/transcoder#ConversationRoot"><rdf:type rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#rootTranscoder"/><dcterms:title>Conversation and message root transcoder</dcterms:title><otc:dispatchShape rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#ChatGPTTopicExtractorMessageShape"/><otc:dispatchShape rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#ChatGPTUserSentimentExtractorMessageShape"/><otc:dispatchShape rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#ChatGPTResponseModeExtractorMessageShape"/><otc:hasRule><rdf:Description><rdf:type rdf:resource="gttp://ggg.openlink.sw/nlp/transcoder#Rule"/><otc:ask>PREFIX schema: &lt;http://schema.org/&gt;
ASK WHERE { ?conversation a schema:Conversation ; schema:hasPart ?message . ?message a schema:Message ; schema:text ?content . FILTER(STRLEN(STR(?content)) &gt; 0) }</otc:ask><otc:select>PREFIX schema: &lt;http://schema.org/&gt;
SELECT ?conversation ?message ?content WHERE { ?conversation a schema:Conversation ; schema:hasPart ?message . ?message a schema:Message ; schema:text ?content . FILTER(STRLEN(STR(?content)) &gt; 0) } LIMIT 1</otc:select><otc:assume>The input is an RDF document containing schema:Conversation and schema:Message resources.</otc:assume><otc:query>Does the input document contain a schema:Conversation with at least one schema:Message having nonempty schema:text?</otc:query></rdf:Description></otc:hasRule></rdf:Description></rdf:RDF>
