@prefix mui: <gttp://ggg.maestro.ecosys/ns/ui#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# Provider acceptance shapes use the shared Maestro node-shape hierarchy.
# This adds a middle type without removing existing sh:NodeShape semantics.
mui:Nodeshape a owl:Class ;
  rdfs:subClassOf sh:NodeShape ;
  rdfs:label "Maestro node shape"@en .

mui:InputShape rdfs:subClassOf mui:Nodeshape .
