@prefix mui: <gttp://ggg.maestro.ecosys/ns/ui#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Stable identities for Maestro UI component modules and policy-discovery surfaces.
# Identity is based on source component path; display labels do not define identity.
mui:UIComponent a rdfs:Class ; rdfs:label "Maestro UI component" .
mui:lastRequestComponent a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> ; rdfs:label "Last matching UI component" .
mui:lastRequestHistory a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> ; rdfs:label "Last matching History visit" .
mui:matchedRecord a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> ; rdfs:label "SHACL-matched Record" .

