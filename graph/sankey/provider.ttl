@prefix mui: <gttp://ggg.maestro.ecosys/ns/ui#> .
@prefix ma: <gttp://ggg.maestro.ecosys/ns/analyze#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Generic, query-contextual Analyze provider. This is a coverage visualization,
# not a new RDF datatype, class policy, or graph server capability.
<gttp://ggg.maestro.ecosys/analyze/sankey> a mui:Provider, ma:Analysis, sh:NodeShape ;
  rdfs:label "Sankey"@en ; ma:lucideIcon "workflow" ; ma:order 5 ;
  mui:accepts <gttp://ggg.maestro.ecosys/analyze/sankey/input> ;
  mui:widget <gttp://ggg.maestro.ecosys/analyze/sankey/widget> ;
  ma:stylesheet <gttp://ggg.maestro.ecosys/analyze/sankey#xslt> .

<gttp://ggg.maestro.ecosys/analyze/sankey/input> a mui:InputShape, sh:NodeShape ;
  sh:property [ sh:path mui:query ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mui:focus ; sh:minCount 1 ; sh:maxCount 1 ] .

<gttp://ggg.maestro.ecosys/analyze/sankey/widget> a mui:AnalysisWidget ;
  rdfs:label "FCT relationship coverage flow"@en ;
  rdfs:comment "Predicate-presence percentages of the current FCT page, projected with list-values; Recharts is a temporary host renderer."@en .

# Provider describes eligible FCT axes and the projection contract. The
# existing browser FCT transport produces the batched value data and the host
# visualizes the resulting directed flow. No server-side domain logic.
<gttp://ggg.maestro.ecosys/analyze/sankey#xslt> rdf:value """<xsl:stylesheet version="3.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:fct="http://openlinksw.com/services/facets/1.0" xmlns:m="gttp://ggg.maestro.ecosys/ns/xslt/context#" exclude-result-prefixes="fct m">
  <xsl:output method="xml" omit-xml-declaration="yes"/>
  <xsl:mode name="query" on-no-match="shallow-copy"/>
  <xsl:template match="/m:context"><analysis kind="sankey" measure="predicate-coverage" renderer="recharts">
    <axes><xsl:for-each select="m:query/fct:query//fct:view/../*[self::fct:property or self::fct:property-of]">
      <axis iri="{@iri}" direction="{if (self::fct:property-of) then 'reverse' else 'forward'}"/>
    </xsl:for-each></axes>
    <fct-query><xsl:apply-templates select="m:query/fct:query" mode="query"/></fct-query>
  </analysis></xsl:template>
  <xsl:template match="fct:view" mode="query"><xsl:copy><xsl:copy-of select="@* except (@type)"/><xsl:attribute name="type">list-values</xsl:attribute></xsl:copy></xsl:template>
</xsl:stylesheet>""" .
