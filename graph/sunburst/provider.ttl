@prefix mui: <gttp://ggg.maestro.ecosys/ns/ui#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Opt-in facet renderer: eligibility requires the Categories (rdf:type) facet.
# The user must approve this provider directly or through a matching curator grant.
<gttp://ggg.maestro.ui/provider/category-sunburst> a mui:Provider, mui:FacetProvider ;
  rdfs:label "Sunburst"@en ;
  mui:icon "chart-pie" ;
  mui:requestsClassTree true ;
  mui:accepts <gttp://ggg.maestro.ui/provider/category-sunburst-input> ;
  mui:widget <gttp://ggg.maestro.ui/widget/category-sunburst> .

<gttp://ggg.maestro.ui/provider/category-sunburst-input> a mui:InputShape, sh:NodeShape ;
  sh:path rdf:type ;
  mui:facetDirection "class" ;
  sh:property [ sh:path rdf:type ] .

<gttp://ggg.maestro.ui/widget/category-sunburst> a mui:FacetWidget ;
  rdfs:label "Interactive Categories Sunburst"@en ;
  mui:templateContent """<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="3.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:f="urn:maestro:facet:hierarchy" xmlns:math="http://www.w3.org/2005/xpath-functions/math"
  xmlns:xs="http://www.w3.org/2001/XMLSchema" exclude-result-prefixes="f math xs">
  <xsl:output method="html" omit-xml-declaration="yes"/>
  <!-- The host supplies RDF class hierarchy; all sunburst layout belongs here. -->
  <xsl:function name="f:weight" as="xs:double">
    <xsl:param name="node" as="element(node)"/>
    <xsl:sequence select="max((1, xs:double($node/@count), sum(for $child in $node/node return f:weight($child))))"/>
  </xsl:function>
  <!-- Provider-authored visible label: local part of a QName; keep the full
       name in the sector's accessible label. Never alter IRIs. -->
  <xsl:function name="f:display-label" as="xs:string">
    <xsl:param name="raw" as="xs:string"/>
    <xsl:sequence select="if (matches($raw, '^[A-Za-z_][A-Za-z0-9._-]*:[^/]') and not(contains($raw, '://')))
       then replace($raw, '^[^:]+:', '') else $raw"/>
  </xsl:function>
  <xsl:template match="/facet">
    <xsl:variable name="roots" select="hierarchy/node"/>
    <xsl:variable name="max-depth" select="min((5, max((1, for $n in $roots/descendant-or-self::node return count($n/ancestor-or-self::node)))))"/>
    <xsl:variable name="total" select="sum(for $n in $roots return f:weight($n))"/>
    <!-- A shallow hierarchy stays compact. The outer radius grows by level,
         capped at 144 layout units before the 2.5x display scale (360 final units). -->
    <xsl:variable name="outer-radius" select="min((144, 70 + ($max-depth - 1) * 18.5))"/>
    <div class="w-full min-w-0 px-0 pt-1 pb-0" aria-label="Hierarchical categories sunburst">
      <svg viewBox="{concat(format-number(400 - 2.5 * ($outer-radius + 14),'0.###'),' ',format-number(400 - 2.5 * ($outer-radius + 14),'0.###'),' ',format-number(5 * ($outer-radius + 14),'0.###'),' ',format-number(5 * ($outer-radius + 14),'0.###'))}" overflow="visible" role="group" aria-label="Select categories using hierarchical sunburst sectors" class="h-auto w-full" preserveAspectRatio="xMidYMid meet">
        <g transform="scale(2.5)">
        <xsl:for-each select="$roots">
          <xsl:variable name="offset" select="sum(for $n in preceding-sibling::node return f:weight($n)) div max((1,$total)) * 2 * math:pi()"/>
          <xsl:call-template name="sector">
            <xsl:with-param name="start" select="$offset"/>
            <xsl:with-param name="span" select="f:weight(.) div max((1,$total)) * 2 * math:pi()"/>
            <xsl:with-param name="depth" select="1"/>
            <xsl:with-param name="max-depth" select="$max-depth"/>
            <xsl:with-param name="outer-radius" select="$outer-radius"/>
            <xsl:with-param name="ordinal" select="position()"/>
            <xsl:with-param name="total" select="$total"/>
            <xsl:with-param name="labels-only" select="false()"/>
          </xsl:call-template>
        </xsl:for-each>
        <!-- Labels render in a second pass ABOVE every sector path. Otherwise
             later sibling/descendant wedges literally paint over full radial names. -->
        <xsl:for-each select="$roots">
          <xsl:variable name="offset" select="sum(for $n in preceding-sibling::node return f:weight($n)) div max((1,$total)) * 2 * math:pi()"/>
          <xsl:call-template name="sector">
            <xsl:with-param name="start" select="$offset"/>
            <xsl:with-param name="span" select="f:weight(.) div max((1,$total)) * 2 * math:pi()"/>
            <xsl:with-param name="depth" select="1"/>
            <xsl:with-param name="max-depth" select="$max-depth"/>
            <xsl:with-param name="outer-radius" select="$outer-radius"/>
            <xsl:with-param name="ordinal" select="position()"/>
            <xsl:with-param name="total" select="$total"/>
            <xsl:with-param name="labels-only" select="true()"/>
          </xsl:call-template>
        </xsl:for-each>
        <circle cx="160" cy="160" r="45" fill="var(--background)"/>
        <text x="160" y="155" text-anchor="middle" fill="currentColor" font-size="13" font-weight="600">Categories</text>
        <text x="160" y="175" text-anchor="middle" fill="currentColor" font-size="11"><xsl:value-of select="count(item)"/> values</text>
        </g>
      </svg>
    </div>
  </xsl:template>
  <xsl:template name="sector">
    <xsl:param name="start" as="xs:double"/>
    <xsl:param name="span" as="xs:double"/>
    <xsl:param name="depth" as="xs:integer"/>
    <xsl:param name="max-depth" as="xs:integer"/>
    <xsl:param name="outer-radius" as="xs:double"/>
    <xsl:param name="ordinal" as="xs:integer"/>
    <xsl:param name="total" as="xs:double"/>
    <xsl:param name="labels-only" as="xs:boolean" select="false()"/>
    <!-- The parent's final spoke angle is an input to the child label layout. -->
    <xsl:param name="parent-mid" as="xs:double" select="-1"/>
    <xsl:variable name="lineage" select="string-join(ancestor-or-self::node ! generate-id(.), ' ')"/>
    <xsl:variable name="inner" select="45 + ($depth - 1) * ($outer-radius - 45) div $max-depth"/>
    <xsl:variable name="outer" select="45 + $depth * ($outer-radius - 45) div $max-depth"/>
    <xsl:variable name="last" select="$start + max((0.0001,$span - 0.006))"/>
    <xsl:variable name="large" select="if ($last - $start &gt; math:pi()) then 1 else 0"/>
    <xsl:variable name="hue" select="($ordinal * 137.508 + $depth * 23) mod 360"/>
    <!-- Stagger descendants near a parent's spoke, bounded by their own wedge.
         This offsets neighboring labels without shortening RDF class names. -->
    <xsl:variable name="sector-mid" select="$start + $span div 2"/>
    <xsl:variable name="near-parent" select="$parent-mid ge 0 and abs($sector-mid - $parent-mid) lt 0.20"/>
    <!-- When close to a parent label, move AWAY from its spoke; otherwise
         alternate nearby siblings to spread their baseline positions. -->
    <xsl:variable name="stagger-direction" select="if ($near-parent and abs($sector-mid - $parent-mid) gt 0.001)
      then (if ($sector-mid gt $parent-mid) then 1 else -1)
      else (if ($ordinal mod 2 eq 0) then 1 else -1)"/>
    <xsl:variable name="stagger" select="if ($depth eq 1) then 0 else
      $stagger-direction * min(($span div 3, if ($near-parent) then 0.13 else 0.045))"/>
    <xsl:variable name="radial-mid" select="$sector-mid + $stagger"/>
    <xsl:if test="not($labels-only)">
    <path data-facet-value="{@uri}" data-facet-lineage="{$lineage}" role="checkbox" tabindex="0" aria-checked="{@selected}"
      aria-label="{concat(@label, ', ', @count, ' results, ', format-number(100 * $span div (2 * math:pi()),'0.#'), '% of chart')}"
      class="cursor-default transition-opacity hover:opacity-75 focus:outline-none"
      fill="{concat('hsl(',format-number($hue,'0.###'),' 66% ',if(@selected='true')then '39' else '63','%)')}"
      stroke="{if(@selected='true')then 'currentColor' else 'var(--background)'}"
      stroke-width="{if(@selected='true')then '3' else '1.5'}"
      d="{concat('M ',160+$outer*math:sin($start),' ',160-$outer*math:cos($start),
        ' A ',$outer,' ',$outer,' 0 ',$large,' 1 ',160+$outer*math:sin($last),' ',160-$outer*math:cos($last),
        ' L ',160+$inner*math:sin($last),' ',160-$inner*math:cos($last),
        ' A ',$inner,' ',$inner,' 0 ',$large,' 0 ',160+$inner*math:sin($start),' ',160-$inner*math:cos($start),' Z')}">
    </path>
    </xsl:if>
    <xsl:if test="$labels-only">
    <g data-facet-label-style="radial" data-facet-lineage="{$lineage}" display="none">
      <xsl:if test="$span gt 0.19 and $outer - $inner gt 15">
        <xsl:variable name="mid" select="$radial-mid"/>
        <!-- Radial labels flow along the spoke rather than being centered in
             the short thickness of a ring. Never shorten names or scale their
             font to the ring width; long labels may extend beyond the wedge.
             On the left half, anchor the text's END at the outer radius so
             it extends westward rather than through the centre to the east. -->
        <xsl:variable name="outward" select="math:sin($mid) ge 0"/>
        <xsl:variable name="radius" select="if ($outward) then $inner + 4 else $outer - 4"/>
        <xsl:variable name="rotation" select="$mid * 180 div math:pi() - 90 + (if ($outward) then 0 else 180)"/>
        <xsl:variable name="label" select="f:display-label(string(@label))"/>
        <text x="{160+$radius*math:sin($mid)}" y="{160-$radius*math:cos($mid)}"
          text-anchor="{if ($outward) then 'start' else 'end'}" font-size="10" font-weight="600" fill="currentColor" pointer-events="none"
          transform="{concat('rotate(',format-number($rotation,'0.###'),' ',format-number(160+$radius*math:sin($mid),'0.###'),' ',format-number(160-$radius*math:cos($mid),'0.###'),')')}"><xsl:value-of select="$label"/></text>
      </xsl:if>
    </g>
    <!-- Arc labels are provider-owned SVG text paths. Each path remains
         inside this chart, never an external resource or script URL. -->
    <g data-facet-label-style="arc" data-facet-lineage="{$lineage}">
    <xsl:if test="$span gt 0.19 and $outer - $inner gt 15">
      <xsl:variable name="mid" select="$start + $span div 2"/>
      <xsl:variable name="radius" select="($inner + $outer) div 2"/>
      <xsl:variable name="reverse" select="($mid mod (2 * math:pi())) gt math:pi() div 2 and ($mid mod (2 * math:pi())) lt 3 * math:pi() div 2"/>
      <xsl:variable name="label-start" select="if ($reverse) then $last else $start"/>
      <xsl:variable name="label-end" select="if ($reverse) then $start else $last"/>
      <xsl:variable name="arc-id" select="concat('maestro-sunburst-label-',generate-id(.))"/>
      <xsl:variable name="label" select="f:display-label(string(@label))"/>
      <!-- One continuous arc line: the name and percent never occupy separate rings.
           SVG textPath does not support line wrapping, so allow overflow rather
           than clipping or shortening; hover tooltip retains the full QName. -->
      <xsl:variable name="caption" select="concat($label, ' · ', format-number(100 * $span div (2 * math:pi()),'0.#'),'%')"/>
      <xsl:variable name="room" select="max((1, $radius * $span - 4))"/>
      <xsl:variable name="caption-room" select="$room div max((1, string-length($caption) * 0.57))"/>
      <xsl:variable name="font" select="max((5.5, min((11, 6 + $span * 4, $caption-room))))"/>
      <defs>
        <path id="{$arc-id}" d="{concat('M ',160+$radius*math:sin($label-start),' ',160-$radius*math:cos($label-start),
          ' A ',$radius,' ',$radius,' 0 ',$large,' ',if ($reverse) then 0 else 1,' ',160+$radius*math:sin($label-end),' ',160-$radius*math:cos($label-end))}"/>
      </defs>
      <text text-anchor="middle" font-size="{format-number($font,'0.#')}" font-weight="600"
        fill="currentColor" pointer-events="none">
        <textPath href="{concat('#',$arc-id)}" startOffset="50%"><xsl:value-of select="$caption"/></textPath>
      </text>
    </xsl:if>
    </g>
    </xsl:if>
    <xsl:if test="$depth lt $max-depth and node">
      <xsl:variable name="sibling-total" select="sum(for $n in node return f:weight($n))"/>
      <xsl:for-each select="node">
        <xsl:call-template name="sector">
          <xsl:with-param name="start" select="$start + $span * sum(for $n in preceding-sibling::node return f:weight($n)) div max((1,$sibling-total))"/>
          <xsl:with-param name="span" select="$span * f:weight(.) div max((1,$sibling-total))"/>
          <xsl:with-param name="depth" select="$depth+1"/>
          <xsl:with-param name="max-depth" select="$max-depth"/>
          <xsl:with-param name="outer-radius" select="$outer-radius"/>
          <xsl:with-param name="ordinal" select="$ordinal * 7 + position()"/>
          <xsl:with-param name="total" select="$total"/>
          <xsl:with-param name="labels-only" select="$labels-only"/>
          <xsl:with-param name="parent-mid" select="$radial-mid"/>
        </xsl:call-template>
      </xsl:for-each>
    </xsl:if>
  </xsl:template>
</xsl:stylesheet>""" .
