alue"},"object":{"termType":"Literal","value":"PREFIX dcat: <http://www.w3.org/ns/dcat#>\nPREFIX dct: <http://purl.org/dc/terms/>\nSELECT DISTINCT ?service ?title ?endpoint ?standard\nWHERE {\n  ?service dcat:endpointURL ?endpoint .\n  OPTIONAL { ?service dct:title ?title }\n  OPTIONAL { ?service dct:conformsTo ?standard }\n}\nLIMIT 100","language":"","datatype":{"value":"http://www.w3.org/2001/XMLSchema#string"}}}]}