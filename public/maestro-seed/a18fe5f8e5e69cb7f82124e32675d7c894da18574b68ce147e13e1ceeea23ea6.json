{"file":"sunburst-chartkit/provider.ttl","destination":"shacl-policies","digest":"sha256:932d7f0a452c46a69f97e57f26744cd40c9ffbf3ffbaa79620ee52082c37a5f5","triples":[{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/provider/category-sunburst-chartkit"},"predicate":{"termType":"NamedNode","value":"http://www.w3.org/1999/02/22-rdf-syntax-ns#type"},"object":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/ns/ui#Provider"}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/provider/category-sunburst-chartkit"},"predicate":{"termType":"NamedNode","value":"http://www.w3.org/1999/02/22-rdf-syntax-ns#type"},"object":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/ns/ui#FacetProvider"}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/provider/category-sunburst-chartkit"},"predicate":{"termType":"NamedNode","value":"http://www.w3.org/2000/01/rdf-schema#label"},"object":{"termType":"Literal","value":"Sunburst (Chart Kit)","language":"en","datatype":{"value":"http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"}}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/provider/category-sunburst-chartkit"},"predicate":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/ns/ui#icon"},"object":{"termType":"Literal","value":"chart-pie","language":"","datatype":{"value":"http://www.w3.org/2001/XMLSchema#string"}}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/provider/category-sunburst-chartkit"},"predicate":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/ns/ui#requestsClassTree"},"object":{"termType":"Literal","value":"true","language":"","datatype":{"value":"http://www.w3.org/2001/XMLSchema#boolean"}}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/provider/category-sunburst-chartkit"},"predicate":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/ns/ui#accepts"},"object":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/provider/category-sunburst-chartkit-input"}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/provider/category-sunburst-chartkit"},"predicate":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/ns/ui#widget"},"object":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/widget/category-sunburst-chartkit"}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/provider/category-sunburst-chartkit-input"},"predicate":{"termType":"NamedNode","value":"http://www.w3.org/1999/02/22-rdf-syntax-ns#type"},"object":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/ns/ui#InputShape"}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/provider/category-sunburst-chartkit-input"},"predicate":{"termType":"NamedNode","value":"http://www.w3.org/1999/02/22-rdf-syntax-ns#type"},"object":{"termType":"NamedNode","value":"http://www.w3.org/ns/shacl#NodeShape"}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/provider/category-sunburst-chartkit-input"},"predicate":{"termType":"NamedNode","value":"http://www.w3.org/ns/shacl#path"},"object":{"termType":"NamedNode","value":"http://www.w3.org/1999/02/22-rdf-syntax-ns#type"}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/provider/category-sunburst-chartkit-input"},"predicate":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/ns/ui#facetDirection"},"object":{"termType":"Literal","value":"class","language":"","datatype":{"value":"http://www.w3.org/2001/XMLSchema#string"}}},{"subject":{"termType":"BlankNode","value":"n3-458"},"predicate":{"termType":"NamedNode","value":"http://www.w3.org/ns/shacl#path"},"object":{"termType":"NamedNode","value":"http://www.w3.org/1999/02/22-rdf-syntax-ns#type"}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/provider/category-sunburst-chartkit-input"},"predicate":{"termType":"NamedNode","value":"http://www.w3.org/ns/shacl#property"},"object":{"termType":"BlankNode","value":"n3-458"}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/widget/category-sunburst-chartkit"},"predicate":{"termType":"NamedNode","value":"http://www.w3.org/1999/02/22-rdf-syntax-ns#type"},"object":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/ns/ui#FacetWidget"}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/widget/category-sunburst-chartkit"},"predicate":{"termType":"NamedNode","value":"http://www.w3.org/2000/01/rdf-schema#label"},"object":{"termType":"Literal","value":"Categories Sunburst — Chart Kit style","language":"en","datatype":{"value":"http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"}}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ui/widget/category-sunburst-chartkit"},"predicate":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/ns/ui#templateContent"},"object":{"termType":"Literal","value":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xsl:stylesheet version=\"3.0\" xmlns:xsl=\"http://www.w3.org/1999/XSL/Transform\"\n  xmlns:f=\"urn:maestro:facet:hierarchy\" xmlns:math=\"http://www.w3.org/2005/xpath-functions/math\"\n  xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" exclude-result-prefixes=\"f math xs\">\n  <xsl:output method=\"html\" omit-xml-declaration=\"yes\"/>\n  <!-- The host supplies RDF class hierarchy; all sunburst layout belongs here. -->\n  <xsl:function name=\"f:weight\" as=\"xs:double\">\n    <xsl:param name=\"node\" as=\"element(node)\"/>\n    <xsl:sequence select=\"max((1, xs:double($node/@count), sum(for $child in $node/node return f:weight($child))))\"/>\n  </xsl:function>\n  <!-- Provider-authored visible label: local part of a QName; keep the full\n       name in the sector's accessible label. Never alter IRIs. -->\n  <xsl:function name=\"f:display-label\" as=\"xs:string\">\n    <xsl:param name=\"raw\" as=\"xs:string\"/>\n    <xsl:sequence select=\"if (matches($raw, '^[A-Za-z_][A-Za-z0-9._-]*:[^/]') and not(contains($raw, '://')))\n       then replace($raw, '^[^:]+:', '') else $raw\"/>\n  </xsl:function>\n  <xsl:template match=\"/facet\">\n    <xsl:variable name=\"roots\" select=\"hierarchy/node\"/>\n    <xsl:variable name=\"max-depth\" select=\"min((5, max((1, for $n in $roots/descendant-or-self::node return count($n/ancestor-or-self::node)))))\"/>\n    <xsl:variable name=\"total\" select=\"sum(for $n in $roots return f:weight($n))\"/>\n    <!-- A shallow hierarchy stays compact. The outer radius grows by level,\n         capped at 144 layout units before the 2.5x display scale (360 final units). -->\n    <xsl:variable name=\"outer-radius\" select=\"min((144, 70 + ($max-depth - 1) * 18.5))\"/>\n    <div class=\"w-full min-w-0 rounded-md px-0 pt-1 pb-0\" aria-label=\"Chart Kit style hierarchical Categories sunburst\">\n      <svg viewBox=\"{concat(format-number(400 - 2.5 * ($outer-radius + 14),'0.###'),' ',format-number(400 - 2.5 * ($outer-radius + 14),'0.###'),' ',format-number(5 * ($outer-radius + 14),'0.###'),' ',format-number(5 * ($outer-radius + 14),'0.###'))}\" overflow=\"visible\" role=\"group\" aria-label=\"Chart Kit style sunburst of the live RDF Categories tree\" class=\"h-auto w-full\" preserveAspectRatio=\"xMidYMid meet\">\n        <g transform=\"scale(2.5)\">\n        <xsl:for-each select=\"$roots\">\n          <xsl:variable name=\"offset\" select=\"sum(for $n in preceding-sibling::node return f:weight($n)) div max((1,$total)) * 2 * math:pi()\"/>\n          <xsl:call-template name=\"sector\">\n            <xsl:with-param name=\"start\" select=\"$offset\"/>\n            <xsl:with-param name=\"span\" select=\"f:weight(.) div max((1,$total)) * 2 * math:pi()\"/>\n            <xsl:with-param name=\"depth\" select=\"1\"/>\n            <xsl:with-param name=\"max-depth\" select=\"$max-depth\"/>\n            <xsl:with-param name=\"outer-radius\" select=\"$outer-radius\"/>\n            <xsl:with-param name=\"ordinal\" select=\"position()\"/>\n            <xsl:with-param name=\"total\" select=\"$total\"/>\n            <xsl:with-param name=\"labels-only\" select=\"false()\"/>\n            <xsl:with-param name=\"branch\" select=\"position()\"/>\n          </xsl:call-template>\n        </xsl:for-each>\n        <!-- Labels render in a second pass ABOVE every sector path. Otherwise\n             later sibling/descendant wedges literally paint over full radial names. -->\n        <xsl:for-each select=\"$roots\">\n          <xsl:variable name=\"offset\" select=\"sum(for $n in preceding-sibling::node return f:weight($n)) div max((1,$total)) * 2 * math:pi()\"/>\n          <xsl:call-template name=\"sector\">\n            <xsl:with-param name=\"start\" select=\"$offset\"/>\n            <xsl:with-param name=\"span\" select=\"f:weight(.) div max((1,$total)) * 2 * math:pi()\"/>\n            <xsl:with-param name=\"depth\" select=\"1\"/>\n            <xsl:with-param name=\"max-depth\" select=\"$max-depth\"/>\n            <xsl:with-param name=\"outer-radius\" select=\"$outer-radius\"/>\n            <xsl:with-param name=\"ordinal\" select=\"position()\"/>\n            <xsl:with-param name=\"total\" select=\"$total\"/>\n            <xsl:with-param name=\"labels-only\" select=\"true()\"/>\n            <xsl:with-param name=\"branch\" select=\"position()\"/>\n          </xsl:call-template>\n        </xsl:for-each>\n        <circle cx=\"160\" cy=\"160\" r=\"37\" fill=\"var(--background)\"/>\n        <text x=\"160\" y=\"155\" text-anchor=\"middle\" fill=\"currentColor\" font-size=\"12\" font-weight=\"600\">Categories</text>\n        <text x=\"160\" y=\"173\" text-anchor=\"middle\" fill=\"currentColor\" font-size=\"10\"><xsl:value-of select=\"count(item)\"/> values</text>\n        </g>\n      </svg>\n    </div>\n  </xsl:template>\n  <xsl:template name=\"sector\">\n    <xsl:param name=\"start\" as=\"xs:double\"/>\n    <xsl:param name=\"span\" as=\"xs:double\"/>\n    <xsl:param name=\"depth\" as=\"xs:integer\"/>\n    <xsl:param name=\"max-depth\" as=\"xs:integer\"/>\n    <xsl:param name=\"outer-radius\" as=\"xs:double\"/>\n    <xsl:param name=\"ordinal\" as=\"xs:integer\"/>\n    <xsl:param name=\"total\" as=\"xs:double\"/>\n    <xsl:param name=\"labels-only\" as=\"xs:boolean\" select=\"false()\"/>\n    <!-- The parent's final spoke angle is an input to the child label layout. -->\n    <xsl:param name=\"parent-mid\" as=\"xs:double\" select=\"-1\"/>\n    <xsl:param name=\"branch\" as=\"xs:integer\"/>\n    <xsl:variable name=\"lineage\" select=\"string-join(ancestor-or-self::node ! generate-id(.), ' ')\"/>\n    <xsl:variable name=\"inner\" select=\"38 + ($depth - 1) * ($outer-radius - 38) div $max-depth\"/>\n    <xsl:variable name=\"outer\" select=\"38 + $depth * ($outer-radius - 38) div $max-depth\"/>\n    <!-- Reserve at most 10% of a narrow sector for the separator; never\n         subtract a fixed gap larger than the sector itself. -->\n    <xsl:variable name=\"extent\" select=\"$span - min((0.006, $span div 10))\"/>\n    <xsl:variable name=\"last\" select=\"$start + $extent\"/>\n    <xsl:variable name=\"large\" select=\"if ($last - $start &gt; math:pi()) then 1 else 0\"/>\n    <!-- All descendants inherit their root's color family; hierarchy levels\n         shift lightness, while sibling variations remain distinguishable. -->\n    <xsl:variable name=\"hue\" select=\"($branch * 61 + ($ordinal mod 5) * 8 + 170) mod 360\"/>\n    <xsl:variable name=\"lightness\" select=\"if (@selected='true') then 37 else min((72, 48 + $depth * 5))\"/>\n    <!-- Stagger descendants near a parent's spoke, bounded by their own wedge.\n         This offsets neighboring labels without shortening RDF class names. -->\n    <xsl:variable name=\"sector-mid\" select=\"$start + $span div 2\"/>\n    <xsl:variable name=\"near-parent\" select=\"$parent-mid ge 0 and abs($sector-mid - $parent-mid) lt 0.20\"/>\n    <!-- When close to a parent label, move AWAY from its spoke; otherwise\n         alternate nearby siblings to spread their baseline positions. -->\n    <xsl:variable name=\"stagger-direction\" select=\"if ($near-parent and abs($sector-mid - $parent-mid) gt 0.001)\n      then (if ($sector-mid gt $parent-mid) then 1 else -1)\n      else (if ($ordinal mod 2 eq 0) then 1 else -1)\"/>\n    <xsl:variable name=\"stagger\" select=\"if ($depth eq 1) then 0 else\n      $stagger-direction * min(($span div 3, if ($near-parent) then 0.13 else 0.045))\"/>\n    <xsl:variable name=\"radial-mid\" select=\"$sector-mid + $stagger\"/>\n    <xsl:if test=\"not($labels-only)\">\n    <!-- Limit the separator using the narrowest chord and ring thickness.\n         Inset the stroke centerline at both radii and both angular edges;\n         round joins keep the stroke within this sector, never over a neighbor.\n         Use half the previous centered width per edge so two normal\n         neighboring sectors retain the previous total separator width. -->\n    <xsl:variable name=\"chord\" select=\"2 * $inner * math:sin(min(($extent, math:pi())) div 2)\"/>\n    <xsl:variable name=\"border-budget\" select=\"min(((if (@selected='true') then 3 else 2.5) div 2, $chord div 4, ($outer - $inner) div 4))\"/>\n    <xsl:variable name=\"border\" select=\"if ($border-budget lt 0.15) then 0 else $border-budget\"/>\n    <xsl:variable name=\"half-border\" select=\"$border div 2\"/>\n    <xsl:variable name=\"paint-inner\" select=\"$inner + $half-border\"/>\n    <xsl:variable name=\"paint-outer\" select=\"$outer - $half-border\"/>\n    <xsl:variable name=\"inner-inset\" select=\"math:asin($half-border div $paint-inner)\"/>\n    <xsl:variable name=\"outer-inset\" select=\"math:asin($half-border div $paint-outer)\"/>\n    <xsl:variable name=\"inner-start\" select=\"$start + $inner-inset\"/>\n    <xsl:variable name=\"inner-end\" select=\"$last - $inner-inset\"/>\n    <xsl:variable name=\"outer-start\" select=\"$start + $outer-inset\"/>\n    <xsl:variable name=\"outer-end\" select=\"$last - $outer-inset\"/>\n    <xsl:variable name=\"inner-large\" select=\"if ($inner-end - $inner-start gt math:pi()) then 1 else 0\"/>\n    <xsl:variable name=\"outer-large\" select=\"if ($outer-end - $outer-start gt math:pi()) then 1 else 0\"/>\n    <path data-facet-value=\"{@uri}\" data-facet-lineage=\"{$lineage}\" role=\"checkbox\" tabindex=\"0\" aria-checked=\"{@selected}\"\n      aria-label=\"{concat(@label, ', ', @count, ' results, ', format-number(100 * $span div (2 * math:pi()),'0.#'), '% of chart')}\"\n      class=\"cursor-default transition-opacity hover:opacity-75 focus:outline-none\"\n      fill=\"{concat('hsl(',format-number($hue,'0.###'),' 70% ',format-number($lightness,'0'),'%)')}\"\n      stroke=\"{if ($border eq 0) then 'none' else if (@selected='true') then 'currentColor' else 'var(--background)'}\"\n      stroke-width=\"{$border}\" stroke-linejoin=\"round\"\n      d=\"{concat('M ',160+$paint-outer*math:sin($outer-start),' ',160-$paint-outer*math:cos($outer-start),\n        ' A ',$paint-outer,' ',$paint-outer,' 0 ',$outer-large,' 1 ',160+$paint-outer*math:sin($outer-end),' ',160-$paint-outer*math:cos($outer-end),\n        ' L ',160+$paint-inner*math:sin($inner-end),' ',160-$paint-inner*math:cos($inner-end),\n        ' A ',$paint-inner,' ',$paint-inner,' 0 ',$inner-large,' 0 ',160+$paint-inner*math:sin($inner-start),' ',160-$paint-inner*math:cos($inner-start),' Z')}\">\n    </path>\n    </xsl:if>\n    <xsl:if test=\"$labels-only\">\n    <g data-facet-label-style=\"radial\" data-facet-lineage=\"{$lineage}\" display=\"none\">\n      <xsl:if test=\"$span gt 0.19 and $outer - $inner gt 15\">\n        <xsl:variable name=\"mid\" select=\"$radial-mid\"/>\n        <!-- Radial labels flow along the spoke rather than being centered in\n             the short thickness of a ring. Never shorten names or scale their\n             font to the ring width; long labels may extend beyond the wedge.\n             On the left half, anchor the text's END at the outer radius so\n             it extends westward rather than through the centre to the east. -->\n        <xsl:variable name=\"outward\" select=\"math:sin($mid) ge 0\"/>\n        <xsl:variable name=\"radius\" select=\"if ($outward) then $inner + 4 else $outer - 4\"/>\n        <xsl:variable name=\"rotation\" select=\"$mid * 180 div math:pi() - 90 + (if ($outward) then 0 else 180)\"/>\n        <xsl:variable name=\"label\" select=\"f:display-label(string(@label))\"/>\n        <text x=\"{160+$radius*math:sin($mid)}\" y=\"{160-$radius*math:cos($mid)}\"\n          text-anchor=\"{if ($outward) then 'start' else 'end'}\" font-size=\"10\" font-weight=\"600\" fill=\"currentColor\" pointer-events=\"none\"\n          transform=\"{concat('rotate(',format-number($rotation,'0.###'),' ',format-number(160+$radius*math:sin($mid),'0.###'),' ',format-number(160-$radius*math:cos($mid),'0.###'),')')}\"><xsl:value-of select=\"$label\"/></text>\n      </xsl:if>\n    </g>\n    <!-- Arc labels are provider-owned SVG text paths. Each path remains\n         inside this chart, never an external resource or script URL. -->\n    <g data-facet-label-style=\"arc\" data-facet-lineage=\"{$lineage}\">\n    <xsl:if test=\"$span gt 0.19 and $outer - $inner gt 15\">\n      <xsl:variable name=\"mid\" select=\"$start + $span div 2\"/>\n      <xsl:variable name=\"radius\" select=\"($inner + $outer) div 2\"/>\n      <xsl:variable name=\"reverse\" select=\"($mid mod (2 * math:pi())) gt math:pi() div 2 and ($mid mod (2 * math:pi())) lt 3 * math:pi() div 2\"/>\n      <xsl:variable name=\"label-start\" select=\"if ($reverse) then $last else $start\"/>\n      <xsl:variable name=\"label-end\" select=\"if ($reverse) then $start else $last\"/>\n      <xsl:variable name=\"arc-id\" select=\"concat('maestro-sunburst-label-',generate-id(.))\"/>\n      <xsl:variable name=\"label\" select=\"f:display-label(string(@label))\"/>\n      <!-- One continuous arc line: the name and percent never occupy separate rings.\n           SVG textPath does not support line wrapping, so allow overflow rather\n           than clipping or shortening; hover tooltip retains the full QName. -->\n      <xsl:variable name=\"caption\" select=\"concat($label, ' · ', format-number(100 * $span div (2 * math:pi()),'0.#'),'%')\"/>\n      <xsl:variable name=\"room\" select=\"max((1, $radius * $span - 4))\"/>\n      <xsl:variable name=\"caption-room\" select=\"$room div max((1, string-length($caption) * 0.57))\"/>\n      <xsl:variable name=\"font\" select=\"max((5.5, min((11, 6 + $span * 4, $caption-room))))\"/>\n      <defs>\n        <path id=\"{$arc-id}\" d=\"{concat('M ',160+$radius*math:sin($label-start),' ',160-$radius*math:cos($label-start),\n          ' A ',$radius,' ',$radius,' 0 ',$large,' ',if ($reverse) then 0 else 1,' ',160+$radius*math:sin($label-end),' ',160-$radius*math:cos($label-end))}\"/>\n      </defs>\n      <text text-anchor=\"middle\" font-size=\"{format-number($font,'0.#')}\" font-weight=\"600\"\n        fill=\"currentColor\" pointer-events=\"none\">\n        <textPath href=\"{concat('#',$arc-id)}\" startOffset=\"50%\"><xsl:value-of select=\"$caption\"/></textPath>\n      </text>\n    </xsl:if>\n    </g>\n    </xsl:if>\n    <xsl:if test=\"$depth lt $max-depth and node\">\n      <xsl:variable name=\"sibling-total\" select=\"sum(for $n in node return f:weight($n))\"/>\n      <xsl:for-each select=\"node\">\n        <xsl:call-template name=\"sector\">\n          <xsl:with-param name=\"start\" select=\"$start + $span * sum(for $n in preceding-sibling::node return f:weight($n)) div max((1,$sibling-total))\"/>\n          <xsl:with-param name=\"span\" select=\"$span * f:weight(.) div max((1,$sibling-total))\"/>\n          <xsl:with-param name=\"depth\" select=\"$depth+1\"/>\n          <xsl:with-param name=\"max-depth\" select=\"$max-depth\"/>\n          <xsl:with-param name=\"outer-radius\" select=\"$outer-radius\"/>\n          <xsl:with-param name=\"ordinal\" select=\"$ordinal * 7 + position()\"/>\n          <xsl:with-param name=\"total\" select=\"$total\"/>\n          <xsl:with-param name=\"labels-only\" select=\"$labels-only\"/>\n          <xsl:with-param name=\"parent-mid\" select=\"$radial-mid\"/>\n          <xsl:with-param name=\"branch\" select=\"$branch\"/>\n        </xsl:call-template>\n      </xsl:for-each>\n    </xsl:if>\n  </xsl:template>\n</xsl:stylesheet>","language":"","datatype":{"value":"http://www.w3.org/2001/XMLSchema#string"}}}]}