{"file":"maestro-entrypoint-view.ttl","destination":"/shacl/policies","digest":"sha256:18b5d056fd494456a5dbd1bcdcaed66933b9b82a3b2dfd4c0fc73cfea9589126","triples":[{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/shacl/view#EntryPointView"},"predicate":{"termType":"NamedNode","value":"http://www.w3.org/1999/02/22-rdf-syntax-ns#type"},"object":{"termType":"NamedNode","value":"http://www.w3.org/ns/shacl#NodeShape"}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/shacl/view#EntryPointView"},"predicate":{"termType":"NamedNode","value":"http://www.w3.org/ns/shacl#targetClass"},"object":{"termType":"NamedNode","value":"https://schema.org/EntryPoint"}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/shacl/view#EntryPointView"},"predicate":{"termType":"NamedNode","value":"http://www.w3.org/2000/01/rdf-schema#label"},"object":{"termType":"Literal","value":"Graph Servers","language":"","datatype":{"value":"http://www.w3.org/2001/XMLSchema#string"}}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/shacl/view#EntryPointView"},"predicate":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/ns/ui#icon"},"object":{"termType":"Literal","value":"server","language":"","datatype":{"value":"http://www.w3.org/2001/XMLSchema#string"}}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/shacl/view#EntryPointView"},"predicate":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/ns/ui#widget"},"object":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/ns/ui#CardGridWidget"}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/shacl/view#EntryPointCards"},"predicate":{"termType":"NamedNode","value":"http://www.w3.org/1999/02/22-rdf-syntax-ns#type"},"object":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/ns/ui#XsltTemplate"}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/shacl/view#EntryPointCards"},"predicate":{"termType":"NamedNode","value":"http://www.w3.org/2000/01/rdf-schema#label"},"object":{"termType":"Literal","value":"Graph server cards","language":"","datatype":{"value":"http://www.w3.org/2001/XMLSchema#string"}}},{"subject":{"termType":"NamedNode","value":"gttp://ggg.maestro.ecosys/shacl/view#EntryPointCards"},"predicate":{"termType":"NamedNode","value":"http://www.w3.org/1999/02/22-rdf-syntax-ns#value"},"object":{"termType":"Literal","value":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xsl:stylesheet version=\"1.0\" xmlns:xsl=\"http://www.w3.org/1999/XSL/Transform\">\n  <xsl:output method=\"html\" omit-xml-declaration=\"yes\"/>\n  <xsl:template match=\"/results\">\n    <section data-view-title=\"Graph Servers\" data-view-icon=\"server\" class=\"grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3\" aria-label=\"Graph servers\">\n      <!-- All selected-first ordering and page slicing happen in this stylesheet.\n           The available collection includes only results already returned by FCT;\n           a filtered-out graph server is never injected. -->\n      <xsl:variable name=\"offset\" select=\"number(@page) * number(@pageSize)\"/>\n      <xsl:variable name=\"limit\" select=\"number(@pageSize)\"/>\n      <xsl:apply-templates select=\"available/result\">\n        <xsl:sort select=\"number(@selected = 'true')\" data-type=\"number\" order=\"descending\"/>\n        <xsl:with-param name=\"offset\" select=\"$offset\"/>\n        <xsl:with-param name=\"limit\" select=\"$limit\"/>\n      </xsl:apply-templates>\n    </section>\n  </xsl:template>\n  <xsl:template match=\"result\">\n    <xsl:param name=\"offset\" select=\"0\"/>\n    <xsl:param name=\"limit\" select=\"30\"/>\n    <xsl:if test=\"position() &gt; $offset and position() &lt;= ($offset + $limit)\">\n    <article>\n      <xsl:attribute name=\"class\"><xsl:choose>\n        <xsl:when test=\"@selected = 'true'\">flex flex-col overflow-hidden rounded-xl border-2 border-primary bg-card shadow-sm ring-1 ring-primary/20</xsl:when>\n        <xsl:otherwise>flex flex-col overflow-hidden rounded-xl border bg-card shadow-sm</xsl:otherwise>\n      </xsl:choose></xsl:attribute>\n      <xsl:if test=\"string-length(normalize-space(@group)) &gt; 0\">\n        <div class=\"border-b bg-muted/50 px-5 py-1.5 text-xs font-medium text-muted-foreground\"><xsl:value-of select=\"@group\"/></div>\n      </xsl:if>\n      <div class=\"flex flex-col gap-3 p-5\">\n      <div class=\"flex items-center gap-3\">\n        <span class=\"relative inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-muted\" aria-hidden=\"true\">\n          <span data-lucide-icon=\"globe\" class=\"inline-flex items-center justify-center text-muted-foreground\"/>\n          <xsl:if test=\"string-length(@favicon) &gt; 0\">\n            <img class=\"absolute inset-0 size-9 rounded-lg bg-muted object-contain p-1\" alt=\"Site favicon\">\n              <xsl:attribute name=\"data-favicon-fallback\">https://icons.duckduckgo.com/ip3/<xsl:value-of select=\"substring-before(substring-after(@favicon,'domain='),'&amp;')\"/>.ico</xsl:attribute>\n              <xsl:attribute name=\"src\"><xsl:value-of select=\"@favicon\"/></xsl:attribute>\n            </img>\n          </xsl:if>\n        </span>\n        <h3 class=\"min-w-0 break-words text-base font-semibold\">\n          <xsl:choose>\n            <xsl:when test=\"string-length(@endpointId) &gt; 0\">\n              <button type=\"button\" class=\"cursor-pointer text-left hover:text-primary hover:underline focus-visible:underline\" title=\"Select graph server\">\n                <xsl:attribute name=\"data-endpoint-select\"><xsl:value-of select=\"@endpointId\"/></xsl:attribute>\n                <xsl:value-of select=\"@label\"/>\n              </button>\n            </xsl:when>\n            <xsl:otherwise><xsl:value-of select=\"@label\"/></xsl:otherwise>\n          </xsl:choose>\n          <xsl:if test=\"@selected = 'true'\"><span class=\"ml-2 text-xs font-medium text-primary\">Selected</span></xsl:if>\n        </h3>\n      </div>\n      <div class=\"flex items-center gap-2 text-sm text-muted-foreground\">\n        <xsl:choose>\n          <xsl:when test=\"@healthState='green'\"><span data-lucide-icon=\"badge-check\" class=\"text-green-600\"/></xsl:when>\n          <xsl:when test=\"@healthState='red'\"><span data-lucide-icon=\"badge-x\" class=\"text-red-600\"/></xsl:when>\n          <xsl:when test=\"@healthState='amber'\"><span data-lucide-icon=\"badge-alert\" class=\"text-orange-500\"/></xsl:when>\n          <xsl:otherwise><span data-lucide-icon=\"badge-question-mark\" class=\"text-muted-foreground\"/></xsl:otherwise>\n        </xsl:choose>\n        <span><xsl:value-of select=\"@health\"/></span>\n        <xsl:if test=\"string-length(@endpointId) &gt; 0\">\n          <button type=\"button\" class=\"inline-flex size-5 shrink-0 items-center justify-center rounded border-0 bg-transparent text-muted-foreground/60 hover:text-foreground focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring\" aria-label=\"Refresh graph server health\" title=\"Refresh health\">\n            <xsl:attribute name=\"data-endpoint-refresh\"><xsl:value-of select=\"@endpointId\"/></xsl:attribute>\n            <span data-lucide-icon=\"refresh-cw\">\n              <xsl:attribute name=\"class\"><xsl:choose><xsl:when test=\"@pinging='true'\">animate-spin text-muted-foreground</xsl:when><xsl:otherwise>text-current</xsl:otherwise></xsl:choose></xsl:attribute>\n            </span>\n          </button>\n        </xsl:if>\n      </div>\n      <xsl:if test=\"string-length(normalize-space(@description)) &gt; 0\">\n        <p class=\"text-sm leading-relaxed text-muted-foreground\"><xsl:value-of select=\"@description\"/></p>\n      </xsl:if>\n      <xsl:if test=\"string-length(normalize-space(@product)) &gt; 0 and @product != 'Unknown'\">\n        <div class=\"flex flex-wrap items-center gap-2 text-sm text-muted-foreground\">\n          <span><xsl:value-of select=\"@product\"/></span>\n          <xsl:if test=\"string-length(normalize-space(@version)) &gt; 0\">\n            <div class=\"h-4 w-px shrink-0 bg-border\" data-slot=\"separator\" role=\"none\"/>\n            <span><xsl:value-of select=\"@version\"/></span>\n          </xsl:if>\n        </div>\n      </xsl:if>\n      <xsl:if test=\"string-length(normalize-space(@rank)) &gt; 0 and starts-with(@rank, '#')\">\n        <p class=\"text-sm text-muted-foreground\">Site rank: <xsl:value-of select=\"@rank\"/></p>\n      </xsl:if>\n      <a class=\"break-all text-sm text-primary hover:underline\">\n        <xsl:attribute name=\"href\"><xsl:value-of select=\"@endpoint\"/></xsl:attribute>\n        <xsl:attribute name=\"target\">_blank</xsl:attribute>\n        <xsl:value-of select=\"@endpoint\"/>\n      </a>\n      </div>\n    </article>\n    </xsl:if>\n  </xsl:template>\n</xsl:stylesheet>","language":"","datatype":{"value":"http://www.w3.org/2001/XMLSchema#string"}}}]}