<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:vfct="https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#">
  <rdfs:Class rdf:about="https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#query">
    <rdfs:label>FCT query element</rdfs:label>
    <rdfs:comment>The root element of a Virtuoso Faceted Browser query XML document.</rdfs:comment>
  </rdfs:Class>
  <rdfs:Class rdf:about="https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#text"><rdfs:label>FCT text element</rdfs:label></rdfs:Class>
  <rdfs:Class rdf:about="https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#property"><rdfs:label>FCT property element</rdfs:label></rdfs:Class>
  <rdfs:Class rdf:about="https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#property-of"><rdfs:label>FCT property-of element</rdfs:label></rdfs:Class>
  <rdfs:Class rdf:about="https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#class"><rdfs:label>FCT class element</rdfs:label></rdfs:Class>
  <rdfs:Class rdf:about="https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#value"><rdfs:label>FCT value element</rdfs:label></rdfs:Class>
  <rdfs:Class rdf:about="https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#view"><rdfs:label>FCT view element</rdfs:label></rdfs:Class>
  <rdfs:Class rdf:about="https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#QueryBookmark">
    <rdfs:label>Saved FCT query bookmark</rdfs:label>
    <rdfs:comment>A Maestro bookmark for a saved FCT query. Its title is stored with rdfs:label, creation time with dcterms:created, the query link with dcterms:references, and the serialized XML as rdf:value with datatype rdf:XMLLiteral.</rdfs:comment>
  </rdfs:Class>
  <rdfs:Class rdf:about="https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#XMLAttribute"><rdfs:label>XML attribute</rdfs:label><rdfs:comment>A resource representing one attribute in a saved FCT query XML tree.</rdfs:comment></rdfs:Class>
  <rdf:Property rdf:about="https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#attribute"><rdfs:label>XML attribute node</rdfs:label><rdfs:comment>Links an XML element resource to an attribute resource so names and values remain paired. Attribute labels and values use rdfs:label and rdf:value.</rdfs:comment><rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/></rdf:Property>
  <rdf:Property rdf:about="https://vos.openlinksw.com/owiki/wiki/VOS/VirtFacetBrowserAPIs#child">
    <rdfs:label>child</rdfs:label><rdfs:comment>Connects an XML element resource to each of its immediate child elements.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/><rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
  </rdf:Property>
</rdf:RDF>
